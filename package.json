{
	"name": "arenaswap",
	"version": "2.0.0",
	"description": "Watches every live game across 12 leagues and auto-switches your browser tab to the most exciting one every 15 seconds.",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"build:all": "turbo run build build:firefox build:edge",
		"zip": "turbo run zip",
		"zip:firefox": "turbo run zip:firefox",
		"zip:edge": "turbo run zip:edge",
		"zip:all": "turbo run zip zip:firefox zip:edge",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"powerscore:simulate": "rolldown scripts/powerscore/simulateDistribution.ts --platform=node --file=scripts/powerscore/simulateDistribution.cjs --format=cjs --target=es2023 --log-level=silent && node scripts/powerscore/simulateDistribution.cjs",
		"powerscore:validate-live": "rolldown scripts/powerscore/validateLive.ts --platform=node --file=scripts/powerscore/validateLive.cjs --format=cjs --log-level=silent --target=es2023 && node scripts/powerscore/validateLive.cjs"
	},
	"devDependencies": {
		"rolldown": "^1.1.1",
		"turbo": "^2.9.16",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"@webext-core/fake-browser": "1.3.4",
		"shell-quote": "1.8.4"
	},
	"packageManager": "npm@10.9.0",
	"dependencies": {
		"skills": "^1.5.7"
	}
}
