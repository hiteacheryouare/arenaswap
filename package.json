{
	"name": "arenaswap",
	"version": "1.3.0",
	"description": "Watches every live game across 12 leagues and auto-switches your browser tab to the most exciting one every 15 seconds.",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo run build",
		"build:all": "turbo run build build:firefox build:edge",
		"zip": "turbo run zip",
		"test": "turbo run test",
		"typecheck": "turbo typecheck"
	},
	"devDependencies": {
		"turbo": "^2.9.14",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"@webext-core/fake-browser": "1.3.4"
	},
	"packageManager": "npm@10.9.0",
	"dependencies": {
		"@porkyproductions/hat": "^1.5.0",
		"canvas-confetti": "^1.9.4"
	}
}
