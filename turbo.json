{
	"$schema": "./node_modules/turbo/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**"]
		},
		"build:firefox": {
			"dependsOn": ["^build"],
			"outputs": [".output/**"]
		},
		"build:edge": {
			"dependsOn": ["^build"],
			"outputs": [".output/**"]
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"dependsOn": ["^build"]
		},
		"test": {},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
