{
	"$schema": "./node_modules/turbo/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**"]
		},
		"build:firefox": {
			"dependsOn": ["^build"],
			"outputs": [".output/**"]
		},
		"build:edge": {
			"dependsOn": ["^build"],
			"outputs": [".output/**"]
		},
		"zip": {
			"dependsOn": ["build"],
			"outputs": [".output/*.zip"]
		},
		"zip:firefox": {
			"dependsOn": ["build"],
			"outputs": [".output/*.zip"]
		},
		"zip:edge": {
			"dependsOn": ["build"],
			"outputs": [".output/*.zip"]
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"lint": {}
	}
}
