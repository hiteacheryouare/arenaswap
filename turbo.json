{
	"$schema": "./node_modules/turbo/schema.json",
	"globalDependencies": ["tsconfig.base.json", ".oxlintrc.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"build:firefox": {
			"dependsOn": ["^build"]
		},
		"build:edge": {
			"dependsOn": ["^build"]
		},
		"zip": {
			"dependsOn": ["^build", "build"],
			"cache": false
		},
		"zip:firefox": {
			"dependsOn": ["^build", "build:firefox"],
			"cache": false
		},
		"zip:edge": {
			"dependsOn": ["^build", "build:edge"],
			"cache": false
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"lint": {}
	}
}
