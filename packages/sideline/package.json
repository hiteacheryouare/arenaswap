{
	"name": "@arenaswap/sideline",
	"version": "3.0.0",
	"description": "Fetches and parses game data from our sources for ArenaSwap: scoreboards, summaries, standings, box scores, teams and logos",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./gameClock": "./src/gameClock.ts",
		"./mockBoxScores": "./src/mockBoxScores.ts",
		"./mockMatchup": "./src/mockMatchup.ts",
		"./mockStandings": "./src/mockStandings.ts"
	},
	"scripts": {
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "jest --passWithNoTests --selectProjects unit",
		"test:e2e": "jest --passWithNoTests --selectProjects e2e",
		"test:coverage": "jest --coverage",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests",
		"lint": "oxlint ."
	},
	"dependencies": {
		"@arenaswap/core": "*",
		"powerscore": "*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"jest": "^30.5.2"
	}
}
