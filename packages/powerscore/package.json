{
	"name": "powerscore",
	"version": "1.4.3",
	"description": "The PowerScore excitement scoring engine for live sports games",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"./dist/**/*.js",
		"./dist/**/*.js.map",
		"./dist/**/*.d.ts",
		"./dist/**/*.d.ts.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"prepack": "npm run build",
		"test": "npm run test:unit",
		"test:unit": "jest --passWithNoTests --selectProjects unit",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"sports",
		"powerscore",
		"excitement",
		"nfl",
		"nba",
		"mlb",
		"nhl",
		"soccer",
		"algorithm"
	],
	"author": "hiteacheryouare",
	"license": "ISC",
	"homepage": "https://github.com/hiteacheryouare/arenaswap/tree/mega/packages/powerscore",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hiteacheryouare/arenaswap.git",
		"directory": "packages/powerScore"
	},
	"bugs": {
		"url": "https://github.com/hiteacheryouare/arenaswap/issues"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"jest": "^30.3.0",
		"ts-jest": "^29.4.9",
		"typescript": "^6.0.3"
	}
}
