{
	"name": "@arenaswap/core",
	"version": "1.1.0",
	"description": "ESPN API client, game model, and preferences for ArenaSwap",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./constants": {
			"import": "./dist/constants.js",
			"types": "./dist/constants.d.ts"
		},
		"./types": {
			"import": "./dist/types.js",
			"types": "./dist/types.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "jest --passWithNoTests --selectProjects unit",
		"test:e2e": "jest --passWithNoTests --selectProjects e2e",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@arenaswap/powerscore": "*"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"jest": "^30.3.0",
		"ts-jest": "^29.4.9",
		"typescript": "^5.9.3"
	}
}
