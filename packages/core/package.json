{
	"name": "@arenaswap/core",
	"version": "2.0.0",
	"description": "ESPN API client, game model, and preferences for ArenaSwap",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"import": "./dist/constants.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "jest --passWithNoTests --selectProjects unit",
		"test:e2e": "jest --passWithNoTests --selectProjects e2e",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint ."
	},
	"dependencies": {
		"powerscore": "*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"jest": "^30.5.1",
		"typescript": "^7.0.2"
	}
}
