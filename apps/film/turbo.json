{
	"extends": ["//"],
	"tasks": {
		// Bundles the stage, the render and extract CLIs and the popup shim. It reads the popup the
		// extension's own build:film writes to apps/extension/.output/film, and the docs site's
		// legal strings and browser frame styles, which live outside this package.
		"build:film": {
			"dependsOn": ["^build", "@arenaswap/extension#build:film"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/docs/src/i18n/strings/**", "$TURBO_ROOT$/apps/docs/src/styles/**"],
			"outputs": [".build/**", "audio/*.cjs", "extract/*.cjs", "render/*.cjs"]
		}
	}
}
