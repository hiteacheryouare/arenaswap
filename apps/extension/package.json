{
	"name": "@madness/extension",
	"version": "0.1.0",
	"description": "Madness browser extension — automatically flip to the most exciting March Madness game",
	"private": true,
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt --browser firefox",
		"build": "wxt build",
		"build:firefox": "wxt build --browser firefox",
		"typecheck": "wxt prepare && tsc --noEmit"
	},
	"dependencies": {
		"@madness/core": "*"
	},
	"devDependencies": {
		"wxt": "^0.20.20",
		"@wxt-dev/module-react": "^1.2.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"typescript": "^5.7.3",
		"tailwindcss": "^3.4.17",
		"autoprefixer": "^10.4.20",
		"bootstrap": "^5.3.3"
	}
}
