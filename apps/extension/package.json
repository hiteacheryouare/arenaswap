{
	"name": "@arenaswap/extension",
	"version": "0.1.0",
	"description": "ArenaSwap browser extension — automatically flip to the most exciting game",
	"private": true,
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt --browser firefox",
		"build": "wxt build",
		"build:firefox": "wxt build --browser firefox",
		"typecheck": "wxt prepare && tsc --noEmit"
	},
	"dependencies": {
		"@arenaswap/core": "*",
		"swr": "^2.4.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@wxt-dev/module-react": "^1.2.2",
		"autoprefixer": "^10.4.20",
		"bootstrap": "^5.3.3",
		"bootstrap-icons": "^1.13.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.98.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.7.3",
		"wxt": "^0.20.20"
	}
}
