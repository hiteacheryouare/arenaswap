{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": true,
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"@arenaswap/core": ["../../packages/core/src/index.ts"],
			"@arenaswap/core/*": ["../../packages/core/src/*"],
			"powerscore": ["../../packages/powerscore/src/index.ts"],
			"powerscore/*": ["../../packages/powerscore/src/*"],
			"#i18n": ["./.wxt/i18n/index.ts"],
			"#i18n/*": ["./.wxt/i18n/*"]
		},
		"removeComments": true
	},
	"include": [".wxt/types/**/*.d.ts", "entrypoints/**/*", "components/**/*"]
}
