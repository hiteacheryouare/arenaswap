---
const featured = [
	{ abbr: 'NBA',    full: 'NBA'              },
	{ abbr: 'NFL',    full: 'NFL'              },
	{ abbr: 'EPL',    full: 'Premier League'   },
];

const allLeagues = [
	{ abbr: 'NBA',        full: 'NBA'                     },
	{ abbr: 'WNBA',       full: 'WNBA'                    },
	{ abbr: 'NCAAB',      full: 'NCAA Basketball'         },
	{ abbr: 'NCAAW',      full: "NCAA Women's Hoops"      },
	{ abbr: 'NFL',        full: 'NFL'                     },
	{ abbr: 'NCAAF',      full: 'NCAA Football'           },
	{ abbr: 'UFL',        full: 'UFL'                     },
	{ abbr: 'NHL',        full: 'NHL'                     },
	{ abbr: 'NCAAMH',     full: "NCAA Men's Hockey"       },
	{ abbr: 'MLB',        full: 'MLB'                     },
	{ abbr: 'CBASE',      full: 'NCAA Baseball'           },
	{ abbr: 'CSOFT',      full: 'NCAA Softball'           },
	{ abbr: 'WBBC',       full: 'World Baseball Classic'  },
	{ abbr: 'MLS',        full: 'MLS'                     },
	{ abbr: 'NWSL',       full: 'NWSL'                    },
	{ abbr: 'EPL',        full: 'Premier League'          },
	{ abbr: 'LALIGA',     full: 'La Liga'                 },
	{ abbr: 'BUNDESLIGA', full: 'Bundesliga'              },
	{ abbr: 'SERIEA',     full: 'Serie A'                 },
	{ abbr: 'LIGAMX',     full: 'Liga MX'                 },
	{ abbr: 'UCL',        full: 'Champions League'        },
	{ abbr: 'UEL',        full: 'Europa League'           },
	{ abbr: 'FIFAWC',     full: 'FIFA World Cup'          },
	{ abbr: 'FIFAWWC',    full: "FIFA Women's World Cup"  },
	{ abbr: 'OLYBKM',     full: "Olympic Basketball (M)"  },
	{ abbr: 'OLYBKW',     full: "Olympic Basketball (W)"  },
	{ abbr: 'OLYMIH',     full: "Olympic Hockey (M)"      },
	{ abbr: 'OLYWIH',     full: "Olympic Hockey (W)"      },
	{ abbr: 'OLYSOCM',    full: "Olympic Soccer (M)"      },
	{ abbr: 'OLYSOCW',    full: "Olympic Soccer (W)"      },
	{ abbr: 'OLYBB',      full: "Olympic Baseball"        },
];
---

<section id="leagues" class="section-pad" style="background:rgba(22,27,34,0.5);overflow:hidden;">
	<div class="container">

		<!-- Section header -->
		<div class="row mb-5 reveal">
			<div class="col-lg-6">
				<h2 class="section-title">
					31 leagues.<br>If it's live,<br>it's covered.
				</h2>
				<p class="section-sub mt-3">
					Six sports. Every level of play. ArenaSwap monitors them all at once.
				</p>
			</div>
		</div>

		<!-- ─── Three-act visualization ─────────────────────────────────────── -->
		<div class="leagues-viz reveal">

			<!-- Act 1: Input — league logos -->
			<div class="leagues-viz-input">
				{featured.map((l, i) => (
					<div class={`lv-logo-card lv-logo-delay-${i + 1}`}>
						<img
							src={`/arenaswap/images/leagues/${l.abbr.toLowerCase()}.png`}
							alt={l.abbr}
							class="lv-logo-img"
							onerror="this.style.display='none'"
						/>
						<span class="lv-logo-name">{l.full}</span>
					</div>
				))}
				<p class="lv-more-label">+ 28 more leagues</p>
			</div>

			<!-- Flow tracks left → center -->
			<div class="leagues-viz-tracks-in">
				<div class="lv-flow-track lv-track-1"></div>
				<div class="lv-flow-track lv-track-2"></div>
				<div class="lv-flow-track lv-track-3"></div>
			</div>

			<!-- Act 2: ArenaSwap processing orb -->
			<div class="leagues-viz-center">
				<div class="lv-center-ring lv-ring-outer"></div>
				<div class="lv-center-ring lv-ring-inner"></div>
				<div class="lv-center-box">
					<img src="/arenaswap/images/icon_white_on_transparent.png" alt="ArenaSwap" class="lv-center-icon" onerror="this.style.opacity='0'" />
				</div>
			</div>

			<!-- Flow tracks center → output -->
			<div class="leagues-viz-tracks-out">
				<div class="lv-flow-track lv-track-out-1"></div>
				<div class="lv-flow-track lv-track-out-2"></div>
				<div class="lv-flow-track lv-track-out-3"></div>
			</div>

			<!-- Act 3: Output — Watch, Score, Switch -->
			<div class="leagues-viz-output">

				<div class="lv-action-card lv-action-watch">
					<div class="lv-action-icon-wrap">
						<i class="bi bi-eye-fill"></i>
					</div>
					<div class="lv-action-content">
						<div class="lv-action-title">Watch</div>
						<div class="lv-action-body">Your tab follows the action</div>
					</div>
				</div>

				<div class="lv-action-card lv-action-score">
					<div class="lv-action-icon-wrap">
						<i class="bi bi-lightning-fill"></i>
					</div>
					<div class="lv-action-content">
						<div class="lv-action-title">Score</div>
						<div class="lv-action-body">Every game ranked by PowerScore</div>
					</div>
				</div>

				<div class="lv-action-card lv-action-switch">
					<div class="lv-action-icon-wrap">
						<i class="bi bi-arrow-left-right"></i>
					</div>
					<div class="lv-action-content">
						<div class="lv-action-title">Switch</div>
						<div class="lv-action-body">Moves you when a better game pulls ahead</div>
					</div>
				</div>

			</div>

		</div>
		<!-- ─── End visualization ───────────────────────────────────────────── -->

		<!-- Scrolling marquee of all leagues -->
		<div class="leagues-marquee mt-5 reveal">
			<div class="leagues-marquee-track">
				{[...allLeagues, ...allLeagues].map(l => (
					<div class="leagues-marquee-item">
						<img
							src={`/arenaswap/images/leagues/${l.abbr.toLowerCase()}.png`}
							alt={l.abbr}
							class="leagues-marquee-logo"
							onerror="this.style.display='none'"
						/>
						<span class="leagues-marquee-name">{l.abbr}</span>
					</div>
				))}
			</div>
		</div>

	</div>
</section>
