---
const leagues = [
	// Basketball
	{ abbr: 'NBA', full: 'National Basketball Association', sport: 'Basketball' },
	{ abbr: 'WNBA', full: "Women's National Basketball Association", sport: 'Basketball' },
	{ abbr: 'NCAAB', full: "NCAA Men's Basketball", sport: 'Basketball' },
	{ abbr: 'NCAAW', full: "NCAA Women's Basketball", sport: 'Basketball' },
	{ abbr: 'OLYBKM', full: "Olympic Men's Basketball", sport: 'Basketball' },
	{ abbr: 'OLYBKW', full: "Olympic Women's Basketball", sport: 'Basketball' },
	// Football
	{ abbr: 'NFL', full: 'National Football League', sport: 'Football' },
	{ abbr: 'NCAAF', full: 'NCAA Football', sport: 'Football' },
	{ abbr: 'UFL', full: 'United Football League', sport: 'Football' },
	// Hockey
	{ abbr: 'NHL', full: 'National Hockey League', sport: 'Hockey' },
	{ abbr: 'NCAAMH', full: "NCAA Men's Hockey", sport: 'Hockey' },
	{ abbr: 'OLYMIH', full: "Olympic Men's Ice Hockey", sport: 'Hockey' },
	{ abbr: 'OLYWIH', full: "Olympic Women's Ice Hockey", sport: 'Hockey' },
	// Baseball & Softball
	{ abbr: 'MLB', full: 'Major League Baseball', sport: 'Baseball' },
	{ abbr: 'CBASE', full: 'NCAA Baseball', sport: 'Baseball' },
	{ abbr: 'CSOFT', full: 'NCAA Softball', sport: 'Softball' },
	{ abbr: 'OLYBB', full: "Olympic Men's Baseball", sport: 'Baseball' },
	{ abbr: 'WBBC', full: 'World Baseball Classic', sport: 'Baseball' },
	// Soccer
	{ abbr: 'MLS', full: 'Major League Soccer', sport: 'Soccer' },
	{ abbr: 'NWSL', full: 'National Women\'s Soccer League', sport: 'Soccer' },
	{ abbr: 'EPL', full: 'English Premier League', sport: 'Soccer' },
	{ abbr: 'LALIGA', full: 'La Liga', sport: 'Soccer' },
	{ abbr: 'BUNDESLIGA', full: 'Bundesliga', sport: 'Soccer' },
	{ abbr: 'SERIEA', full: 'Serie A', sport: 'Soccer' },
	{ abbr: 'LIGAMX', full: 'Liga MX', sport: 'Soccer' },
	{ abbr: 'UCL', full: 'UEFA Champions League', sport: 'Soccer' },
	{ abbr: 'UEL', full: 'UEFA Europa League', sport: 'Soccer' },
	{ abbr: 'OLYSOCM', full: "Olympic Men's Soccer", sport: 'Soccer' },
	{ abbr: 'OLYSOCW', full: "Olympic Women's Soccer", sport: 'Soccer' },
	{ abbr: 'FIFAWC', full: 'FIFA World Cup', sport: 'Soccer' },
	{ abbr: 'FIFAWWC', full: "FIFA Women's World Cup", sport: 'Soccer' },
];
---
<section class="section-pad bg-[rgba(22,27,34,0.5)]">
	<div class="container">

		<div class="row align-items-center g-5">
			<div class="col-lg-5 reveal">
				<h2 class="section-title mb-4">
					31 leagues.<br>If it's live,<br>it's covered.
				</h2>
				<p class="section-sub">
					Six sports. One place. ArenaSwap monitors every league at once
					so you don't have to choose which game to watch — just watch the best one.
				</p>
			</div>

			<div class="col-lg-7 reveal reveal-delay-2">
				<div
					id="leagues-carousel"
					class="carousel slide"
					data-bs-ride="carousel"
					data-bs-interval="2200"
				>
					<div class="carousel-inner">
						{leagues.map((l, i) => (
							<div class={`carousel-item${i === 0 ? ' active' : ''}`}>
								<div class="league-carousel-card">
									<img
										src={`/arenaswap/images/leagues/${l.abbr.toLowerCase()}.png`}
										alt={l.abbr}
										class="league-carousel-logo"
										onerror="this.style.display='none'"
									/>
									<span class="league-carousel-full">{l.full}</span>
								</div>
							</div>
						))}
					</div>

					<div class="carousel-indicators league-carousel-indicators">
						{leagues.map((_, i) => (
							<button
								type="button"
								data-bs-target="#leagues-carousel"
								data-bs-slide-to={String(i)}
								class={i === 0 ? 'active' : ''}
								aria-current={i === 0 ? 'true' : undefined}
								aria-label={`League ${i + 1}`}
							/>
						))}
					</div>
				</div>
			</div>
		</div>

	</div>
</section>
