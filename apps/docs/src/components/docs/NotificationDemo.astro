---
import { celticsKnicks, notificationScore } from './demoGames';
import { demoTranslator, tiedReason } from './demoStrings';
import { currentLocale, useTranslations } from '../../i18n/ui';

const locale = currentLocale(Astro.currentLocale);
const demoText = demoTranslator(locale);
const t = useTranslations(locale);

const { game } = celticsKnicks;
const icon = `${import.meta.env.BASE_URL}images/128.png`;
---
<div class='doc-demo-notification'>
	<img class='doc-demo-notification-icon' src={icon} alt='' width='40' height='40' />
	<div class='doc-demo-notification-body'>
		<div class='doc-demo-notification-source'>
			<span>ArenaSwap</span>
			<span>{t('docDemos.notificationNow')}</span>
		</div>
		<div class='doc-demo-notification-title'>{demoText('notification.switchedTitle', { score: notificationScore })}</div>
		<div class='doc-demo-notification-message'>{demoText('notification.switchedMessageWithReason', { reason: tiedReason(demoText), venue: game.venueName ?? '' })}</div>
	</div>
</div>
