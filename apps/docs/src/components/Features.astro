---
const features = [
	{
		icon: 'bi-collection-play',
		title: '31 leagues.',
		subtitle: 'One extension.',
		body: 'NBA, NFL, NHL, MLB, EPL, Champions League, MLS, all major international soccer, NCAA, Olympics, and more — monitored simultaneously. Open your tabs and walk away.',
	},
	{
		icon: 'bi-arrow-repeat',
		title: 'Set it once.',
		subtitle: 'Watch everything.',
		body: 'Open your streams, assign them to games, walk away. ArenaSwap handles every switch from that point on — no clicking, no checking, no missing.',
	},
	{
		icon: 'bi-graph-up',
		title: 'See why.',
		subtitle: 'Every time.',
		body: 'Five signals power every score. Open any game to see the live breakdown, PowerScore trend, score history, and margin chart. No black-box guessing.',
	},
	{
		icon: 'bi-sliders',
		title: 'Your rules.',
		subtitle: 'Your game.',
		body: 'Dial sensitivity up or down, set a cooldown, boost games with your favorite teams, and filter to the leagues you care about.',
	},
];
---
<section id="features" class="section-pad">
	<div class="container">

		<div class="mb-5 reveal">
			<h2 class="section-title">
				Built for how<br>fans actually watch.
			</h2>
		</div>

		{features.map((f, i) => (
			<div class={`row align-items-center g-5 feature-row reveal reveal-delay-${(i % 4) + 1}`}>

				<div class={`col-lg-5 d-flex justify-content-center ${i % 2 === 1 ? 'order-lg-2' : ''}`}>
					<div class="feature-icon-display">
						<i class={`bi ${f.icon}`}></i>
					</div>
				</div>

				<div class={`col-lg-7 ${i % 2 === 1 ? 'order-lg-1' : ''}`}>
					<h3 class="feature-row-title">
						{f.title}<br />{f.subtitle}
					</h3>
					<p class="feature-row-body">{f.body}</p>
				</div>

			</div>
		))}

	</div>
</section>
