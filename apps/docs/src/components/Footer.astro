---
---
<footer style="background:var(--color-bg);">
	<div class="section-divider"></div>
	<div class="container py-5">

		<div class="row align-items-center g-4">
			<div class="col-lg-4">
				<img src="/arenaswap/images/full_logo_white_on_transparent.png" alt="ArenaSwap" style="height:24px;width:auto;" class="mb-3" />
				<p style="font-size:0.85rem;color:var(--color-muted);margin:0;">
					Built by sports fans, for sports fans.
				</p>
			</div>

			<div class="col-lg-4 d-flex justify-content-lg-center gap-4 flex-wrap">
				<a href="/arenaswap/#features" style="font-size:0.85rem;color:var(--color-muted);text-decoration:none;">Features</a>
				<a href="/arenaswap/#how-it-works" style="font-size:0.85rem;color:var(--color-muted);text-decoration:none;">How It Works</a>
				<a href="/arenaswap/#powerscore" style="font-size:0.85rem;color:var(--color-muted);text-decoration:none;">PowerScore</a>
				<a href="/arenaswap/powerscore/" style="font-size:0.85rem;color:var(--color-muted);text-decoration:none;">Package</a>
				<a href="/arenaswap/#faq" style="font-size:0.85rem;color:var(--color-muted);text-decoration:none;">FAQ</a>
			</div>

			<div class="col-lg-4 d-flex justify-content-lg-end gap-3">
				<a href="https://github.com/hiteacheryouare/arenaswap" title="GitHub" class="footer-icon-link"><i class="bi bi-github"></i></a>
				<a href="https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhnimajppamfeee" title="Chrome Web Store" class="footer-icon-link"><i class="bi bi-browser-chrome"></i></a>
				<a href="https://addons.mozilla.org/addon/arenaswap/" title="Firefox Add-ons" class="footer-icon-link"><i class="bi bi-browser-firefox"></i></a>
				<a href="https://microsoftedge.microsoft.com/addons/detail/arenaswap/oeballpnidkinkcbjokogdgjckdjeeba" title="Edge Add-ons" class="footer-icon-link"><i class="bi bi-browser-edge"></i></a>
			</div>
		</div>

		<div class="section-divider my-4"></div>

		<div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

			<span style="font-size:0.78rem;color:var(--color-muted);">ISC License</span>
		</div>

		<p class="footer-disclaimer">
			Not affiliated with or endorsed by ESPN, the NFL, NBA, NHL, MLB, MLS, or any other league tracked by this extension.
		</p>

	</div>
	<div class="footer-gradient-bar tracking-tight">
		<span>Made with ❤️ in Philadelphia & Boston by <a href="https://hiteacheryouare.github.io">Ryan Mullin</a></span>
	</div>
</footer>
