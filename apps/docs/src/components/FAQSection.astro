<section id="faq" class="section-pad" style="background:rgba(22,27,34,0.5);">
	<div class="container">

		<div class="row g-5">
			<div class="col-lg-4 reveal">
				<h2 class="section-title mb-4">
					Questions?
				</h2>
				<a href="https://github.com/hiteacheryouare/arenaswap" class="btn btn-cta mt-3 d-inline-flex align-items-center gap-2">
					<i class="bi bi-github"></i> View on GitHub
				</a>
			</div>

			<div class="col-lg-8 reveal reveal-delay-2">
				<FAQ client:visible />
			</div>
		</div>

	</div>
</section>
