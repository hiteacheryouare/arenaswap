---
import Crest from '@arenaswap/ui/src/components/crest';
import CrestSettle from '../CrestSettle.astro';
import { mosaicGames } from './mosaicGames';

const scoringPlays: Record<string, string> = {
	football: '7,3',
	basketball: '2,3',
	baseball: '1',
	hockey: '1',
	soccer: '1',
};

const games = mosaicGames(150);
---
<div class='about-mosaic' aria-hidden='true' data-about-mosaic data-crest-settle>
	{games.map(game => (
		<div class='about-tile' data-plays={scoringPlays[game.sport]}>
			<div class='about-tile-card' style={`--away:${game.away.color};--home:${game.home.color}`}>
				<span class='about-tile-team'>
					<Crest logo={game.away.logo} abbreviation={game.away.abbreviation} teamColor={game.away.color} loading='lazy' />
					<b>{game.awayScore}</b>
				</span>
				<span class='about-tile-team'>
					<Crest logo={game.home.logo} abbreviation={game.home.abbreviation} teamColor={game.home.color} loading='lazy' />
					<b>{game.homeScore}</b>
				</span>
			</div>
		</div>
	))}
</div>

<CrestSettle />

<script>
	const score = (tile: HTMLElement) => {
		const plays = (tile.dataset.plays ?? '1').split(',').map(Number);
		const sides = tile.querySelectorAll<HTMLElement>('b');
		const side = sides[Math.floor(Math.random() * sides.length)];
		if (!side) return;
		side.textContent = String(Number(side.textContent) + plays[Math.floor(Math.random() * plays.length)]!);
		side.classList.remove('is-scored');
		void side.offsetWidth;
		side.classList.add('is-scored');
	};

	const mosaic = document.querySelector<HTMLElement>('[data-about-mosaic]');
	const hero = mosaic?.closest('section');

	if (mosaic && hero) {
		const tiles = [...mosaic.querySelectorAll<HTMLElement>('.about-tile')];
		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const holdMs = 900;
		const pullBackMs = 2400;
		const pickEveryMs = 2600;
		const scoreAfterMs = 900;
		const intro = !still && window.scrollY < 10;
		const introEndsAt = performance.now() + (intro ? holdMs + pullBackMs : 0);
		let picked: HTMLElement | null = null;
		let timer = 0;
		let onScreen = true;

		const copyBox = () => {
			const boxes = [...hero.querySelectorAll('.about-word')].map(word => word.getBoundingClientRect());
			const lede = hero.querySelector('.band-lede');
			if (lede) {
				const range = document.createRange();
				range.selectNodeContents(lede);
				boxes.push(range.getBoundingClientRect());
			}
			return {
				left: Math.min(...boxes.map(box => box.left)),
				right: Math.max(...boxes.map(box => box.right)),
				top: Math.min(...boxes.map(box => box.top)),
				bottom: Math.max(...boxes.map(box => box.bottom)),
			};
		};

		const placed = (tile: HTMLElement) => {
			const frame = hero.getBoundingClientRect();
			const left = frame.left + tile.offsetLeft;
			const top = frame.top + tile.offsetTop;
			return { left, top, right: left + tile.offsetWidth, bottom: top + tile.offsetHeight, width: tile.offsetWidth, height: tile.offsetHeight };
		};

		const fade = () => {
			const copy = copyBox();
			const frame = hero.getBoundingClientRect();
			const reach = tiles[0]?.offsetWidth ?? 100;
			const grow = reach * (parseFloat(getComputedStyle(mosaic).getPropertyValue('--pick-scale')) - 1) / 2;
			const topLimit = frame.top + 64 + grow;
			const bottomLimit = frame.top + frame.height * 0.72;
			tiles.forEach(tile => {
				const box = placed(tile);
				const across = Math.max(copy.left - box.right, box.left - copy.right, 0);
				const down = Math.max(copy.top - box.bottom, box.top - copy.bottom, 0);
				const clear = Math.min(1, Math.hypot(across, down) / (reach * 0.6));
				tile.style.setProperty('--fade', clear.toFixed(2));
				const roomy = box.left - grow >= frame.left + 4 && box.right + grow <= frame.right - 4 && box.top >= topLimit && box.bottom <= bottomLimit;
				tile.toggleAttribute('data-pickable', clear === 1 && roomy);
			});
		};

		const crown = (tile: HTMLElement, scoreAfter: number) => {
			picked?.classList.remove('is-picked');
			tile.classList.add('is-picked');
			picked = tile;
			if (!still) window.setTimeout(() => score(tile), scoreAfter);
		};

		const pick = () => {
			const pool = tiles.filter(tile => tile !== picked && tile.hasAttribute('data-pickable'));
			const next = pool[Math.floor(Math.random() * pool.length)];
			if (next) crown(next, scoreAfterMs);
		};

		const pullBack = (start: HTMLElement) => {
			const frame = hero.getBoundingClientRect();
			const box = placed(start);
			const centreX = box.left + box.width / 2;
			const centreY = box.top + box.height / 2;
			const pickScale = parseFloat(getComputedStyle(mosaic).getPropertyValue('--pick-scale'));
			const zoom = Math.max(1.5, Math.min(window.innerHeight * 0.42, window.innerWidth * 0.55) / (box.width * pickScale));
			const shiftX = window.innerWidth / 2 - centreX;
			const shiftY = window.innerHeight / 2 - centreY;
			const steps = 24;
			const frames = Array.from({ length: steps + 1 }, (_, step) => {
				const scale = zoom ** (1 - step / steps);
				const along = (scale - 1) / (zoom - 1);
				return { offset: step / steps, transform: `translate(${shiftX * along}px, ${shiftY * along}px) scale(${scale})` };
			});
			const far = Math.hypot(frame.width, frame.height) / 2;
			tiles.forEach(tile => {
				const other = placed(tile);
				const distance = Math.hypot(other.left - box.left, other.top - box.top);
				const deal = tile === start ? 0 : holdMs * 0.7 + (distance / far) * pullBackMs * 0.5;
				tile.style.setProperty('--deal', `${Math.round(deal)}ms`);
			});
			mosaic.style.transformOrigin = `${centreX - frame.left}px ${centreY - frame.top}px`;
			mosaic.animate(frames, { duration: pullBackMs, delay: holdMs, easing: 'cubic-bezier(0.6, 0, 0.25, 1)', fill: 'backwards' });

			mosaic.classList.add('is-dealt', 'is-zooming');
			crown(start, holdMs * 0.45);
			window.setTimeout(() => mosaic.classList.remove('is-zooming'), holdMs + pullBackMs * 0.7);
		};

		const run = (delay: number) => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => {
				if (!onScreen || document.hidden) return;
				pick();
				run(pickEveryMs);
			}, Math.max(delay, introEndsAt - performance.now() + pickEveryMs * 0.6));
		};

		fade();
		new ResizeObserver(fade).observe(hero);
		document.fonts.ready.then(fade);

		if (!intro) hero.style.setProperty('--intro', '0ms');

		const opener = tiles.filter(tile => tile.hasAttribute('data-pickable'));
		const start = opener[Math.floor(Math.random() * opener.length)];

		if (still) {
			pick();
		} else {
			if (intro && start) pullBack(start);
			else pick();
			new IntersectionObserver(([entry]) => {
				onScreen = Boolean(entry?.isIntersecting);
				if (onScreen) run(pickEveryMs / 2);
			}).observe(hero);
			document.addEventListener('visibilitychange', () => {
				if (!document.hidden) run(pickEveryMs / 2);
			});
		}
	}
</script>
