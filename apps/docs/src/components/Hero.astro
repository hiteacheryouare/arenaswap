---
---
<section id="hero" class="position-relative d-flex align-items-center" style="min-height:100vh;padding-top:80px;">
	<div class="hero-glow"></div>

	<div class="container">

		<div class="row align-items-center g-5">

			<!-- Left: Headline + CTAs -->
			<div class="col-lg-6">

				<h1 class="hero-headline">
					<span class="hero-word hero-word-1">Never</span>&nbsp;<span class="hero-word hero-word-2">miss</span>
					<br>
					<span class="hero-word hero-word-3">the</span>&nbsp;<span class="hero-word hero-word-4">moment.</span>
				</h1>

				<p class="hero-sub">
					ArenaSwap watches every live game across 31 leagues
					and switches your browser tab to the most exciting one —
					automatically, every 15 seconds.
				</p>

				<div class="hero-cta d-flex flex-column align-items-start gap-3">
					<a href="https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhjpamfeee" class="btn btn-cta btn-cta-pulse hero-cta-primary">
						<i class="bi bi-browser-chrome me-2"></i>Add to Chrome
					</a>
					<div class="hero-cta-alts">
						Also available for
						<a href="https://addons.mozilla.org/addon/arenaswap/" class="hero-cta-alt-link">
							<i class="bi bi-browser-firefox me-1"></i>Firefox
						</a>
						and
						<a href="https://microsoftedge.microsoft.com/addons/detail/arenaswap/oeballpnidkinkcbjokogdgjckdjeeba" class="hero-cta-alt-link">
							<i class="bi bi-browser-edge me-1"></i>Edge
						</a>
					</div>
				</div>

			</div>

			<!-- Right: Extension preview -->
			<div class="col-lg-6 d-flex justify-content-center justify-content-lg-end">
				<div class="demo-popup-wrapper">
					<div class="demo-popup">
						<div class="demo-popup-inner">

							<!-- Header: logo + tour + settings + toggle -->
							<div class="demo-header">
								<img src="/arenaswap/images/full_logo_white_on_transparent.png" alt="ArenaSwap" class="demo-logo-img" />
								<div class="demo-header-right">
									<i class="bi bi-question-circle" style="color:#8b949e;font-size:0.9rem;"></i>
									<i class="bi bi-gear-fill" style="color:#8b949e;font-size:0.9rem;"></i>
									<div class="demo-switch">
										<div class="demo-switch-thumb"></div>
									</div>
								</div>
							</div>

							<!-- Active Tabs heading -->
							<div class="demo-section-title">Active Tabs</div>

							<!-- NCAAB: BU vs NU — hottest game -->
							<div class="demo-league-row">
								<img src="/arenaswap/images/leagues/ncaab.png" alt="NCAAB" class="demo-league-icon" onerror="this.style.display='none'" />
								<span class="demo-league-label-text">NCAAB</span>
							</div>
							<div class="demo-card" style="border-left:4px solid #CC0000;border-right:4px solid #CC0000;background:linear-gradient(to right,#CC000020,#CC000020),#fff;">
								<div class="demo-live">
									<span class="demo-live-dot"></span>LIVE
								</div>
								<div class="demo-matchup">
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/ncaa/500/104.png" alt="BU" class="demo-team-logo-img" />
										</div>
										<span class="demo-team-abbr">BU</span>
									</div>
									<div class="demo-center-col">
										<div class="demo-scores">
											<span class="demo-score">42</span>
											<span class="demo-sep"></span>
											<span class="demo-score">45</span>
										</div>
										<span class="demo-clock">2:42</span>
										<span class="demo-period">4th</span>
									</div>
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/ncaa/500/111.png" alt="NU" class="demo-team-logo-img" />
										</div>
										<span class="demo-team-abbr">NU</span>
									</div>
								</div>
								<div class="demo-ps-bar-row">
									<span class="demo-ps-label">PowerScore</span>
									<div class="demo-ps-progress">
										<div class="demo-ps-fill" style="width:89%;background:linear-gradient(to right,#8b949e,#F75C03);"></div>
									</div>
									<span class="demo-ps-score" style="color:#F75C03;">89</span>
								</div>
								<div class="demo-tab-row">
									<select class="demo-select"><option>Tab 2: truTV</option></select>
								</div>
							</div>

							<!-- NFL: Chiefs vs Ravens — showing down & distance -->
							<div class="demo-league-row" style="margin-top:0.35rem;">
								<img src="/arenaswap/images/leagues/nfl.png" alt="NFL" class="demo-league-icon" onerror="this.style.display='none'" />
								<span class="demo-league-label-text">NFL</span>
							</div>
							<div class="demo-card" style="border-left:4px solid #E31837;border-right:4px solid #241773;background:linear-gradient(to right,#E3183720,#24177320),#fff;">
								<div class="demo-live">
									<span class="demo-live-dot"></span>LIVE
								</div>
								<div class="demo-matchup">
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/nfl/500/kc.png" alt="KC" class="demo-team-logo-img" />
										</div>
										<span class="demo-team-abbr">KC</span>
									</div>
									<div class="demo-center-col">
										<div class="demo-scores">
											<span class="demo-score">17</span>
											<span class="demo-sep"></span>
											<span class="demo-score">20</span>
										</div>
										<span class="demo-clock">1:18</span>
										<span class="demo-period">Q4</span>
										<span class="demo-down-dist">3rd &amp; 6</span>
									</div>
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/nfl/500/bal.png" alt="BAL" class="demo-team-logo-img" />
										</div>
										<span class="demo-team-abbr">BAL</span>
									</div>
								</div>
								<div class="demo-ps-bar-row">
									<span class="demo-ps-label">PowerScore</span>
									<div class="demo-ps-progress">
										<div class="demo-ps-fill" style="width:76%;background:linear-gradient(to right,#8b949e,#F75C03);"></div>
									</div>
									<span class="demo-ps-score" style="color:#db6b2b;">76</span>
								</div>
								<div class="demo-tab-row">
									<select class="demo-select"><option>Tab 1: ESPN</option></select>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>

	</div>

	<div class="hero-scroll-indicator">
		<i class="bi bi-chevron-down"></i>
	</div>
</section>
