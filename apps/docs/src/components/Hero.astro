---
import { Image } from 'astro:assets';
import HeroCard from './HeroCard';
import logoImg from '../assets/full_logo_white_on_transparent.svg';
import mlbImg from '../assets/leagues/mlb.png';
import nflImg from '../assets/leagues/nfl.png';

const phiMiaGame = {
	id: 'hero-mlb',
	league: 'mlb' as const,
	sportType: 'baseball' as const,
	awayTeam: { id: 'mia', name: 'Miami Marlins', abbreviation: 'MIA', score: 2, logo: 'https://a.espncdn.com/i/teamlogos/mlb/500/mia.png', color: '#00A3E0', alternateColor: '#EF3340' },
	homeTeam: { id: 'phi', name: 'Philadelphia Phillies', abbreviation: 'PHI', score: 4, logo: 'https://a.espncdn.com/i/teamlogos/mlb/500/phi.png', color: '#E81828', alternateColor: '#002D72' },
	period: 7, clockSeconds: 0, status: 'in' as const,
	topOfInning: false,
	broadcasts: ['ESPN+'],
};
const phiMiaScore = { gameId: 'hero-mlb', total: 78, closeness: 22, lateGame: 20, momentum: 18, leadChanges: 10, comeback: 8, reason: '' };

const phiDalGame = {
	id: 'hero-nfl',
	league: 'nfl' as const,
	sportType: 'football' as const,
	awayTeam: { id: 'dal', name: 'Dallas Cowboys', abbreviation: 'DAL', score: 17, logo: 'https://a.espncdn.com/i/teamlogos/nfl/500/dal.png', color: '#003594', alternateColor: '#869397' },
	homeTeam: { id: 'phi', name: 'Philadelphia Eagles', abbreviation: 'PHI', score: 21, logo: 'https://a.espncdn.com/i/teamlogos/nfl/500/phi.png', color: '#004C54', alternateColor: '#A5ACAF' },
	period: 4, clockSeconds: 185, status: 'in' as const,
	downDistance: '2nd & 8',
	broadcasts: ['FOX'],
};
const phiDalScore = { gameId: 'hero-nfl', total: 72, closeness: 20, lateGame: 18, momentum: 16, leadChanges: 10, comeback: 8, reason: '' };
---
<section id="hero" class="position-relative d-flex align-items-center" style="min-height:100vh;padding-top:80px;">

	<canvas id="hero-canvas" aria-hidden="true"></canvas>

	<div class="container">

		<div class="row align-items-center g-5">

			<!-- Left: Headline + CTAs -->
			<div class="col-lg-6">

				<h1 class="hero-headline">
					<span class="hero-word hero-word-1">Never</span>&nbsp;<span class="hero-word hero-word-2">miss</span>
					<br>
					<span class="hero-word hero-word-3">the</span>&nbsp;<span class="hero-word hero-word-4"><span class="hero-accent">moment.</span></span>
				</h1>

				<p class="hero-sub">
					ArenaSwap watches every live game across 30+ leagues
					and automatically switches your browser tab to the most
					exciting one, as fast as every 6 seconds.
				</p>

				<div class="hero-cta d-flex flex-column align-items-start gap-3">
					<a href="https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhnimajppamfeee" class="btn btn-cta btn-cta-pulse hero-cta-primary">
						<i class="bi bi-browser-chrome me-2"></i>Add to Chrome
					</a>
					<div class="hero-cta-alts">
						Also available for
						<a href="https://addons.mozilla.org/addon/arenaswap/" class="hero-cta-alt-link">
							<i class="bi bi-browser-firefox me-1"></i>Firefox
						</a>
						and
						<a href="https://microsoftedge.microsoft.com/addons/detail/arenaswap/oeballpnidkinkcbjokogdgjckdjeeba" class="hero-cta-alt-link">
							<i class="bi bi-browser-edge me-1"></i>Edge
						</a>
					</div>
				</div>

			</div>

			<!-- Right: Extension preview -->
			<div class="col-lg-6 d-flex justify-content-center justify-content-lg-end">
				<div class="demo-popup-wrapper">
					<div class="demo-popup">
						<div class="demo-popup-inner">

							<!-- Header: logo + tour + settings + toggle -->
							<div class="demo-header">
								<Image src={logoImg} alt="ArenaSwap" class="demo-logo-img" loading="eager" />
								<div class="demo-header-right">
									<i class="bi bi-question-circle" style="color:#8b949e;font-size:0.9rem;"></i>
									<i class="bi bi-gear-fill" style="color:#8b949e;font-size:0.9rem;"></i>
									<div class="demo-switch">
										<div class="demo-switch-thumb"></div>
									</div>
								</div>
							</div>

							<!-- Active Tabs heading -->
							<div class="demo-section-title">Active Tabs</div>

							<!-- MLB: Phillies vs Marlins -->
							<div class="demo-league-row">
								<Image src={mlbImg} alt="MLB" class="demo-league-icon" />
								<span class="demo-league-label-text">MLB</span>
							</div>
							<HeroCard game={phiMiaGame} excitementResult={phiMiaScore} tabLabel="Tab 1: ESPN+" />

							<!-- NFL: Eagles vs Cowboys -->
							<div class="demo-league-row" style="margin-top:0.35rem;">
								<Image src={nflImg} alt="NFL" class="demo-league-icon" />
								<span class="demo-league-label-text">NFL</span>
							</div>
							<HeroCard game={phiDalGame} excitementResult={phiDalScore} tabLabel="Tab 2: FOX" />

						</div>
					</div>
				</div>
			</div>
		</div>

	</div>

	<div class="hero-scroll-indicator">
		<i class="bi bi-chevron-down"></i>
	</div>
</section>

<script>
// ─── ArenaSwap Hero Canvas — "Raw data in, PowerScore out" ────────────────────
//
// A single one-shot story, then a permanent resting state:
//   RAW     (1.1s)  — colourless sports data drifts across the page
//   INTAKE  (3.6s)  — every particle spirals into the extension popup
//   CHARGE  (1.2s)  — the swarm holds inside the card and fills with PowerScore colour
//   BURST   (0.9s)  — the scored data sprays back out across the whole screen
//   SETTLE  (∞)     — it is slowly dragged home and orbits the card forever
//
// Everything after RAW is parametric in polar space around the card (r, angle),
// which keeps the motion smooth and lets the terminal state be genuinely stable
// instead of slowly degenerating. Rendering is sprite-based: no per-particle
// gradient or rgba() string is built at frame time, and the loop parks itself
// whenever the hero is off-screen or the tab is hidden.

const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
const ctx    = canvas?.getContext('2d', { alpha: true }) ?? null;

const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

// ─── PowerScore palette ──────────────────────────────────────────────────────
// The five signal colours the PowerScore breakdown uses, orange-weighted.
const RAW_RGB: RGB = [150, 158, 168];
const COLORS: RGB[] = [
	[247,  92,   3], // closeness  — ArenaSwap orange
	[247,  92,   3],
	[247,  92,   3],
	[ 34, 116, 165], // late game
	[ 34, 116, 165],
	[ 34, 197,  94], // momentum
	[241, 196,  15], // lead changes
	[217,   3, 104], // comeback
];
type RGB = [number, number, number];

// ─── Timeline ────────────────────────────────────────────────────────────────
type Phase = 'raw' | 'intake' | 'charge' | 'burst' | 'settle';
const ORDER: Phase[] = ['raw', 'intake', 'charge', 'burst', 'settle'];
const DUR: Record<Phase, number> = {
	raw:    1100,
	intake: 3600,
	charge: 1200,
	burst:   850,
	settle: Infinity,
};

let phase: Phase = 'raw';
let phaseIdx = 0;
let phaseT   = 0;
let clock    = 0; // ms since boot, for twinkle/wobble

// ─── PRNG (seeded per load so no two visits look identical) ──────────────────
let seed = (Date.now() ^ 0x9e3779b9) >>> 0;
function rand(): number {
	seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
	return seed / 4294967296;
}

const TAU = Math.PI * 2;
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
const clamp01 = (t: number) => (t < 0 ? 0 : t > 1 ? 1 : t);
// Slow start, confident middle, soft landing — the "pulled in" feel.
const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
const easeOutCubic   = (t: number) => 1 - Math.pow(1 - t, 3);

// ─── Particle ────────────────────────────────────────────────────────────────
interface Pt {
	x: number; y: number;   // css px
	vx: number; vy: number; // cartesian velocity — raw + burst only
	r: number; a: number;   // polar around the card
	rv: number; av: number; // polar velocity — settle only
	sr: number; sa: number; // polar snapshot taken when intake begins
	turns: number;          // radians of spiral swept on the way in
	orbR: number;           // radius held while charging inside the card
	ring: boolean;          // rises into the visible accretion ring while charging
	ringK: number;          // ring radius, as a multiple of the card radius
	haloK: number;          // permanent resting radius, as a multiple of the card radius
	spin: number;           // orbital rate, rad/frame
	sz: number;             // core radius, css px
	op: number;             // base opacity
	tw: number;             // twinkle phase offset
	ci: number;             // palette index
	ct: number;             // 0 = raw gray, 1 = fully scored
	anchor: boolean;        // draws constellation lines
}

let W = 0, H = 0, dpr = 1;
let wellX = 0, wellY = 0, cardR = 300;
let pts: Pt[] = [];
let anchors: Pt[] = [];

// ─── Sprites (built once — the whole reason this loop is cheap) ──────────────
const SPRITE = 64;
let rawSprite: HTMLCanvasElement;
let colorSprites: HTMLCanvasElement[] = [];
let bloomSprite: HTMLCanvasElement;
let ringSprite: HTMLCanvasElement;
let ambient: HTMLCanvasElement | null = null;

function paint(size: number, stops: [number, string][]): HTMLCanvasElement {
	const c = document.createElement('canvas');
	c.width = c.height = size;
	const g = c.getContext('2d')!;
	const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
	for (const [at, color] of stops) grd.addColorStop(at, color);
	g.fillStyle = grd;
	g.fillRect(0, 0, size, size);
	return c;
}

function buildSprites() {
	const [rr, rg, rb] = RAW_RGB;
	rawSprite = paint(SPRITE, [
		[0,    `rgba(${rr},${rg},${rb},0.85)`],
		[0.22, `rgba(${rr},${rg},${rb},0.45)`],
		[0.55, `rgba(${rr},${rg},${rb},0.11)`],
		[1,    `rgba(${rr},${rg},${rb},0)`],
	]);
	colorSprites = COLORS.map(([r, g, b]) => paint(SPRITE, [
		[0,    'rgba(255,255,255,0.92)'],
		[0.14, `rgba(${r},${g},${b},0.95)`],
		[0.42, `rgba(${r},${g},${b},0.30)`],
		[1,    `rgba(${r},${g},${b},0)`],
	]));
	bloomSprite = paint(512, [
		[0,    'rgba(255,255,255,0.9)'],
		[0.12, 'rgba(255,205,150,0.55)'],
		[0.35, 'rgba(247,92,3,0.28)'],
		[1,    'rgba(247,92,3,0)'],
	]);
	ringSprite = paint(512, [
		[0,    'rgba(247,92,3,0)'],
		[0.74, 'rgba(247,92,3,0)'],
		[0.88, 'rgba(255,150,60,0.55)'],
		[0.96, 'rgba(247,92,3,0.18)'],
		[1,    'rgba(247,92,3,0)'],
	]);
}

// Static wash behind the card, blitted once per frame instead of rebuilt.
function buildAmbient() {
	const c = document.createElement('canvas');
	c.width = Math.max(1, Math.ceil(W / 4));
	c.height = Math.max(1, Math.ceil(H / 4));
	const g = c.getContext('2d')!;
	const x = wellX / 4, y = wellY / 4, rad = Math.max(W, H) / 4 * 0.62;
	const grd = g.createRadialGradient(x, y, 0, x, y, rad);
	grd.addColorStop(0,    'rgba(247,92,3,0.075)');
	grd.addColorStop(0.45, 'rgba(34,116,165,0.035)');
	grd.addColorStop(1,    'rgba(0,0,0,0)');
	g.fillStyle = grd;
	g.fillRect(0, 0, c.width, c.height);
	ambient = c;
}

// ─── Layout ──────────────────────────────────────────────────────────────────
function measure() {
	const popup = document.querySelector<HTMLElement>('#hero .demo-popup');
	const cr = canvas!.getBoundingClientRect();
	if (popup) {
		const pr = popup.getBoundingClientRect();
		wellX = pr.left - cr.left + pr.width / 2;
		wellY = pr.top - cr.top + pr.height / 2;
		cardR = Math.max(120, pr.height / 2);
	} else {
		wellX = W * 0.68;
		wellY = H * 0.48;
		cardR = Math.min(W, H) * 0.3;
	}
}

function particleCount(): number {
	// Density-matched to the viewport so phones don't push the same 700 dots.
	return Math.round(Math.min(620, Math.max(160, (W * H) / 2600)));
}

function makePt(): Pt {
	const anchor = rand() < 0.11;
	// Most of the swarm ends up hugging the card; the rest keeps the page alive.
	const haloK = rand() < 0.72 ? 0.92 + rand() * 0.5 : 1.45 + rand() * 1.6;
	return {
		x: rand() * W, y: rand() * H,
		vx: (rand() - 0.5) * 0.5, vy: (rand() - 0.5) * 0.5,
		r: 0, a: 0, rv: 0, av: 0, sr: 0, sa: 0,
		turns: 1.3 + rand() * 1.9,
		orbR: 12 + rand() * 62,
		ring: rand() < 0.36,
		ringK: 1.0 + rand() * 0.42,
		haloK,
		spin: 0.0055 + rand() * 0.004,
		sz: anchor ? 2.0 + rand() * 1.4 : 0.7 + rand() * 0.9,
		op: anchor ? 0.5 + rand() * 0.3 : 0.28 + rand() * 0.42,
		tw: rand() * TAU,
		ci: Math.floor(rand() * COLORS.length),
		ct: 0,
		anchor,
	};
}

function populate() {
	const n = particleCount();
	pts = [];
	anchors = [];
	for (let i = 0; i < n; i++) {
		const p = makePt();
		pts.push(p);
		if (p.anchor) anchors.push(p);
	}
}

function resize() {
	const rect = (canvas!.parentElement as HTMLElement).getBoundingClientRect();
	const prevW = W, prevH = H;
	const nextW = Math.max(1, Math.round(rect.width));
	const nextH = Math.max(1, Math.round(rect.height));
	const nextDpr = Math.min(2, window.devicePixelRatio || 1);
	// Mobile URL bars fire resize on every scroll — ignore the no-op ones.
	if (nextW === prevW && nextH === prevH && nextDpr === dpr && pts.length) {
		measure();
		return;
	}
	W = nextW;
	H = nextH;
	dpr = nextDpr;
	canvas!.width  = Math.round(W * dpr);
	canvas!.height = Math.round(H * dpr);
	ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

	measure();
	buildAmbient();

	if (!pts.length) {
		populate();
	} else if (prevW && prevH) {
		// Keep the story running across a resize — rescale rather than respawn.
		// Ring and halo radii are card-relative, so they follow the new layout for free.
		const kx = W / prevW, ky = H / prevH;
		for (const p of pts) {
			p.x *= kx; p.y *= ky;
			p.r = Math.hypot(p.x - wellX, p.y - wellY);
			p.a = Math.atan2(p.y - wellY, p.x - wellX);
		}
	}
}

// ─── Phase transitions ───────────────────────────────────────────────────────
function enterIntake() {
	for (const p of pts) {
		p.sr = Math.max(1, Math.hypot(p.x - wellX, p.y - wellY));
		p.sa = Math.atan2(p.y - wellY, p.x - wellX);
		p.r = p.sr;
		p.a = p.sa;
	}
}

function enterBurst() {
	// Spread wider than tall so the spray actually reaches the whole viewport.
	const ax = Math.min(1.85, Math.max(1.1, W / Math.max(1, H)));
	for (const p of pts) {
		const speed = 13 + rand() * 27;
		const cos = Math.cos(p.a), sin = Math.sin(p.a);
		p.vx = (cos * speed) * ax + (-sin * speed * 0.22);
		p.vy = (sin * speed)      + ( cos * speed * 0.22);
		p.ct = 1;
	}
}

function enterSettle() {
	for (const p of pts) {
		const cos = Math.cos(p.a), sin = Math.sin(p.a);
		p.rv =  p.vx * cos + p.vy * sin;
		p.av = (-p.vx * sin + p.vy * cos) / Math.max(40, p.r);
	}
}

function advance(dt: number) {
	if (phase === 'settle') { phaseT += dt; return; }
	phaseT += dt;
	if (phaseT < DUR[phase]) return;
	phaseT -= DUR[phase];
	phase = ORDER[++phaseIdx];
	if (phase === 'intake') enterIntake();
	if (phase === 'burst')  enterBurst();
	if (phase === 'settle') enterSettle();
}

// ─── Simulation ──────────────────────────────────────────────────────────────
function step(s: number) {
	switch (phase) {

		// Raw, uncorrelated data: slow cartesian drift, no colour, no order.
		case 'raw': {
			for (const p of pts) {
				p.vx += Math.sin(clock * 0.0009 + p.tw) * 0.006 * s;
				p.vy += Math.cos(clock * 0.0011 + p.tw * 1.7) * 0.006 * s;
				p.x += p.vx * s;
				p.y += p.vy * s;
				if (p.x < 0 || p.x > W) p.vx *= -1;
				if (p.y < 0 || p.y > H) p.vy *= -1;
			}
			break;
		}

		// Every point spirals into the popup, still colourless.
		case 'intake': {
			const e = easeInOutCubic(clamp01(phaseT / DUR.intake));
			for (const p of pts) {
				p.r = lerp(p.sr, p.orbR, e);
				p.a = p.sa + p.turns * e;
				const wob = Math.sin(clock * 0.002 + p.tw) * 2.5 * (1 - e);
				p.x = wellX + Math.cos(p.a) * (p.r + wob);
				p.y = wellY + Math.sin(p.a) * (p.r + wob);
			}
			break;
		}

		// Held inside the card, tightening — and filling with PowerScore colour.
		// A third of the swarm spins back out into a tight accretion ring so the
		// card visibly charges instead of just swallowing everything.
		case 'charge': {
			const e = clamp01(phaseT / DUR.charge);
			const squeeze = 1 - 0.25 * e * e;
			const tint = clamp01((e - 0.22) / 0.45);
			const rise = easeOutCubic(clamp01((e - 0.32) / 0.68));
			for (const p of pts) {
				const spin = p.ring ? p.spin * (1 + rise * 3.2) : p.spin;
				p.a += spin * s;
				const base = p.ring
					? lerp(p.orbR, cardR * p.ringK, rise)
					: p.orbR * squeeze;
				p.r = base * (1 + Math.sin(clock * 0.006 + p.tw) * 0.05);
				p.ct = tint;
				p.x = wellX + Math.cos(p.a) * p.r;
				p.y = wellY + Math.sin(p.a) * p.r;
			}
			break;
		}

		// Sprayed back out, scored and coloured.
		case 'burst': {
			const damp = Math.pow(0.968, s);
			for (const p of pts) {
				p.vx *= damp; p.vy *= damp;
				p.x += p.vx * s;
				p.y += p.vy * s;
				p.r = Math.hypot(p.x - wellX, p.y - wellY);
				p.a = Math.atan2(p.y - wellY, p.x - wellX);
			}
			break;
		}

		// Dragged home, then orbiting the card permanently.
		case 'settle': {
			// Under-damped at first (one gentle swing back), stiffening as it beds in.
			const age  = clamp01(phaseT / 9000);
			const damp = Math.pow(lerp(0.9915, 0.976, age), s);
			for (const p of pts) {
				p.rv += (cardR * p.haloK - p.r) * 0.00085 * s;
				p.rv *= damp;
				p.r  += p.rv * s;
				p.av += (p.spin - p.av) * 0.012 * s;
				p.a  += p.av * s;
				const breathe = Math.sin(clock * 0.0007 + p.tw) * 5;
				p.x = wellX + Math.cos(p.a) * (p.r + breathe);
				p.y = wellY + Math.sin(p.a) * (p.r + breathe);
			}
			break;
		}
	}
}

// ─── Rendering ───────────────────────────────────────────────────────────────
function drawConnections(colored: boolean) {
	const maxD = 150;
	// Three alpha buckets → three batched strokes instead of one per line.
	const buckets: [number, number][][] = [[], [], []];
	for (let i = 0; i < anchors.length - 1; i++) {
		const a = anchors[i];
		for (let j = i + 1; j < anchors.length; j++) {
			const b = anchors[j];
			const dx = a.x - b.x;
			if (dx < -maxD || dx > maxD) continue;
			const dy = a.y - b.y;
			if (dy < -maxD || dy > maxD) continue;
			const d2 = dx * dx + dy * dy;
			if (d2 > maxD * maxD) continue;
			const k = Math.min(2, Math.floor((1 - Math.sqrt(d2) / maxD) * 3));
			buckets[k].push([i, j]);
		}
	}
	ctx!.lineWidth = 0.6;
	for (let k = 0; k < 3; k++) {
		if (!buckets[k].length) continue;
		const alpha = (0.03 + k * 0.035) * (colored ? 1 : 0.7);
		ctx!.strokeStyle = colored
			? `rgba(247,140,60,${alpha})`
			: `rgba(190,200,212,${alpha})`;
		ctx!.beginPath();
		for (const [i, j] of buckets[k]) {
			ctx!.moveTo(anchors[i].x, anchors[i].y);
			ctx!.lineTo(anchors[j].x, anchors[j].y);
		}
		ctx!.stroke();
	}
}

function drawStreaks() {
	// One batched path per palette colour keeps state changes at 8/frame.
	ctx!.lineCap = 'round';
	for (let c = 0; c < COLORS.length; c++) {
		const [r, g, b] = COLORS[c];
		let opened = false;
		for (const p of pts) {
			if (p.ci !== c) continue;
			const sp = Math.abs(p.vx) + Math.abs(p.vy);
			if (sp < 3) continue;
			if (!opened) { ctx!.beginPath(); opened = true; }
			ctx!.moveTo(p.x - p.vx * 2.4, p.y - p.vy * 2.4);
			ctx!.lineTo(p.x, p.y);
		}
		if (opened) {
			ctx!.strokeStyle = `rgba(${r},${g},${b},0.16)`;
			ctx!.lineWidth = 1.1;
			ctx!.stroke();
		}
	}
}

function drawParticles(intro: number) {
	const charging = phase === 'charge';
	const glow = charging || phase === 'burst' ? 1.35 : 1;
	for (const p of pts) {
		const twinkle = 0.82 + 0.18 * Math.sin(clock * 0.0016 + p.tw);
		const hot = charging && p.ring ? 1.5 : 1;
		const op = Math.min(1, p.op * twinkle * intro * hot);
		if (op <= 0.01) continue;
		const rad = p.sz * 3.1 * glow * hot;
		const d = rad * 2;
		const x = p.x - rad, y = p.y - rad;
		if (p.ct < 0.99) {
			ctx!.globalAlpha = op * (1 - p.ct);
			ctx!.drawImage(rawSprite, x, y, d, d);
		}
		if (p.ct > 0.01) {
			ctx!.globalAlpha = op * p.ct;
			ctx!.drawImage(colorSprites[p.ci], x, y, d, d);
		}
	}
	ctx!.globalAlpha = 1;
}

function drawBloom() {
	// Builds through CHARGE, flashes on BURST, gone shortly after.
	let intensity = 0, radius = cardR * 1.6;
	if (phase === 'intake') {
		const e = clamp01(phaseT / DUR.intake);
		intensity = e * e * 0.22;
		radius = cardR * (0.9 + e * 0.35);
	} else if (phase === 'charge') {
		const e = clamp01(phaseT / DUR.charge);
		intensity = 0.24 + e * e * 0.66;
		radius = cardR * (1.25 + e * 0.5);
	} else if (phase === 'burst') {
		const e = clamp01(phaseT / DUR.burst);
		intensity = (1 - e) * 0.9;
		radius = cardR * (1.75 + e * 0.7);
	} else if (phase === 'settle' && phaseT < 1400) {
		const e = phaseT / 1400;
		intensity = (1 - e) * 0.2;
		radius = cardR * (2.45 - e * 0.7);
	} else {
		return;
	}
	ctx!.globalAlpha = intensity;
	ctx!.drawImage(bloomSprite, wellX - radius, wellY - radius, radius * 2, radius * 2);
	ctx!.globalAlpha = 1;
}

function drawShockwave() {
	const t = phase === 'burst'
		? phaseT / DUR.burst
		: phase === 'settle' && phaseT < 700 ? 1 + phaseT / 700 : -1;
	if (t < 0) return;
	const e = easeOutCubic(Math.min(1, t / 1.6));
	const radius = e * Math.max(W, H) * 0.95;
	ctx!.globalAlpha = Math.max(0, 1 - t / 1.6) * 0.5;
	ctx!.drawImage(ringSprite, wellX - radius, wellY - radius, radius * 2, radius * 2);
	ctx!.globalAlpha = 1;
}

function draw(intro: number) {
	ctx!.clearRect(0, 0, W, H);
	if (ambient) ctx!.drawImage(ambient, 0, 0, W, H);

	ctx!.globalCompositeOperation = 'lighter';
	if (phase === 'raw' || phase === 'intake') drawConnections(false);
	else if (phase === 'charge' || phase === 'settle') drawConnections(true);
	drawBloom();
	drawShockwave();
	if (phase === 'burst') drawStreaks();
	drawParticles(intro);
	ctx!.globalCompositeOperation = 'source-over';
}

// ─── Loop ────────────────────────────────────────────────────────────────────
let rafId = 0;
let lastTs = 0;
let running = false;

function frame(ts: number) {
	rafId = requestAnimationFrame(frame);
	const dt = lastTs ? Math.min(ts - lastTs, 50) : 16.7;
	lastTs = ts;
	clock += dt;

	advance(dt);
	step(dt / 16.7);
	draw(clamp01(clock / 700));
}

function start() {
	if (running) return;
	running = true;
	lastTs = 0;
	rafId = requestAnimationFrame(frame);
}

function stop() {
	if (!running) return;
	running = false;
	cancelAnimationFrame(rafId);
}

// ─── Reduced motion: skip straight to the resting state ─────────────────────
function renderResting() {
	phase = 'settle';
	phaseIdx = ORDER.length - 1;
	phaseT = 60000;
	for (const p of pts) {
		p.r = cardR * p.haloK;
		p.a = rand() * TAU;
		p.ct = 1;
		p.x = wellX + Math.cos(p.a) * p.r;
		p.y = wellY + Math.sin(p.a) * p.r;
	}
	draw(1);
}

// ─── Boot ────────────────────────────────────────────────────────────────────
if (canvas && ctx) {
	buildSprites();
	resize();

	let resizeRaf = 0;
	window.addEventListener('resize', () => {
		cancelAnimationFrame(resizeRaf);
		resizeRaf = requestAnimationFrame(() => {
			resize();
			if (prefersReducedMotion) renderResting();
		});
	}, { passive: true });

	if (prefersReducedMotion) {
		renderResting();
		// The card's own entrance transform is still settling on first paint, so
		// re-measure once it lands or the halo sits a couple of dozen px high.
		setTimeout(() => { measure(); renderResting(); }, 1700);
	} else {
		// Only burn frames while the hero is actually on screen and the tab is live.
		let onScreen = true;
		const sync = () => (onScreen && document.visibilityState === 'visible' ? start() : stop());
		document.addEventListener('visibilitychange', sync);
		new IntersectionObserver((entries) => {
			onScreen = entries[0].isIntersecting;
			sync();
		}, { threshold: 0 }).observe(canvas);
		start();
	}
}
</script>
