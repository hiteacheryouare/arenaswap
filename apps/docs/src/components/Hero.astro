---
---
<section id="hero" class="position-relative d-flex align-items-center" style="min-height:100vh;padding-top:80px;">
	<div class="hero-glow"></div>

	<div class="container">
		<div class="row align-items-center g-5">

			<!-- Left: copy -->
			<div class="col-lg-6">
				<h1 class="hero-headline">
					<span class="hero-word hero-word-1">Never</span>
					<span class="hero-word hero-word-2">miss</span>
					<br>
					<span class="hero-word hero-word-3">the</span>
					<span class="hero-word hero-word-4">moment.</span>
				</h1>

				<p class="hero-sub">
					ArenaSwap watches every live game across 11 leagues
					and switches your browser tab to the most exciting one —
					automatically, every 15 seconds.
				</p>

				<div class="hero-cta d-flex flex-wrap gap-3">
					<a href="#" class="btn btn-cta btn-cta-pulse">
						<i class="bi bi-browser-chrome me-2"></i>Add to Chrome
					</a>
					<a href="#" class="btn btn-outline-secondary-custom">
						<i class="bi bi-browser-firefox me-2"></i>Add to Firefox
					</a>
				</div>
			</div>

			<!-- Right: pixel-accurate popup replica -->
			<div class="col-lg-6 d-flex justify-content-center justify-content-lg-end">
				<div class="demo-popup-wrapper">
					<div class="demo-popup">
						<div class="demo-popup-inner">

							<!-- Header -->
							<div class="demo-header">
								<img src="/arenaswap/images/full_logo_white_on_transparent.png" alt="ArenaSwap" class="demo-logo-img" />
								<div class="demo-header-right">
									<i class="bi bi-gear-fill" style="color:#8b949e;font-size:0.9rem;"></i>
									<div class="demo-switch">
										<div class="demo-switch-thumb"></div>
									</div>
								</div>
							</div>

							<!-- Section: Active Tabs -->
							<div class="demo-section-title">Active Tabs</div>

							<!-- NCAAB: BU vs Northeastern — hottest -->
							<div class="demo-league-label">NCAAB</div>
							<div class="demo-card" style="border-left:5px solid #CC0000;border-right:5px solid #CC0000;background:linear-gradient(to right,#CC000028,#CC000028),#ffffff;">
								<div class="demo-card-top">
									<div class="demo-live">
										<span class="demo-live-dot"></span>
										LIVE
									</div>
									<div class="demo-ps" style="background:#F75C03;">
										PowerScore: 89 / 100 <i class="bi bi-chevron-down"></i>
									</div>
								</div>
								<div class="demo-matchup">
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/ncaa/500/104.png" alt="BU" class="demo-team-logo-img" />
										</div>
										<i class="bi bi-star demo-star-icon"></i>
										<span class="demo-team-abbr">BU</span>
									</div>
									<div class="demo-center-col">
										<div class="demo-scores">
											<span class="demo-score">42</span>
											<span class="demo-score">45</span>
										</div>
										<span class="demo-clock">2:42</span>
										<span class="demo-period">4th</span>
									</div>
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/ncaa/500/111.png" alt="NU" class="demo-team-logo-img" />
										</div>
										<i class="bi bi-star-fill demo-star-icon" style="color:#f1c40f;"></i>
										<span class="demo-team-abbr">NU</span>
									</div>
								</div>
								<div class="demo-meta">
									<span class="demo-meta-venue">Matthews Arena · Boston, MA</span>
									<span class="demo-meta-network">TNT, truTV</span>
								</div>
								<div class="demo-tab-row">
									<select class="demo-select">
										<option>Tab 2: truTV</option>
									</select>
								</div>
							</div>

							<!-- NBA: Bulls vs 76ers -->
							<div class="demo-league-label">NBA</div>
							<div class="demo-card" style="border-left:5px solid #CE1141;border-right:5px solid #006BB6;background:linear-gradient(to right,#CE114128,#006BB628),#ffffff;">
								<div class="demo-card-top">
									<div class="demo-live">
										<span class="demo-live-dot"></span>
										LIVE
									</div>
									<div class="demo-ps" style="background:#d06800;">
										PowerScore: 74 / 100 <i class="bi bi-chevron-down"></i>
									</div>
								</div>
								<div class="demo-matchup">
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/nba/500/4.png" alt="CHI" class="demo-team-logo-img" />
										</div>
										<i class="bi bi-star demo-star-icon"></i>
										<span class="demo-team-abbr">CHI</span>
									</div>
									<div class="demo-center-col">
										<div class="demo-scores">
											<span class="demo-score">65</span>
											<span class="demo-score">68</span>
										</div>
										<span class="demo-clock">4:44</span>
										<span class="demo-period">3rd</span>
									</div>
									<div class="demo-team-col">
										<div class="demo-team-logo-wrap">
											<img src="https://a.espncdn.com/i/teamlogos/nba/500/20.png" alt="PHI" class="demo-team-logo-img" />
										</div>
										<i class="bi bi-star-fill demo-star-icon" style="color:#f1c40f;"></i>
										<span class="demo-team-abbr">PHI</span>
									</div>
								</div>
								<div class="demo-meta">
									<span class="demo-meta-venue">Xfinity Mobile Arena · Philadelphia, PA</span>
									<span class="demo-meta-network">ESPN, NBCSN</span>
								</div>
								<div class="demo-tab-row">
									<select class="demo-select">
										<option>Tab 1: ESPN</option>
									</select>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>

		</div>
	</div>

	<div class="hero-scroll-indicator">
		<i class="bi bi-chevron-down"></i>
	</div>
</section>
