---
import MachineScene from './MachineScene.tsx';
import { currentLocale, uiStrings, useTranslations } from '../i18n/ui';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<section id="machine" class="machine-section">
	<noscript>
		<style>
			.machine-viewport { display: none !important; }
			.machine-fallback { display: block !important; }
		</style>
	</noscript>

	<div class="container machine-header reveal">
		<h2 class="section-title">{t('powerscore.machineHeading')}</h2>
		<p class="section-sub">{t('powerscore.machineSub')}</p>
	</div>

	<!-- Auto-playing ECharts + SVG explainer (hydrates on view) -->
	<MachineScene
		client:visible
		strings={{
			alt: t('powerscore.machineAlt'),
			nowWatching: t('powerscore.machineNowWatching'),
			nowOn: t('powerscore.machineNowOn'),
			captions: t.list<string>('powerscore.machineCaptions'),
			signals: t.list<string>('powerscore.machineSignals'),
		}}
		uiStrings={uiStrings(locale)}
	/>

	<!-- Static fallback: shown before hydration, with JS off, or reduced motion -->
	<div class="machine-fallback container" data-machine-fallback>
		<div class="row g-3">
			<div class="col-md-4">
				<div class="feature-card">
					<i class="bi bi-eye feature-icon" aria-hidden="true"></i>
					<h3>{t('powerscore.machineWatch')}</h3>
					<p>{t('powerscore.machineWatchCopy')}</p>
				</div>
			</div>
			<div class="col-md-4">
				<div class="feature-card">
					<i class="bi bi-lightning-charge feature-icon" aria-hidden="true"></i>
					<h3>{t('powerscore.machineScore')}</h3>
					<p>{t('powerscore.machineScoreCopy')}</p>
				</div>
			</div>
			<div class="col-md-4">
				<div class="feature-card">
					<i class="bi bi-arrow-left-right feature-icon" aria-hidden="true"></i>
					<h3>{t('powerscore.machineSwitch')}</h3>
					<p>{t('powerscore.machineSwitchCopy')}</p>
				</div>
			</div>
		</div>
	</div>
</section>
