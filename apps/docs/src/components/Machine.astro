---
import MachineScene from './MachineScene.tsx';
import { currentLocale, useTranslations } from '../i18n/ui';

const t = useTranslations(currentLocale(Astro.currentLocale));
---
<section id="machine" class="machine-section">
	<noscript>
		<style>
			.machine-viewport { display: none !important; }
			.machine-fallback { display: block !important; }
		</style>
	</noscript>

	<div class="container machine-header reveal">
		<h2 class="section-title mb-5">{t('powerscore.machineHeading')}</h2>
		<p class="section-sub mx-auto">{t('powerscore.machineSub')}</p>
	</div>

	<!-- Auto-playing ECharts + SVG explainer (hydrates on view) -->
	<MachineScene
		client:visible
		strings={{
			alt: t('powerscore.machineAlt'),
			nowWatching: t('powerscore.machineNowWatching'),
			nowOn: t('powerscore.machineNowOn'),
			captions: t.list<string>('powerscore.machineCaptions'),
			signals: t.list<string>('powerscore.machineSignals'),
			powerScore: t('ui.gameCard.powerScore'),
		}}
	/>

	<!-- Static fallback: shown before hydration, with JS off, or reduced motion -->
	<div class="machine-fallback container" data-machine-fallback>
		<div class="row g-7">
			<div class="md:col-4">
				<div class="feature-card">
					<i class="bi bi-eye-fill feature-icon"></i>
					<h3 class="h5">{t('powerscore.machineWatch')}</h3>
					<p class="section-sub mb-0" style="font-size:0.95rem;">{t('powerscore.machineWatchCopy')}</p>
				</div>
			</div>
			<div class="md:col-4">
				<div class="feature-card">
					<i class="bi bi-lightning-fill feature-icon"></i>
					<h3 class="h5">{t('powerscore.machineScore')}</h3>
					<p class="section-sub mb-0" style="font-size:0.95rem;">{t('powerscore.machineScoreCopy')}</p>
				</div>
			</div>
			<div class="md:col-4">
				<div class="feature-card">
					<i class="bi bi-arrow-left-right feature-icon"></i>
					<h3 class="h5">{t('powerscore.machineSwitch')}</h3>
					<p class="section-sub mb-0" style="font-size:0.95rem;">{t('powerscore.machineSwitchCopy')}</p>
				</div>
			</div>
		</div>
	</div>
</section>
