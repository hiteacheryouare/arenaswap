---
import { Image } from 'astro:assets';
import logoImg from '../assets/full_logo_white_on_transparent.svg';
---
<header id="site-header" class="site-header">
	<nav class="site-nav">
		<div class="container">
			<div class="nav-row">

				<a class="nav-logo" href="/arenaswap/">
					<Image src={logoImg} alt="ArenaSwap" loading="eager" />
				</a>

				<ul class="nav-desktop-links">
					<li><a href="/arenaswap/powerscore/">PowerScore</a></li>
					<li><a href="/arenaswap/docs/extension/">Docs</a></li>
					<li><a href="/arenaswap/releases/">Releases</a></li>
					<li><a href="/arenaswap/faq/">FAQ</a></li>
				</ul>

				<div class="nav-end">
					<a href="https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhnimajppamfeee" class="btn btn-cta nav-cta-desktop">
						<i class="bi bi-browser-chrome me-2"></i>Add to Chrome
					</a>
					<button class="nav-hamburger" id="nav-toggle" aria-label="Open menu" aria-expanded="false">
						<span class="ham-bar"></span>
						<span class="ham-bar"></span>
						<span class="ham-bar"></span>
					</button>
				</div>

			</div>
		</div>
	</nav>

	<div class="nav-drawer" id="nav-drawer" aria-hidden="true">
		<ul>
			<li><a href="/arenaswap/powerscore/">PowerScore</a></li>
			<li><a href="/arenaswap/docs/extension/">Docs</a></li>
			<li><a href="/arenaswap/releases/">Releases</a></li>
			<li><a href="/arenaswap/faq/">FAQ</a></li>
			<li><a href="/arenaswap/legal/">Legal notices</a></li>
		</ul>
		<div class="nav-drawer-cta">
			<a href="https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhnimajppamfeee" class="btn btn-cta d-block text-center">
				<i class="bi bi-browser-chrome me-2"></i>Add to Chrome
			</a>
		</div>
	</div>
</header>

<script>
const toggle = document.getElementById('nav-toggle');
const drawer = document.getElementById('nav-drawer');
const header = document.getElementById('site-header');

toggle?.addEventListener('click', () => {
	const open = toggle.getAttribute('aria-expanded') === 'true';
	toggle.setAttribute('aria-expanded', String(!open));
	toggle.classList.toggle('open', !open);
	drawer?.classList.toggle('open', !open);
	drawer?.setAttribute('aria-hidden', String(open));
	document.body.classList.toggle('nav-open', !open);
});

drawer?.querySelectorAll('a').forEach(a => {
	a.addEventListener('click', () => {
		toggle?.setAttribute('aria-expanded', 'false');
		toggle?.classList.remove('open');
		drawer?.classList.remove('open');
		drawer?.setAttribute('aria-hidden', 'true');
		document.body.classList.remove('nav-open');
	});
});

window.addEventListener('scroll', () => {
	header?.classList.toggle('scrolled', window.scrollY > 40);
}, { passive: true });
</script>
