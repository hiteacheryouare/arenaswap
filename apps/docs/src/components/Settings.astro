---
---
<section class="section-pad">
	<div class="container">

		<div class="row align-items-center g-5">

			<div class="col-lg-6 order-lg-1 d-flex justify-content-center reveal">
				<div class="settings-preview">
					<div class="d-flex align-items-center gap-2 mb-4">
						<i class="bi bi-gear" style="color:var(--color-primary);font-size:1rem;"></i>
						<span style="font-size:0.8rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-muted);">Settings</span>
					</div>

					<div class="settings-row">
						<span class="label">Sensitivity</span>
						<div class="sensitivity-dots">
							<div class="dot active"></div>
							<div class="dot active"></div>
							<div class="dot active"></div>
							<div class="dot active"></div>
							<div class="dot"></div>
							<div class="dot"></div>
							<div class="dot"></div>
						</div>
					</div>

					<div class="settings-row">
						<span class="label">Switch Cooldown</span>
						<span class="value">45s</span>
					</div>

					<div class="settings-row">
						<span class="label">Switch Delay</span>
						<span class="value">Off</span>
					</div>

					<div class="settings-row">
						<span class="label">Favorite Team Bonus</span>
						<span class="value">+10 pts</span>
					</div>

					<div class="settings-row" style="flex-direction:column;align-items:flex-start;gap:0.5rem;">
						<span class="label">Active Leagues</span>
						<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
							{['NBA','NFL','NHL','MLB','MLS'].map(l => (
								<span style="font-size:0.7rem;font-weight:600;padding:2px 8px;background:rgba(247,92,3,0.1);color:#F75C03;border-radius:999px;">{l}</span>
							))}
							{['WNBA'].map(l => (
								<span style="font-size:0.7rem;font-weight:600;padding:2px 8px;background:var(--color-border);color:var(--color-muted);border-radius:999px;">{l}</span>
							))}
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-6 order-lg-0 reveal reveal-delay-1">
				<h2 class="section-title mb-4">
					Tuned in to you.
				</h2>
				<p class="section-sub mb-4">
					Sensitivity too high? Slow it down. Want to keep watching your team even
					when the other game heats up? Add a bonus. ArenaSwap works however you need it to.
				</p>
				<ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.75rem;">
					{[
						['bi-sliders', 'Sensitivity (1–7)', 'How large a score gap needs to be before ArenaSwap switches.'],
						['bi-clock', 'Switch Cooldown', 'Minimum time between switches — stops rapid tab-flipping.'],
						['bi-hourglass-split', 'Switch Delay', 'Wait before switching — useful when streams lag behind live data.'],
						['bi-star', 'Favorite Team Bonus', 'Extra points for games involving teams you care about.'],
					].map(([icon, label, desc]) => (
						<li style="display:flex;gap:0.75rem;align-items:flex-start;">
							<i class={`bi ${icon}`} style="color:var(--color-primary);font-size:1rem;margin-top:2px;flex-shrink:0;"></i>
							<div>
								<span style="font-weight:600;font-size:0.9rem;color:var(--color-text);">{label}</span>
								<p style="font-size:0.82rem;color:var(--color-muted);margin:0;line-height:1.5;">{desc}</p>
							</div>
						</li>
					))}
				</ul>
			</div>

		</div>
	</div>
</section>
