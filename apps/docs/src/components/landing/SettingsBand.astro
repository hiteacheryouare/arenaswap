---
import {
	defaultCooldownSecs,
	defaultFavoriteTeamBonusPoints,
	defaultPostseasonBoostPoints,
	defaultSensitivity,
	defaultSwitchDelaySecs,
	sensitivityThresholds,
} from '@arenaswap/core/constants';
import { currentLocale, useTranslations } from '../../i18n/ui';

// Individual settings rather than the six groups they live in: a group name tells you where a
// control is filed, and what people want to know is what the control does. The panel beside them
// shows the shipped defaults, imported so they cannot go stale the next time one is retuned.

interface Setting {
	name: string;
	copy: string;
}

const t = useTranslations(currentLocale(Astro.currentLocale));

const sensitivityLevels = Object.keys(sensitivityThresholds).length;
const settings = t.list<Setting>('home.settings.items');
---
<section class='band' id='settings'>
	<div class='container'>
		<div class='band-split'>
			<div>
				<h2 class='display-md'>{t('home.settings.title')}</h2>
				<p class='band-copy'>{t('home.settings.copy')}</p>

				<div class='settings-groups'>
					{settings.map(setting => (
						<div class='settings-group'>
							<h3>{setting.name.split('{levels}').join(String(sensitivityLevels))}</h3>
							<p>{setting.copy}</p>
						</div>
					))}
				</div>
			</div>

			<!-- A still of the extension's Switching group. Its labels come from the same `ui` namespace
			     the demo popups read, and its defaults are imported, so it cannot go stale. `inert`
			     rather than disabled: the controls look the way they do in the popup, and none of them
			     can be focused or changed. -->
			<div class='settings-panel-demo' inert>
				<p class='settings-panel-head'>{t('ui.setup.groupSwitching')}</p>
				<div class='settings-panel-card'>
					<div class='settings-panel-row settings-panel-range'>
						<span class='settings-panel-range-head'>
							<span>{t('ui.sensitivity.label')}</span>
							<span class='settings-value'>{t('home.settings.levelOf', { level: defaultSensitivity, levels: sensitivityLevels })}</span>
						</span>
						<input
							type='range'
							class='form-range'
							min='1'
							max={sensitivityLevels}
							value={defaultSensitivity}
							tabindex='-1'
							aria-label={t('ui.sensitivity.label')}
						/>
					</div>
					<div class='settings-panel-row'>
						<span>{t('ui.cooldown.label')}</span>
						<span class='settings-value num'>{defaultCooldownSecs}s</span>
					</div>
					<div class='settings-panel-row'>
						<span>{t('ui.switchDelay.label')}</span>
						<span class='settings-value num'>{defaultSwitchDelaySecs === 0 ? t('ui.switchDelay.off') : `${defaultSwitchDelaySecs}s`}</span>
					</div>
					<div class='settings-panel-row'>
						<span>{t('ui.favoriteTeamBonus.label')}</span>
						<span class='settings-value num'>+{defaultFavoriteTeamBonusPoints}</span>
					</div>
					<div class='settings-panel-row'>
						<span>{t('ui.postseasonBoost.label')}</span>
						<span class='settings-value num'>+{defaultPostseasonBoostPoints}</span>
					</div>
					<div class='settings-panel-row'>
						<span>{t('ui.setup.switchNotifications')}</span>
						<span class='form-check form-switch'>
							<input class='form-check-input' type='checkbox' role='switch' checked tabindex='-1' aria-label={t('ui.setup.switchNotifications')} />
						</span>
					</div>
					<div class='settings-panel-row'>
						<span>{t('ui.setup.groupStandby')}</span>
						<span class='form-check form-switch'>
							<input class='form-check-input' type='checkbox' role='switch' tabindex='-1' aria-label={t('ui.setup.groupStandby')} />
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
