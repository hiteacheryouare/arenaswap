---
import {
	defaultCooldownSecs,
	defaultFavoriteTeamBonusPoints,
	defaultPostseasonBoostPoints,
	defaultSensitivity,
	defaultSwitchDelaySecs,
	sensitivityThresholds,
} from '@arenaswap/core/constants';
import { currentLocale, useTranslations } from '../../i18n/ui';

interface Setting {
	name: string;
	copy: string;
}

const t = useTranslations(currentLocale(Astro.currentLocale));

const sensitivityLevels = Object.keys(sensitivityThresholds).length;
const settings = t.list<Setting>('home.settings.items');
---
<section class='band' id='settings'>
	<div class='container'>
		<div class='band-head'>
			<h2 class='display-md'>{t('home.settings.title')}</h2>
			<p class='band-copy'>{t('home.settings.copy')}</p>
		</div>
		<div class='settings-layout'>
			<dl class='settings-groups'>
				{settings.map(setting => (
					<div class='settings-group'>
						<dt>{setting.name.split('{levels}').join(String(sensitivityLevels))}</dt>
						<dd>{setting.copy}</dd>
					</div>
				))}
			</dl>

			<div class='settings-panel-demo' data-bs-theme='dark'>
				<p class='settings-panel-head'>{t('ui.setup.groupSwitching')}</p>
				<div class='settings-panel-row'>
					<span>{t('ui.sensitivity.label')}</span>
					<span class='settings-dots' aria-label={t('home.settings.levelOf', { level: defaultSensitivity, levels: sensitivityLevels })}>
						{Array.from({ length: sensitivityLevels }).map((_, index) => (
							<i class={index < defaultSensitivity ? 'is-on' : ''}></i>
						))}
					</span>
				</div>
				<div class='settings-panel-row'>
					<span>{t('ui.cooldown.label')}</span>
					<span class='settings-value'>{defaultCooldownSecs}s</span>
				</div>
				<div class='settings-panel-row'>
					<span>{t('ui.switchDelay.label')}</span>
					<span class='settings-value'>{defaultSwitchDelaySecs === 0 ? t('ui.switchDelay.off') : `${defaultSwitchDelaySecs}s`}</span>
				</div>
				<div class='settings-panel-row'>
					<span>{t('ui.favoriteTeamBonus.label')}</span>
					<span class='settings-value'>+{defaultFavoriteTeamBonusPoints}</span>
				</div>
				<div class='settings-panel-row'>
					<span>{t('ui.postseasonBoost.label')}</span>
					<span class='settings-value'>+{defaultPostseasonBoostPoints}</span>
				</div>
				<div class='settings-panel-row'>
					<span>{t('ui.setup.switchNotifications')}</span>
					<span class='settings-switch is-on'></span>
				</div>
				<div class='settings-panel-row'>
					<span>{t('ui.setup.groupStandby')}</span>
					<span class='settings-switch'></span>
				</div>
			</div>
		</div>
	</div>
</section>
