---
import PopupDemo from './PopupDemo';
---
<section class='band band-quiet' id='popup'>
	<div class='container'>
		<div class='band-split'>
			<div>
				<h2 class='display-lg'>Everything you're<br>watching, in one<br>panel.</h2>
				<p class='band-copy' style='margin-top:1.35rem'>
					Assigned tabs at the top, the rest of tonight underneath, and what starts next after
					that. Every card carries the live score, the situation, and the PowerScore that
					decides where you go. <b>Nothing else to learn.</b>
				</p>
				<p class='band-copy' style='margin-top:1rem'>
					This is the popup, at the size it opens at, built from the same components the
					extension ships.
				</p>
			</div>
			<PopupDemo client:only='react' />
		</div>
	</div>
</section>
