---
import PopupDemo from './PopupDemo';
---
<section class='band band-quiet' id='popup'>
	<div class='container'>
		<div class='band-split'>
			<div>
				<h2 class='display-lg'>31 leagues.<br>One extension.</h2>
				<p class='band-copy' style='margin-top:1.35rem'>
					NBA, NFL, NHL, MLB, EPL, Champions League, MLS, all major international soccer, NCAA,
					Olympics, and more. All monitored simultaneously. Open your tabs and walk away.
				</p>
				<p class='band-copy' style='margin-top:1rem'>
					Assigned tabs at the top, the rest of tonight underneath, and what starts next after
					that. This is the popup, at the size it opens at, built from the same components the
					extension ships.
				</p>
			</div>
			<PopupDemo client:only='react' />
		</div>
	</div>
</section>
