---
import BrowserHero from '../hero/BrowserHero';
import TeamStrip from './TeamStrip.astro';

const chrome = 'https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhnimajppamfeee';
const firefox = 'https://addons.mozilla.org/addon/arenaswap/';
const edge = 'https://microsoftedge.microsoft.com/addons/detail/arenaswap/oeballpnidkinkcbjokogdgjckdjeeba';
---
<section class='band band-hero' id='hero'>
	<div class='container'>
		<div class='hero-grid'>

			<div class='hero-copy'>
				<h1 class='display-lg'>Never miss<br>the moment.</h1>

				<p class='band-lede' style='margin-top:1.35rem'>
					ArenaSwap watches every live game across 31 leagues and automatically switches your
					browser tab to the most exciting one, as fast as every 6 seconds.
				</p>

				<div class='hero-actions'>
					<a href={chrome} class='btn btn-cta'>
						<i class='bi bi-browser-chrome me-2'></i>Add to Chrome
					</a>
					<span class='hero-actions-alt'>
						Also for <a href={firefox}>Firefox</a> and <a href={edge}>Edge</a>
					</span>
				</div>

				<TeamStrip />
			</div>

			<BrowserHero client:load />

		</div>
	</div>
</section>
