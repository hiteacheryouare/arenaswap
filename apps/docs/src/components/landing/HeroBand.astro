---
import { leagueConfigs } from '@arenaswap/core/constants';
import BrowserHero from '../hero/BrowserHero';
import InstallAlternates from '../InstallAlternates.astro';
import InstallCta from '../InstallCta.astro';
import TeamStrip from './TeamStrip.astro';
import { currentLocale, useTranslations, uiStrings } from '../../i18n/ui';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const leagues = leagueConfigs.length;
---
<section class='band band-hero' id='hero'>
	<div class='container'>
		<div class='hero-grid'>

			<div class='hero-copy'>
				<h1 class='hero-title'>{t('home.hero.titleLine1')}<br>{t('home.hero.titleLine2')}</h1>

				<p class='hero-lede'>{t('home.hero.lede', { leagues })}</p>

				<div class='hero-actions'>
					<InstallCta class='btn-lg' />
					<InstallAlternates class='hero-actions-alt' />
				</div>

				<TeamStrip />
			</div>

			<BrowserHero
				client:load
				strings={uiStrings(locale)}
				copy={{
					captionSwitched: t('home.hero.captionSwitched'),
					captionWatching: t('home.hero.captionWatching'),
					replay: t('home.hero.replay'),
				}}
			/>

		</div>
	</div>
</section>
