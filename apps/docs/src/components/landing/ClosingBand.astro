---
import InstallAlternates from '../InstallAlternates.astro';
import InstallCta from '../InstallCta.astro';
import { currentLocale, useTranslations } from '../../i18n/ui';

const t = useTranslations(currentLocale(Astro.currentLocale));
---
<section class='band band-closing' id='install'>
	<div class='glow' aria-hidden='true'></div>
	<div class='container'>
		<h2 class='display-lg'>{t('home.closing.title')}</h2>
		<p class='band-lede'>{t('home.closing.copy')}</p>
		<div class='hero-actions'>
			<InstallCta />
			<InstallAlternates class='hero-actions-alt' />
		</div>
	</div>
</section>
