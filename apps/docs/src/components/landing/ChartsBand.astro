---
import DetailCharts from './DetailCharts';
---
<section class='band' id='powerscore'>
	<div class='container'>
		<div style='max-width:52ch'>
			<h2 class='display-md'>See why. Every time.</h2>
			<p class='band-copy' style='margin-top:0.85rem;max-width:58ch'>
				Five signals add up to every score. Open any game and the breakdown is there, along with
				the PowerScore trend, the score history and the margin chart.
			</p>
		</div>
		<DetailCharts client:visible />
	</div>
</section>
