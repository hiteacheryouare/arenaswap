---
import DetailCharts from './DetailCharts';
import { currentLocale, useTranslations, uiStrings } from '../../i18n/ui';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<section class='band band-centred' id='powerscore'>
	<div class='container'>
		<div class='band-head'>
			<h2 class='display-md'>{t('home.charts.title')}</h2>
			<p class='band-copy'>{t('home.charts.copy')}</p>
		</div>
		<DetailCharts client:visible strings={uiStrings(locale)} />
	</div>
</section>
