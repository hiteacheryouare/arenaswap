---
const chrome = 'https://chromewebstore.google.com/detail/arenaswap/gibojibgihombdmmfnhnimajppamfeee';
---
<section>
	<div class='container'>
		<div class='band-tail'>
			<p class='band-tail-line'>Free. No account. Nothing leaves your browser.</p>
			<div class='band-tail-actions'>
				<a href={chrome} class='btn btn-cta'>
					<i class='bi bi-browser-chrome me-2'></i>Add to Chrome
				</a>
				<span class='hero-actions-alt'>Works with any stream that runs in a browser</span>
			</div>
		</div>
	</div>
</section>
