---
import { currentLocale, useTranslations } from '../../i18n/ui';

interface Step {
	title: string;
	copy: string;
}

const t = useTranslations(currentLocale(Astro.currentLocale));
const steps = t.list<Step>('home.tabs.steps');
---
<section class='band' id='how-it-works'>
	<div class='container'>
		<div class='band-split-even'>
			<div>
				<h2 class='display-md'>{t('home.tabs.titleLine1')}<br>{t('home.tabs.titleLine2')}</h2>
				<p class='band-copy'>{t('home.tabs.copy')}</p>
			</div>
			<ol class='steps'>
				{steps.map(step => (
					<li>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>
