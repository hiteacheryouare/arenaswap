---
import StepDemos from '../steps/StepDemos';
import type { Step } from '../steps/StepDemos';
import { currentLocale, useTranslations, uiStrings } from '../../i18n/ui';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
const steps = t.list<Step>('home.tabs.steps');
---
<section class='band band-centred' id='how-it-works'>
	<div class='container'>
		<div class='band-head'>
			<h2 class='display-md'>{t('home.tabs.titleLine1')} {t('home.tabs.titleLine2')}</h2>
		</div>
		<StepDemos client:visible={{ rootMargin: '400px' }} strings={uiStrings(locale)} steps={steps} />
	</div>
</section>
