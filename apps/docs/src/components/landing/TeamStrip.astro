---
// The games in the hero are a college basketball game, an Army-Navy game and a college hockey game,
// because those are the games in the only footage that can legally be put on this page. They are
// real, and they are also not the teams most people are here for. This is the answer to the question
// those clips raise: yes, it covers your team.
//
// Crests are ESPN's, the same source the game cards pull from, and the row links to the full league
// list rather than pretending to be a filter.
//
// Ten, not twelve: the copy column is about 450px and twelve wrapped to a second row holding three
// orphans, which reads as a mistake rather than as a grid.

import { leagueConfigs } from '@arenaswap/core/constants';
import Crest from '@arenaswap/ui/src/components/crest';
import CrestSettle from '../CrestSettle.astro';
import { localePath } from '../../i18n/locales';
import { currentLocale, useTranslations } from '../../i18n/ui';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);

const espnTeam = (path: string) => `https://a.espncdn.com/i/teamlogos/${path}.png`;

// Philadelphia first, which is where this is built, then Boston, which is the other half of the
// footer. The rest are picked to read on a dark page as much as for being famous: the Cowboys' navy
// star and the Yankees' navy monogram are both nearly invisible on #0d1117, so neither is here.
const teams = [
	{ name: 'Philadelphia Eagles', abbr: 'PHI', logo: espnTeam('nfl/500/phi'), color: '#004C54' },
	{ name: 'Philadelphia Phillies', abbr: 'PHI', logo: espnTeam('mlb/500/phi'), color: '#E81828' },
	{ name: 'Philadelphia Flyers', abbr: 'PHI', logo: espnTeam('nhl/500/phi'), color: '#F74902' },
	{ name: 'Philadelphia 76ers', abbr: 'PHI', logo: espnTeam('nba/500/phi'), color: '#006BB6' },
	{ name: 'Boston Celtics', abbr: 'BOS', logo: espnTeam('nba/500/bos'), color: '#007A33' },
	{ name: 'Boston Red Sox', abbr: 'BOS', logo: espnTeam('mlb/500/bos'), color: '#BD3039' },
	{ name: 'Kansas City Chiefs', abbr: 'KC', logo: espnTeam('nfl/500/kc'), color: '#E31837' },
	{ name: 'Los Angeles Lakers', abbr: 'LAL', logo: espnTeam('nba/500/lal'), color: '#552583' },
	{ name: 'Arsenal', abbr: 'ARS', logo: espnTeam('soccer/500/359'), color: '#EF0107' },
	{ name: 'Manchester City', abbr: 'MCI', logo: espnTeam('soccer/500/382'), color: '#6CABDD' },
];
---
<a class='team-strip' href={`${localePath(locale)}#leagues`}>
	<span class='team-strip-label'>{t('home.hero.teamStrip', { leagues: leagueConfigs.length })}</span>
	<span class='team-strip-logos' data-crest-settle>
		{teams.map(team => (
			<Crest logo={team.logo} abbreviation={team.abbr} label={team.name} title={team.name} teamColor={team.color} loading='eager' />
		))}
	</span>
</a>

<!-- Static markup rather than an island: this row sits directly under the hero, which is already
     hydrating a React tree, and settling ten images is not worth a second. -->
<CrestSettle />
