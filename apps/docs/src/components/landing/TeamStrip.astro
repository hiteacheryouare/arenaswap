---
import { leagueConfigs } from '@arenaswap/core/constants';
import Crest from '@arenaswap/ui/src/components/crest';
import CrestSettle from '../CrestSettle.astro';
import { localePath } from '../../i18n/locales';
import { currentLocale, useTranslations } from '../../i18n/ui';
import { espnTeamLogo } from '../teamLogo';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);

const teams = [
	{ name: 'Philadelphia Eagles', abbr: 'PHI', logo: espnTeamLogo('nfl/500/phi'), color: '#004C54' },
	{ name: 'Philadelphia Phillies', abbr: 'PHI', logo: espnTeamLogo('mlb/500/phi'), color: '#E81828' },
	{ name: 'Philadelphia Flyers', abbr: 'PHI', logo: espnTeamLogo('nhl/500/phi'), color: '#F74902' },
	{ name: 'Philadelphia 76ers', abbr: 'PHI', logo: espnTeamLogo('nba/500/phi'), color: '#006BB6' },
	{ name: 'Boston Celtics', abbr: 'BOS', logo: espnTeamLogo('nba/500/bos'), color: '#007A33' },
	{ name: 'Boston Red Sox', abbr: 'BOS', logo: espnTeamLogo('mlb/500/bos'), color: '#BD3039' },
	{ name: 'Kansas City Chiefs', abbr: 'KC', logo: espnTeamLogo('nfl/500/kc'), color: '#E31837' },
	{ name: 'Los Angeles Lakers', abbr: 'LAL', logo: espnTeamLogo('nba/500/lal'), color: '#552583' },
	{ name: 'Arsenal', abbr: 'ARS', logo: espnTeamLogo('soccer/500/359'), color: '#EF0107' },
	{ name: 'Manchester City', abbr: 'MCI', logo: espnTeamLogo('soccer/500/382'), color: '#6CABDD' },
];
---
<a class='team-strip' href={`${localePath(locale)}#leagues`}>
	<span class='team-strip-label'>{t('home.hero.teamStrip', { leagues: leagueConfigs.length })}</span>
	<span class='team-strip-logos' data-crest-settle>
		{teams.map(team => (
			<Crest logo={team.logo} abbreviation={team.abbr} label={team.name} title={team.name} teamColor={team.color} loading='eager' />
		))}
	</span>
</a>

<CrestSettle />
