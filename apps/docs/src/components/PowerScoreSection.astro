---
import PowerScore from './PowerScore.tsx';
---
<section id="powerscore" class="section-pad" style="background:rgba(22,27,34,0.5);">
	<div class="container">

		<div class="row align-items-start g-5">
			<div class="col-lg-5 reveal">
				<h2 class="section-title mb-4">
					The score behind the score.
				</h2>
				<p class="section-sub mb-4">
					ArenaSwap runs a live algorithm called PowerScore — a 100-point
					measure of how exciting a game is, right now.
				</p>
				<p class="section-sub" style="font-size:0.9rem;">
					Five independent signals feed into it. Games with frozen clocks —
					halftime, timeouts — take a penalty so ArenaSwap doesn't switch
					during a stoppage. Favorite team? Add a bonus.
				</p>
			</div>

			<div class="col-lg-7 reveal reveal-delay-2">
				<div style="background:var(--color-card);border:1px solid var(--color-border);border-radius:1rem;padding:2rem;">
					<PowerScore client:visible />
				</div>
			</div>
		</div>

	</div>
</section>
