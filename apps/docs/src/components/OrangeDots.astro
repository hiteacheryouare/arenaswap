---
// OrangeDots — brand flourish that paints every period in body copy ArenaSwap
// orange, mirroring the manual `.dot` treatment used in the marketing
// screenshots. It walks the static (Astro-rendered) DOM once on load and wraps
// each "." in a <span class="as-dot">.
//
// React islands (<astro-island>) are skipped on purpose: mutating DOM that React
// owns breaks reconciliation (frozen live scores, removeChild errors), so those
// components colour their own periods in JSX (see FAQ.tsx). Code, form fields,
// and graphics are skipped too — a period there isn't prose.
---
<script>
	const EXCLUDED_TAGS = new Set([
		'SCRIPT', 'STYLE', 'NOSCRIPT', 'CODE', 'PRE', 'KBD', 'SAMP',
		'TEXTAREA', 'INPUT', 'CANVAS', 'SVG', 'ASTRO-ISLAND',
	]);

	// True if the node sits inside a subtree we should leave untouched.
	function isExcluded(node: Node | null): boolean {
		let el: Element | null = node instanceof Element ? node : node?.parentElement ?? null;
		while (el) {
			if (EXCLUDED_TAGS.has(el.tagName)) return true;
			if (el.hasAttribute('data-no-dots')) return true;
			if (el.classList.contains('as-dot')) return true;
			el = el.parentElement;
		}
		return false;
	}

	// Replace a text node's periods with orange-dot spans, leaving other text intact.
	function paintDots(text: Text): void {
		const value = text.nodeValue;
		if (!value || !value.includes('.') || isExcluded(text.parentElement)) return;

		const frag = document.createDocumentFragment();
		let buffer = '';
		for (const char of value) {
			if (char === '.') {
				if (buffer) {
					frag.appendChild(document.createTextNode(buffer));
					buffer = '';
				}
				const dot = document.createElement('span');
				dot.className = 'as-dot';
				dot.textContent = '.';
				frag.appendChild(dot);
			} else {
				buffer += char;
			}
		}
		if (buffer) frag.appendChild(document.createTextNode(buffer));
		text.parentNode?.replaceChild(frag, text);
	}

	function paintAll(): void {
		if (isExcluded(document.body)) return;
		const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
			acceptNode(node) {
				return node.nodeValue?.includes('.') && !isExcluded(node.parentElement)
					? NodeFilter.FILTER_ACCEPT
					: NodeFilter.FILTER_REJECT;
			},
		});
		// Collect first so we never mutate the tree mid-walk.
		const targets: Text[] = [];
		while (walker.nextNode()) targets.push(walker.currentNode as Text);
		targets.forEach(paintDots);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', paintAll);
	} else {
		paintAll();
	}
</script>
