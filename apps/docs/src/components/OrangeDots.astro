---
// Walks the static Astro-rendered DOM once on load and wraps every sentence-ending period in body
// copy, and the ideographic full stop the Chinese and Japanese copy ends on. A period with more of
// the word straight after it is a decimal, a version or a domain ("2.2.0", "0.175"), not an ending.
// React islands are skipped on purpose: mutating DOM React owns breaks reconciliation, so those
// components colour their own periods in JSX (see MachineScene.tsx). Code, form fields and
// graphics are skipped too — a period there isn't prose.
---
<script>
	const excludedTags = new Set([
		'SCRIPT', 'STYLE', 'NOSCRIPT', 'CODE', 'PRE', 'KBD', 'SAMP',
		'TEXTAREA', 'INPUT', 'CANVAS', 'SVG', 'ASTRO-ISLAND',
	]);

	const isExcluded = (node: Node | null): boolean => {
		let el: Element | null = node instanceof Element ? node : node?.parentElement ?? null;
		while (el) {
			if (excludedTags.has(el.tagName)) return true;
			if (el.hasAttribute('data-no-dots')) return true;
			if (el.classList.contains('as-dot')) return true;
			el = el.parentElement;
		}
		return false;
	};

	const hasStop = (value: string | null): boolean => !!value && (value.includes('.') || value.includes('。'));

	const endsSentence = (char: string, next: string | undefined): boolean =>
		char === '。' || (char === '.' && (next === undefined || /[\s.)\]"'”’»]/u.test(next)));

	const paintDots = (text: Text): void => {
		const value = text.nodeValue;
		if (!hasStop(value) || isExcluded(text.parentElement)) return;

		const chars = [...value!];
		if (!chars.some((char, index) => endsSentence(char, chars[index + 1]))) return;

		const frag = document.createDocumentFragment();
		let buffer = '';
		for (const [index, char] of chars.entries()) {
			if (endsSentence(char, chars[index + 1])) {
				if (buffer) {
					frag.appendChild(document.createTextNode(buffer));
					buffer = '';
				}
				const dot = document.createElement('span');
				dot.className = 'as-dot';
				dot.textContent = char;
				frag.appendChild(dot);
			} else {
				buffer += char;
			}
		}
		if (buffer) frag.appendChild(document.createTextNode(buffer));
		text.parentNode?.replaceChild(frag, text);
	};

	const paintAll = (): void => {
		if (isExcluded(document.body)) return;
		const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
			acceptNode(node) {
				return hasStop(node.nodeValue) && !isExcluded(node.parentElement)
					? NodeFilter.FILTER_ACCEPT
					: NodeFilter.FILTER_REJECT;
			},
		});
		// Collected first, so the tree is never mutated mid-walk.
		const targets: Text[] = [];
		while (walker.nextNode()) targets.push(walker.currentNode as Text);
		targets.forEach(paintDots);
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', paintAll);
	} else {
		paintAll();
	}
</script>
