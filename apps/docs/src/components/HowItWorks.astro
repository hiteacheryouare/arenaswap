---
const steps = [
	{
		n: '01',
		icon: 'bi-window-stack',
		title: 'Open your streams.',
		body: 'Pull up your games in separate browser tabs. Any streaming service that runs in a browser works with ArenaSwap.',
	},
	{
		n: '02',
		icon: 'bi-link-45deg',
		title: 'Assign each tab.',
		body: 'Open the extension, find each game in the list, and link it to the right tab with a single dropdown.',
	},
	{
		n: '03',
		icon: 'bi-stars',
		title: 'The best game finds you.',
		body: 'ArenaSwap scores every live game and switches to the most exciting one automatically. You just watch.',
	},
];
---
<section id="how-it-works" class="section-pad">
	<div class="container">

		<div class="row mb-4 reveal">
			<div class="col-lg-7">
				<h2 class="section-title">
					Open.<br>Assign.<br>Done.
				</h2>
			</div>
		</div>

		<div class="row g-0">
			{steps.map((step, i) => (
				<div class={`col-12 step-card reveal reveal-delay-${i + 1}`}>
					<div class="row align-items-start g-4">
						<div class="col-auto">
							<span class="step-number">{step.n}</span>
						</div>
						<div class="col d-flex align-items-start gap-4 pt-3">
							<i class={`bi ${step.icon} step-icon`}></i>
							<div>
								<h3 class="step-title">{step.title}</h3>
								<p class="step-body">{step.body}</p>
							</div>
						</div>
					</div>
				</div>
			))}
		</div>

	</div>
</section>
