---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrangeDots from '../components/OrangeDots.astro';
import '../styles/tailwind.css';
import '../styles/global.scss';
import { chromeWebStore, edgeAddons, firefoxAddons } from '../lib/installTargets';
import { defaultLocale, findLocale, localePath, locales } from '../i18n/locales';
import publicImageSize from '../lib/publicImageSize';
import { currentLocale, useTranslations } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	// Path without the base and without a locale, e.g. `releases/`. Used for the canonical, the
	// og:url and every hreflang alternate.
	path?: string;
	ogTitle?: string;
	// Article, for a blog post or a release note. Anything else is a page.
	ogType?: 'website' | 'article';
	// Absolute or base-relative. Falls back to the social card, because `summary_large_image` with an
	// icon-sized image renders as a bare link.
	image?: string;
	imageAlt?: string;
	// Keeps a page out of search results. It also drops the canonical, because a noindex page
	// asserting its own canonical URL is a mixed signal.
	noindex?: boolean;
	// False only where no per-locale copy of the URL exists, which is now just the 404: GitHub Pages
	// answers every unknown path under the base with that one file, so there is nothing per-locale
	// for it to be. The language switcher offers the localized home page instead.
	localized?: boolean;
	// False where the URL exists in every locale but the words on it do not — the documentation and
	// the release notes. Those pages are built once per locale so that following a link out of a
	// translated page does not change the language of the navigation around it, but the body is the
	// same English on all twelve. So they point their canonical at the English URL and emit no
	// hreflang alternates: alternates announce translations, and there are none to announce.
	translated?: boolean;
}

const {
	title,
	description,
	path = '',
	ogTitle,
	ogType = 'website',
	image,
	imageAlt,
	noindex = false,
	localized = true,
	translated = true,
} = Astro.props;

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);

const site = Astro.site ?? new URL('https://hiteacheryouare.github.io');
const canonical = new URL(localePath(translated ? locale : defaultLocale, path), site);
const socialImagePath = image ?? `${import.meta.env.BASE_URL}images/social-card.png`;
const socialImage = new URL(socialImagePath, site);
const socialImageSize = socialImagePath.startsWith('http') ? undefined : publicImageSize(socialImagePath);

// x-default points at English, which is the copy that answers a request carrying no language
// preference and the only one guaranteed to exist for every path on the site.
const alternates = localized && translated
	? locales.map(entry => ({
			hreflang: entry.code,
			href: new URL(localePath(entry.code, path), site).href,
		}))
	: [];
---
<!doctype html>
<html lang={locale}>
<head>
	<meta charset='UTF-8' />
	<meta name='viewport' content='width=device-width, initial-scale=1.0' />
	<meta name='description' content={description} />
	<meta name='theme-color' content='#0d1117' />
	{noindex
		? <meta name='robots' content='noindex' />
		: <link rel='canonical' href={canonical.href} />}
	{!noindex && alternates.map(alternate => (
		<link rel='alternate' hreflang={alternate.hreflang} href={alternate.href} />
	))}
	{!noindex && alternates.length > 0 && (
		<link rel='alternate' hreflang='x-default' href={new URL(localePath(defaultLocale, path), site).href} />
	)}
	<meta property='og:title' content={ogTitle ?? title} />
	<meta property='og:description' content={description} />
	<meta property='og:type' content={ogType} />
	<meta property='og:url' content={canonical.href} />
	<meta property='og:site_name' content='ArenaSwap' />
	<meta property='og:locale' content={findLocale(locale).ogLocale} />
	<meta property='og:image' content={socialImage.href} />
	{socialImageSize && <meta property='og:image:width' content={String(socialImageSize.width)} />}
	{socialImageSize && <meta property='og:image:height' content={String(socialImageSize.height)} />}
	<meta property='og:image:alt' content={imageAlt ?? ogTitle ?? title} />
	<meta name='twitter:card' content='summary_large_image' />
	<meta name='twitter:image' content={socialImage.href} />
	<title>{title}</title>
	<link rel='icon' href={`${import.meta.env.BASE_URL}images/128.png`} type='image/png' sizes='128x128' />
	<link rel='apple-touch-icon' href={`${import.meta.env.BASE_URL}images/apple-touch-icon.png`} />
	<link rel='alternate' type='application/rss+xml' title={t('meta.releaseFeedTitle')} href={`${import.meta.env.BASE_URL}releases/rss.xml`} />
	<noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

	<script
		is:inline
		define:vars={{ chromeUrl: chromeWebStore, firefoxUrl: firefoxAddons, edgeUrl: edgeAddons, addToTemplate: t('install.addTo', { browser: '{browser}' }) }}
	>
			const arenaSwapInstallFork = (name, href) => ({ name, icon: 'bi-download', href });

			window.arenaSwapInstall = (() => {
				const ua = navigator.userAgent;
				const chrome  = { name: 'Chrome',  icon: 'bi-browser-chrome',  href: chromeUrl };
				const firefox = { name: 'Firefox', icon: 'bi-browser-firefox', href: firefoxUrl };
				const edge    = { name: 'Edge',    icon: 'bi-browser-edge',    href: edgeUrl };

				const detected =
					/Firefox\//.test(ua)         ? { primary: firefox,         alternates: [chrome, edge] }
					: /Edg(?:A|iOS)?\//.test(ua) ? { primary: edge,            alternates: [chrome, firefox] }
					// Chromium forks install from the Chrome Web Store, so they get its link under their own
					// name and a neutral icon — Bootstrap Icons ships no mark for any of them.
					: navigator.brave             ? { primary: arenaSwapInstallFork('Brave', chromeUrl),   alternates: [firefox, edge] }
					: /OPR\//.test(ua)           ? { primary: arenaSwapInstallFork('Opera', chromeUrl),   alternates: [firefox, edge] }
					: /Vivaldi/.test(ua)          ? { primary: arenaSwapInstallFork('Vivaldi', chromeUrl), alternates: [firefox, edge] }
					: /Chrome\//.test(ua)        ? { primary: chrome,          alternates: [firefox, edge] }
					: { primary: chrome, alternates: [firefox, edge] };

			return {
				applyCta(el) {
					if (!el) return;
					el.href = detected.primary.href;
					el.querySelector('[data-install-icon]').className = `bi ${detected.primary.icon} me-2`;
					// The browser name is a proper noun and is not translated, but the sentence around
					// it is, and in several languages the name does not come last.
					el.querySelector('[data-install-label]').textContent =
						addToTemplate.split('{browser}').join(detected.primary.name);
				},
				applyAlternates(el) {
					if (!el) return;
					el.querySelectorAll('[data-install-alternate]').forEach((link, i) => {
						link.href = detected.alternates[i].href;
						link.textContent = detected.alternates[i].name;
					});
				},
			};
		})();
	</script>
</head>
<body>
	<Nav localized={localized} />
	<main>
		<slot />
	</main>
	<Footer />
	<OrangeDots />

	<script>
		import 'bootstrap/dist/js/bootstrap.bundle.min.js';
	</script>

	<script>
		const revealElements = document.querySelectorAll('.reveal');
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) entry.target.classList.add('visible');
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
		);
		revealElements.forEach(el => observer.observe(el));
	</script>
</body>
</html>
