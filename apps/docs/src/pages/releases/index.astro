---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ReadingNav from '../../components/ReadingNav.astro';

const base = import.meta.env.BASE_URL;
const releases = (await getCollection('releases', ({ data }) => !data.draft))
	.toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// UTC on purpose: a date-only frontmatter value is midnight UTC, and rendering it in the build
// machine's zone shifts it a day west of Greenwich.
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
	month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---
<Shell
	title='Release notes — ArenaSwap'
	description="What shipped in each version of ArenaSwap, and what it means if you're using it."
	path='releases/'
>
	<div class='container'>
		<div class='page-head'>
			<h1 class='page-title'>Release notes.</h1>
			<p class='page-lede'>
				What shipped in each version, written for people using it rather than people building
				it. <a href={`${base}releases/rss.xml`}>Subscribe by RSS</a>.
			</p>
		</div>

		<div class='reading-shell'>
			<ReadingNav current='releases/' />

			<div>
				{releases.length === 0 && (
					<p class='band-copy'>Nothing published yet.</p>
				)}

				{releases.map(release => (
					<article class='release'>
						<div class='release-head'>
							<h2 class='release-version'>
								<a href={`${base}releases/${release.data.version}/`}>{release.data.version}</a>
							</h2>
							<time class='release-date' datetime={release.data.date.toISOString()}>
								{formatDate(release.data.date)}
							</time>
						</div>
						<div class='prose' style='margin-top:1rem'>
							<h3 style='margin-top:0'>{release.data.title}</h3>
							<p>{release.data.summary}</p>
							<p><a href={`${base}releases/${release.data.version}/`}>Read the full notes</a></p>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</Shell>
