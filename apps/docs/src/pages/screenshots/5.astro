---
import '../../styles/global.scss';
import './_screenshot.scss';
import { leagueConfigs } from '@arenaswap/core/constants';

const leagues = leagueConfigs.length;

const features = [
	{
		icon: 'bi-lightning-charge',
		title: 'The PowerScore algorithm',
		copy: 'Every live game gets a 0 to 100 score built from five signals: closeness, late-game pressure, momentum, lead changes and comebacks. The most exciting game is always on screen.',
	},
	{
		icon: 'bi-globe2',
		title: `${leagues} leagues`,
		copy: `NBA, NFL, NHL, MLB, MLS, the Premier League, the Champions League and ${leagues - 7} more. Turn any sport off and ArenaSwap stops watching it.`,
	},
	{
		icon: 'bi-tv',
		title: 'Standby Stream',
		copy: 'When every game goes cold (halftime everywhere, blowouts across the board), ArenaSwap parks you on the tab you picked. No more staring at dead air.',
	},
	{
		icon: 'bi-sliders',
		title: 'Built to your taste',
		copy: 'Sensitivity, cooldown, switch delay, a bonus for your favorite teams and a boost for any game. Dial it in until it switches exactly when you would.',
	},
	{
		icon: 'bi-graph-up',
		title: 'Live game charts',
		copy: 'Open any game for its PowerScore over time, the score history, win probability and a live breakdown of every signal. See exactly why ArenaSwap picked it.',
	},
	{
		icon: 'bi-shield-check',
		title: 'Private by default',
		copy: 'No account, no login, no subscription, no tracking. Scores come straight from our sources and everything else runs in your browser. Free and open source.',
	},
];
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Screenshot 5 — Packed with power</title>
</head>
<body>
	<div class='canvas'>
		<h1 class='headline'>Packed with power<span class='dot'>.</span></h1>

		<div class='features store-features'>
			{features.map(feature => (
				<div class='feature'>
					<i class={`bi ${feature.icon}`} aria-hidden='true'></i>
					<h3>{feature.title}</h3>
					<p>{feature.copy}</p>
				</div>
			))}
		</div>
	</div>
</body>
</html>
