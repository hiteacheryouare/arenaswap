---
import '../../styles/global.scss';
import './_screenshot.scss';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import iconImg from '../../assets/128.png';

const base = import.meta.env.BASE_URL;

const tabs = [
	{ title: 'Paramount+', initial: 'P', color: '#0064FF' },
	{ title: 'NBA League Pass', initial: 'N', color: '#1D428A', active: true },
	{ title: 'MLB.TV', initial: 'M', color: '#041E42' },
	{ title: 'NHL.tv', initial: 'H', color: '#111111' },
];

// The extension's own notification, word for word: `notification.switchedTitle` over
// `notification.switchedMessageWithReason`.
const title = 'Switched → CHI 65-68 PHI | ArenaSwap';
const message = 'Close late game, momentum shift. Taking you to Xfinity Mobile Arena now!';
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Screenshot 4 — Watch the magic</title>
</head>
<body>
	<div class='canvas'>
		<h1 class='headline'>Watch the magic<span class='dot'>.</span></h1>

		<div class='stage' style='width:1180px'>
			<StoreBrowser tabs={tabs} host='nba.com' path='/watch/chi-vs-phi'>
				<img src={`${base}video/basketball.jpg`} alt='' class='stream-still' />
			</StoreBrowser>
		</div>

		<div class='notif-stack'>
			<div class='notif'>
				<img src={iconImg.src} alt='' />
				<div>
					<div class='notif-row'><span>ArenaSwap</span><span>now</span></div>
					<div class='notif-title'>{title}</div>
					<div class='notif-text'>{message}</div>
				</div>
			</div>
			<div class='notif is-behind'>
				<img src={iconImg.src} alt='' />
				<div>
					<div class='notif-row'><span>ArenaSwap</span><span>2m ago</span></div>
					<div class='notif-title'>Switched → BOS 3-2 NYY | ArenaSwap</div>
				</div>
			</div>
		</div>
	</div>

	<script define:vars={{ title, message }}>
		// Fires a real system notification in the extension's format, for capturing the OS's own.
		const fireRealNotification = async () => {
			if (!('Notification' in window)) return;
			let permission = Notification.permission;
			if (permission === 'default') permission = await Notification.requestPermission();
			if (permission !== 'granted') return;
			new Notification(title, {
				body: message,
				icon: '/arenaswap/images/128.png',
				badge: '/arenaswap/images/128.png',
				tag: 'arenaswap-screenshot',
				requireInteraction: true,
			});
		};
		if ('Notification' in window && Notification.permission === 'granted') {
			fireRealNotification();
		} else if ('Notification' in window && Notification.permission === 'default') {
			document.addEventListener('click', () => { void fireRealNotification(); }, { once: true });
		}
	</script>
</body>
</html>
