---
import { Image } from 'astro:assets';
import './_screenshot.scss';
import iconImg from '../../assets/128.png';
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<title>Screenshot 4 — Watch the Magic</title>
</head>
<body>
	<div class='canvas'>
		<div class='bottom-glow'></div>

		<h1 class='headline'>Watch the Magic<span class='dot'>.</span></h1>

		<div class='over-glow'></div>

		<div class='stage' style='bottom:60px;'>
			<!-- Faded browser/desktop scene -->
			<div class='desktop-frame'>
				<div class='dim-overlay'></div>

				<div class='bg-browser'>
					<div class='bg-browser-chrome'>
						<div class='traffic'>
							<span class='dot-r'></span>
							<span class='dot-y'></span>
							<span class='dot-g'></span>
						</div>
						<div class='bg-tabs'>
							<div class='bg-tab'>
								<div class='favicon-mini' style='background:#CC0000;'>E</div>
								<span>ESPN+</span>
							</div>
							<div class='bg-tab active switching'>
								<div class='favicon-mini' style='background:#1D428A;'>N</div>
								<span>NBA League Pass</span>
							</div>
							<div class='bg-tab'>
								<div class='favicon-mini' style='background:#041E42;'>M</div>
								<span>MLB.TV</span>
							</div>
							<div class='bg-tab'>
								<div class='favicon-mini' style='background:#000;'>H</div>
								<span>NHL.tv</span>
							</div>
						</div>
					</div>

					<div class='bg-stream'>
						<div class='bg-stream-court'></div>
						<div class='live-pill-stream'>
							<span class='live-dot-stream'></span>
							LIVE · Q3
						</div>
						<div class='bg-score-bug'>
							<span class='sb-team'>CHI</span>
							<span class='sb-score'>65</span>
							<span class='sb-dash'>—</span>
							<span class='sb-score'>68</span>
							<span class='sb-team'>PHI</span>
						</div>
					</div>
				</div>

				<!-- Real-OS-style notification (matches macOS Big Sur+) -->
				<div class='notif-wrap'>
					<div class='notif'>
						<div class='notif-icon'>
							<Image src={iconImg} alt='ArenaSwap' />
						</div>
						<div class='notif-body'>
							<div class='notif-row'>
								<span class='notif-app'>ArenaSwap</span>
								<span class='notif-time'>now</span>
							</div>
							<div class='notif-title'>ArenaSwap → CHI vs PHI</div>
							<div class='notif-text'>Close late game, momentum shift. Taking you to Xfinity Mobile Arena now!</div>
						</div>
						<div class='notif-options'>
							<i class='bi bi-three-dots'></i>
						</div>
					</div>

					<div class='notif notif-back'>
						<div class='notif-icon'>
							<Image src={iconImg} alt='ArenaSwap' />
						</div>
						<div class='notif-body'>
							<div class='notif-row'>
								<span class='notif-app'>ArenaSwap</span>
								<span class='notif-time'>2m ago</span>
							</div>
							<div class='notif-title'>ArenaSwap → BOS vs NYY</div>
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>

	<script>
		// Fire an actual OS notification matching the extension's exact format.
		// Title:   `ArenaSwap → ${away.abbreviation} vs ${home.abbreviation}`
		// Message: `${reason}. Taking you to ${venueName} now!`
		// Icon:    extension icon
		const fireRealNotification = async () => {
			if (!('Notification' in window)) return;
			let permission = Notification.permission;
			if (permission === 'default') {
				permission = await Notification.requestPermission();
			}
			if (permission !== 'granted') return;

			new Notification('ArenaSwap → CHI vs PHI', {
				body: 'Close late game, momentum shift. Taking you to Xfinity Mobile Arena now!',
				icon: '/arenaswap/images/128.png',
				badge: '/arenaswap/images/128.png',
				tag: 'arenaswap-screenshot',
				requireInteraction: true,
			});
		};

		// Auto-fire on page load if permission is already granted; otherwise the
		// page just shows the rendered notification replica.
		if ('Notification' in window && Notification.permission === 'granted') {
			fireRealNotification();
		} else if ('Notification' in window && Notification.permission === 'default') {
			// One-time permission prompt on first user gesture.
			document.addEventListener('click', () => { void fireRealNotification(); }, { once: true });
		}
	</script>

	<style>
		.desktop-frame {
			position: relative;
			width: 1180px;
			height: 580px;
			border-radius: 14px;
			overflow: hidden;
			background: #1a1d23;
			box-shadow:
				0 0 0 1px rgba(255,255,255,0.1),
				0 24px 80px rgba(0,0,0,0.7);
		}

		.dim-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(135deg, rgba(0,0,0,0.2), rgba(0,0,0,0.45));
			z-index: 5;
			pointer-events: none;
		}

		.bg-browser {
			position: absolute;
			inset: 24px;
			background: #0d1117;
			border-radius: 10px;
			overflow: hidden;
			border: 1px solid #30363d;
			filter: blur(1.5px);
		}

		.bg-browser-chrome {
			background: #161b22;
			border-bottom: 1px solid #30363d;
			padding: 8px 12px 0;
			display: flex;
			align-items: flex-end;
			gap: 12px;
		}

		.traffic { display: flex; gap: 6px; padding-bottom: 10px; }
		.traffic span { width: 11px; height: 11px; border-radius: 50%; display: block; }
		.dot-r { background: #ff5f57; }
		.dot-y { background: #febc2e; }
		.dot-g { background: #28c840; }

		.bg-tabs { display: flex; gap: 4px; align-items: flex-end; flex: 1; }

		.bg-tab {
			display: flex; align-items: center; gap: 6px;
			padding: 8px 10px;
			background: transparent;
			border-radius: 8px 8px 0 0;
			min-width: 140px;
			color: #8b949e;
			font-size: 0.72rem;
			font-weight: 500;
			border-bottom: none;
		}

		.bg-tab.active {
			background: #0d1117;
			color: #e6edf3;
			border: 1px solid #30363d;
			border-bottom: none;
		}

		.bg-tab.switching {
			box-shadow: inset 0 0 0 1.5px #F75C03;
			background: rgba(247,92,3,0.08);
		}

		.favicon-mini {
			width: 14px; height: 14px; border-radius: 3px;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-size: 0.55rem; font-weight: 800;
			flex-shrink: 0;
		}

		.bg-stream {
			position: relative;
			height: calc(100% - 36px);
			background:
				linear-gradient(135deg, #6b3e1a 0%, #5d3416 30%, #4a2a10 70%, #3a200d 100%);
			overflow: hidden;
		}

		.bg-stream::before {
			content: '';
			position: absolute;
			inset: 12% 18% 18% 18%;
			border: 4px solid rgba(255,255,255,0.18);
			border-radius: 8px;
			background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.06), transparent 60%);
		}

		.bg-stream::after {
			content: '';
			position: absolute;
			top: 50%;
			left: 50%;
			width: 140px;
			height: 140px;
			border: 4px solid rgba(255,255,255,0.18);
			border-radius: 50%;
			transform: translate(-50%, -50%);
		}

		.live-pill-stream {
			position: absolute;
			top: 18px;
			left: 22px;
			display: flex;
			align-items: center;
			gap: 6px;
			background: #e53935;
			color: #fff;
			padding: 4px 10px;
			border-radius: 4px;
			font-size: 0.7rem;
			font-weight: 800;
			letter-spacing: 0.1em;
		}

		.live-dot-stream {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #fff;
			animation: popup-live-pulse 1.5s ease-in-out infinite;
		}

		.bg-score-bug {
			position: absolute;
			top: 18px;
			right: 22px;
			display: flex;
			align-items: center;
			gap: 8px;
			background: rgba(0,0,0,0.6);
			backdrop-filter: blur(8px);
			border: 1px solid rgba(255,255,255,0.1);
			padding: 6px 12px;
			border-radius: 8px;
			color: #fff;
			font-weight: 700;
		}

		.sb-team { font-size: 0.75rem; color: rgba(255,255,255,0.8); }
		.sb-score { font-size: 1rem; font-variant-numeric: tabular-nums; }
		.sb-dash { color: rgba(255,255,255,0.4); }

		.notif-wrap {
			position: absolute;
			top: 50px;
			right: 50px;
			z-index: 10;
			display: flex;
			flex-direction: column;
			gap: 8px;
			align-items: flex-end;
		}

		/* macOS Big Sur+ banner notification — matches what users actually see */
		.notif {
			width: 374px;
			background: rgba(58, 58, 64, 0.78);
			backdrop-filter: blur(28px) saturate(1.6);
			-webkit-backdrop-filter: blur(28px) saturate(1.6);
			border: 0.5px solid rgba(255,255,255,0.12);
			border-radius: 14px;
			padding: 12px 14px;
			display: grid;
			grid-template-columns: 38px 1fr auto;
			gap: 10px;
			align-items: flex-start;
			color: #fff;
			box-shadow:
				0 22px 50px rgba(0,0,0,0.55),
				0 1px 2px rgba(0,0,0,0.25),
				inset 0 0.5px 0 rgba(255,255,255,0.08);
			font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'DM Sans', system-ui, sans-serif;
		}

		.notif-back {
			width: 350px;
			margin-right: 12px;
			opacity: 0.6;
			transform: translateY(-8px) scale(0.96);
			grid-template-columns: 38px 1fr;
		}

		.notif-icon {
			width: 38px;
			height: 38px;
			border-radius: 8px;
			background: #0d1117;
			display: flex;
			align-items: center;
			justify-content: center;
			border: 0.5px solid rgba(255,255,255,0.08);
			overflow: hidden;
			align-self: center;
		}

		.notif-icon img {
			width: 30px;
			height: 30px;
			object-fit: contain;
		}

		.notif-body {
			min-width: 0;
		}

		.notif-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
		}

		.notif-app {
			font-size: 0.78rem;
			font-weight: 600;
			color: rgba(255,255,255,0.95);
			letter-spacing: -0.005em;
		}

		.notif-time {
			font-size: 0.72rem;
			color: rgba(255,255,255,0.5);
			letter-spacing: -0.005em;
		}

		.notif-title {
			font-size: 0.85rem;
			font-weight: 600;
			color: #fff;
			letter-spacing: -0.01em;
			margin-top: 1px;
		}

		.notif-text {
			font-size: 0.82rem;
			color: rgba(255,255,255,0.92);
			line-height: 1.32;
			margin-top: 2px;
			letter-spacing: -0.005em;
		}

		.notif-options {
			color: rgba(255,255,255,0.55);
			font-size: 0.95rem;
			align-self: center;
			padding: 0 2px;
		}

	</style>
</body>
</html>
