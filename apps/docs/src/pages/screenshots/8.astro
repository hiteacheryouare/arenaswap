---
import './_screenshot.scss';
import { Image } from 'astro:assets';
import ScreenshotCard from '../../components/ScreenshotCard';
import logoImg from '../../assets/full_logo_white_on_transparent.svg';

const buNuGame = {
	id: 's8-ncaam',
	league: 'ncaam',
	sportType: 'basketball',
	awayTeam: { id: '104', name: 'Boston University', abbreviation: 'BU', score: 65, logo: 'https://a.espncdn.com/i/teamlogos/ncaa/500/104.png', color: '#CC0000', alternateColor: '#FFFFFF' },
	homeTeam: { id: '111', name: 'Northeastern', abbreviation: 'NU', score: 68, logo: 'https://a.espncdn.com/i/teamlogos/ncaa/500/111.png', color: '#000000', alternateColor: '#CC0000' },
	period: 2, clockSeconds: 142, status: 'in',
	venueName: 'Matthews Arena · Boston, MA',
	broadcasts: ['ESPN'],
};
const buNuScore = { gameId: 's8-ncaam', total: 88, closeness: 28, lateGame: 26, momentum: 18, leadChanges: 14, comeback: 2, reason: '' };

const celLalGame = {
	id: 's8-nba',
	league: 'nba',
	sportType: 'basketball',
	awayTeam: { id: '2', name: 'Boston Celtics', abbreviation: 'BOS', score: 102, logo: 'https://a.espncdn.com/i/teamlogos/nba/500/2.png', color: '#007A33', alternateColor: '#BA9653' },
	homeTeam: { id: '13', name: 'Los Angeles Lakers', abbreviation: 'LAL', score: 99, logo: 'https://a.espncdn.com/i/teamlogos/nba/500/13.png', color: '#552583', alternateColor: '#FDB927' },
	period: 4, clockSeconds: 195, status: 'in',
	venueName: 'Crypto.com Arena · Los Angeles, CA',
	broadcasts: ['NBA League Pass'],
};
const celLalScore = { gameId: 's8-nba', total: 81, closeness: 24, lateGame: 24, momentum: 18, leadChanges: 10, comeback: 5, reason: '' };
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Flyer 3 — Always Watch the Best Game</title>
</head>
<body>
	<div class='canvas fl-canvas'>
		<div class='bottom-glow'></div>
		<div class='over-glow'></div>

		<div class='fl-inner'>

			<Image src={logoImg} alt='ArenaSwap' class='fl-logo' />

			<h1 class='fl-headline'>Always Watch<br>the Best Game<span class='fl-dot'>.</span></h1>

			<div class='fl-demo'>
				<div class='fl-browser'>
					<div class='fl-browser-chrome'>
						<div class='fl-traffic'>
							<span class='dot-r'></span><span class='dot-y'></span><span class='dot-g'></span>
						</div>
						<div class='fl-tabs'>
							<div class='fl-tab fl-tab-active'>
								<div class='fl-fav' style='background:#CC0000'>E</div>
								<span>ESPN</span>
							</div>
							<div class='fl-tab'>
								<div class='fl-fav' style='background:#1D428A'>N</div>
								<span>NBA League Pass</span>
							</div>
						</div>
					</div>
					<div class='fl-stream'>
						<img
							src='https://upload.wikimedia.org/wikipedia/commons/thumb/3/31/Baseball_Backyard_Brawl.jpg/960px-Baseball_Backyard_Brawl.jpg'
							alt='Live game'
							class='fl-stream-img'
						/>
						<div class='fl-stream-tint'></div>
						<div class='fl-live-pill'>
							<span class='fl-live-dot'></span>LIVE · 2ND HALF
						</div>
					</div>
				</div>

				<div class='fl-popup-anchor'>
					<div class='popup'>
						<div class='popup-inner'>
							<div class='popup-header'>
								<Image src={logoImg} alt='ArenaSwap' class='popup-logo' />
								<div class='popup-header-right'>
									<div class='popup-switch'><div class='popup-switch-thumb'></div></div>
								</div>
							</div>
							<div class='popup-section-title'>Active Tabs</div>
							<div class='popup-league-label'>NCAA BASKETBALL</div>
							<ScreenshotCard game={buNuGame} excitementResult={buNuScore} tabLabel='Tab 1: ESPN' />
							<div class='popup-league-label'>NBA</div>
							<ScreenshotCard game={celLalGame} excitementResult={celLalScore} tabLabel='Tab 2: NBA League Pass' />
						</div>
					</div>
				</div>
			</div>

			<div class='fl-store-badges'>
				<img
					src='https://developer.chrome.com/static/docs/webstore/branding/image/UV4C4ybeBTsZt43U4xis.png'
					alt='Available in the Chrome Web Store'
					class='fl-store-img'
				/>
				<img
					src='https://extensionworkshop.com/assets/img/documentation/publish/get-the-addon-178x60px.dad84b42.png'
					alt='Get the Add-on for Firefox'
					class='fl-store-img'
				/>
			</div>

		</div>
	</div>

	<style>
		html, body { width: 816px !important; height: 1056px !important; }
		.fl-canvas { width: 816px !important; height: 1056px !important; }

		.fl-inner {
			position: relative;
			z-index: 2;
			width: 816px;
			height: 1056px;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: 72px 60px 56px;
		}

		.fl-logo {
			height: 36px;
			width: auto;
			margin-bottom: 32px;
		}

		.fl-headline {
			font-size: 72px;
			font-weight: 700;
			letter-spacing: -0.045em;
			line-height: 1.02;
			text-align: center;
			color: #fff;
			margin-bottom: 40px;
		}

		.fl-dot { color: #F75C03; }

		.fl-demo {
			width: 100%;
			flex: 1;
			position: relative;
			overflow: hidden;
			border-radius: 10px;
			margin-bottom: 40px;
		}

		.fl-browser {
			position: absolute;
			inset: 0;
			background: #0d1117;
			border-radius: 10px;
			overflow: hidden;
			border: 1px solid #30363d;
		}

		.fl-browser-chrome {
			background: #161b22;
			border-bottom: 1px solid #30363d;
			padding: 8px 12px 0;
			display: flex;
			align-items: flex-end;
			gap: 10px;
			height: 36px;
		}

		.fl-traffic { display: flex; gap: 5px; padding-bottom: 10px; align-items: center; }
		.fl-traffic span { width: 10px; height: 10px; border-radius: 50%; display: block; flex-shrink: 0; }
		.dot-r { background: #ff5f57; }
		.dot-y { background: #febc2e; }
		.dot-g { background: #28c840; }

		.fl-tabs { display: flex; gap: 2px; align-items: flex-end; flex: 1; min-width: 0; overflow: hidden; }

		.fl-tab {
			display: flex; align-items: center; gap: 6px;
			padding: 7px 10px;
			border-radius: 7px 7px 0 0;
			flex: 1; max-width: 180px; min-width: 0;
			color: #8b949e;
			font-size: 0.68rem;
			font-weight: 500;
			white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
		}

		.fl-tab-active {
			background: #0d1117;
			color: #e6edf3;
			border: 1px solid #30363d;
			border-bottom: none;
		}

		.fl-fav {
			width: 13px; height: 13px; border-radius: 3px;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-size: 0.5rem; font-weight: 800;
			flex-shrink: 0;
		}

		.fl-stream {
			position: relative;
			height: calc(100% - 36px);
			overflow: hidden;
		}

		.fl-stream-img {
			width: 100%; height: 100%;
			object-fit: cover;
			filter: blur(10px) saturate(1.1);
			transform: scale(1.06);
		}

		.fl-stream-tint {
			position: absolute;
			inset: 0;
			background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.5)),
			            radial-gradient(circle at 65% 55%, rgba(247,92,3,0.1), transparent 55%);
		}

		.fl-live-pill {
			position: absolute;
			top: 12px; left: 14px;
			display: flex; align-items: center; gap: 5px;
			background: #e53935;
			color: #fff;
			padding: 3px 8px;
			border-radius: 4px;
			font-size: 0.65rem;
			font-weight: 800;
			letter-spacing: 0.08em;
		}

		.fl-live-dot {
			width: 5px; height: 5px;
			border-radius: 50%; background: #fff;
			animation: popup-live-pulse 1.5s ease-in-out infinite;
		}

		.fl-popup-anchor {
			position: absolute;
			right: 12px;
			top: 8px;
			z-index: 5;
		}

		.fl-popup-anchor .popup {
			width: 270px;
			transform: scale(0.54) !important;
			transform-origin: top right;
		}

		.fl-store-badges {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-top: auto;
		}

		.fl-store-img {
			height: 48px;
			width: auto;
			display: block;
		}
	</style>
</body>
</html>
