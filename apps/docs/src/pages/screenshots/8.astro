---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import Wordmark from '@arenaswap/ui/src/components/wordmark';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const base = import.meta.env.BASE_URL;

const buNu: Game = {
	id: 'fl8-ncaab',
	league: 'ncaab',
	sportType: 'basketball',
	status: 'in',
	period: 2,
	clockSeconds: 142,
	venueName: 'Matthews Arena, Boston, MA',
	broadcasts: ['FloHoops'],
	awayTeam: team('ncaa/500/104', '104', 'BU', 'Boston University', 65, '#CC0000', '#FFFFFF'),
	homeTeam: team('ncaa/500/111', '111', 'NU', 'Northeastern', 68, '#000000', '#CC0000'),
};

const bosLal: Game = {
	id: 'fl8-nba',
	league: 'nba',
	sportType: 'basketball',
	status: 'in',
	period: 4,
	clockSeconds: 195,
	venueName: 'Crypto.com Arena, Los Angeles, CA',
	broadcasts: ['NBA League Pass'],
	awayTeam: team('nba/500/2', '2', 'BOS', 'Boston Celtics', 102, '#007A33', '#BA9653'),
	homeTeam: team('nba/500/13', '13', 'LAL', 'Los Angeles Lakers', 99, '#552583', '#FDB927'),
};

const games = [buNu, bosLal];
const scores = { [buNu.id]: 88, [bosLal.id]: 81 };
const tabNumbers = { [buNu.id]: { number: 1 }, [bosLal.id]: { number: 2 } };
const watchedId = buNu.id;
const tabs = [
	{ title: 'FloHoops', initial: 'F', color: '#CC0000', active: true },
	{ title: 'NBA League Pass', initial: 'N', color: '#1D428A' },
];
---
<!doctype html>
<html lang='en' class='is-flyer'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Flyer 3 — Always watch the best game</title>
</head>
<body>
	<div class='canvas flyer'>
		<div class='flyer-inner'>
			<Wordmark className='flyer-wordmark' />

			<h1 class='flyer-headline'>Always watch<br>the best game<span class='dot'>.</span></h1>

			<div class='flyer-demo'>
				<StoreBrowser tabs={tabs} host='flohoops.com' path='/watch/bu-vs-nu'>
					<img src={`${base}video/basketball.jpg`} alt='' class='stream-still' />
					<StoreBoard
						slot='popup'
						client:load
						id='fl8'
						games={games}
						scores={scores}
						tabs={tabNumbers}
						watchedId={watchedId}
						strings={uiStrings('en')}
					/>
				</StoreBrowser>
			</div>

			<div class='flyer-badges'>
				<img src='https://developer.chrome.com/static/docs/webstore/branding/image/UV4C4ybeBTsZt43U4xis.png' alt='Available in the Chrome Web Store' />
				<img src='https://extensionworkshop.com/assets/img/documentation/publish/get-the-addon-178x60px.dad84b42.png' alt='Get the add-on for Firefox' />
			</div>
		</div>
	</div>
</body>
</html>
