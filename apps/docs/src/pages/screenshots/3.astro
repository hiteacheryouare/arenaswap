---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const base = import.meta.env.BASE_URL;

const chiPhi: Game = {
	id: 'sc3-nba',
	league: 'nba',
	sportType: 'basketball',
	status: 'in',
	period: 3,
	clockSeconds: 284,
	venueName: 'Xfinity Mobile Arena, Philadelphia, PA',
	broadcasts: ['NBA League Pass'],
	awayTeam: team('nba/500/4', '4', 'CHI', 'Chicago Bulls', 65, '#CE1141', '#000000'),
	homeTeam: team('nba/500/20', '20', 'PHI', 'Philadelphia 76ers', 68, '#006BB6', '#ED174C'),
};

const bosNyy: Game = {
	id: 'sc3-mlb',
	league: 'mlb',
	sportType: 'baseball',
	status: 'in',
	period: 5,
	clockSeconds: 0,
	topOfInning: true,
	venueName: 'Fenway Park, Boston, MA',
	broadcasts: ['MLB.TV'],
	awayTeam: team('mlb/500/bos', 'bos', 'BOS', 'Boston Red Sox', 3, '#BD3039', '#0C2340'),
	homeTeam: team('mlb/500/nyy', 'nyy', 'NYY', 'New York Yankees', 2, '#003087', '#E4002C'),
};

const tabs = [
	{ title: 'Paramount+', initial: 'P', color: '#0064FF' },
	{ title: 'NBA League Pass', initial: 'N', color: '#1D428A', active: true },
	{ title: 'MLB.TV', initial: 'M', color: '#041E42' },
	{ title: 'NHL.tv', initial: 'H', color: '#111111' },
];

// The picker the popup opens on a game with no tab: every open tab by title, the ones already
// watching something held back.
const menu = {
	gameId: bosNyy.id,
	options: [
		{ label: 'No tab', current: true },
		{ label: 'Paramount+ (in use)', hint: 'Tab 1', disabled: true },
		{ label: 'NBA League Pass (in use)', hint: 'Tab 2', disabled: true },
		{ label: 'MLB.TV', hint: 'Tab 3', highlighted: true },
		{ label: 'NHL.tv', hint: 'Tab 4' },
	],
};
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Screenshot 3 — Assign each tab</title>
</head>
<body>
	<div class='canvas'>
		<h1 class='headline'>Assign each tab<span class='dot'>.</span></h1>

		<div class='stage' style='width:1080px'>
			<StoreBrowser tabs={tabs} host='nba.com' path='/watch/chi-vs-phi'>
				<img src={`${base}video/basketball.jpg`} alt='' class='stream-still' />
				<StoreBoard
					slot='popup'
					client:load
					id='sc3'
					games={[chiPhi, bosNyy]}
					scores={{ [chiPhi.id]: 84, [bosNyy.id]: 64 }}
					tabs={{ [chiPhi.id]: { number: 2 } }}
					watchedId={chiPhi.id}
					menu={menu}
					strings={uiStrings('en')}
				/>
			</StoreBrowser>
		</div>
	</div>
</body>
</html>
