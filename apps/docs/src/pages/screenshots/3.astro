---
import { Image } from 'astro:assets';
import './_screenshot.scss';
import ScreenshotCard from '../../components/ScreenshotCard';
import logoImg from '../../assets/full_logo_white_on_transparent.svg';

const chiPhiGame = {
	id: 'sc-nba',
	league: 'nba',
	sportType: 'basketball',
	awayTeam: { id: '4', name: 'Chicago Bulls', abbreviation: 'CHI', score: 65, logo: 'https://a.espncdn.com/i/teamlogos/nba/500/4.png', color: '#CE1141', alternateColor: '#000000' },
	homeTeam: { id: '20', name: 'Philadelphia 76ers', abbreviation: 'PHI', score: 68, logo: 'https://a.espncdn.com/i/teamlogos/nba/500/20.png', color: '#006BB6', alternateColor: '#ED174C' },
	period: 3, clockSeconds: 284, status: 'in',
	venueName: 'Wells Fargo Center · Philadelphia, PA',
	broadcasts: ['NBA League Pass'],
};
const chiPhiScore = { gameId: 'sc-nba', total: 84, closeness: 24, lateGame: 20, momentum: 20, leadChanges: 12, comeback: 8, reason: '' };

const bosNyyGame3 = {
	id: 'sc-mlb-3',
	league: 'mlb',
	sportType: 'baseball',
	awayTeam: { id: 'bos', name: 'Boston Red Sox', abbreviation: 'BOS', score: 3, logo: 'https://a.espncdn.com/i/teamlogos/mlb/500/bos.png', color: '#BD3039', alternateColor: '#0C2340' },
	homeTeam: { id: 'nyy', name: 'New York Yankees', abbreviation: 'NYY', score: 2, logo: 'https://a.espncdn.com/i/teamlogos/mlb/500/nyy.png', color: '#003087', alternateColor: '#E4002C' },
	period: 5, clockSeconds: 0, status: 'in',
	topOfInning: true,
	venueName: 'Fenway Park · Boston, MA',
	broadcasts: ['MLB.TV'],
};
const bosNyyScore3 = { gameId: 'sc-mlb-3', total: 71, closeness: 20, lateGame: 15, momentum: 18, leadChanges: 10, comeback: 8, reason: '' };
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Screenshot 3 — Assign Each Tab</title>
</head>
<body>
	<div class='canvas'>
		<div class='bottom-glow'></div>

		<h1 class='headline'>Assign Each Tab<span class='dot'>.</span></h1>

		<div class='over-glow'></div>

		<div class='stage' style='bottom:60px;'>
			<div class='bg-browser'>
				<div class='bg-browser-chrome'>
					<div class='traffic'>
						<span class='dot-r'></span>
						<span class='dot-y'></span>
						<span class='dot-g'></span>
					</div>
					<div class='bg-tabs'>
						<div class='bg-tab'>
							<div class='favicon-mini' style='background:#CC0000;'>E</div>
							<span>ESPN+</span>
						</div>
						<div class='bg-tab active'>
							<div class='favicon-mini' style='background:#1D428A;'>N</div>
							<span>NBA League Pass</span>
						</div>
						<div class='bg-tab'>
							<div class='favicon-mini' style='background:#041E42;'>M</div>
							<span>MLB.TV</span>
						</div>
						<div class='bg-tab'>
							<div class='favicon-mini' style='background:#000;'>H</div>
							<span>NHL.tv</span>
						</div>
					</div>
				</div>
			</div>

			<div class='popup-stage'>
				<div class='popup popup-large'>
					<div class='popup-inner'>
						<div class='popup-header'>
							<Image src={logoImg} alt='ArenaSwap' class='popup-logo' />
							<div class='popup-header-right'>
								<i class='bi bi-gear-fill' style='color:#8b949e;font-size:0.9rem;'></i>
								<div class='popup-switch'>
									<div class='popup-switch-thumb'></div>
								</div>
							</div>
						</div>

						<div class='popup-section-title'>Active Tabs</div>

						<div class='popup-league-label'>NBA</div>
						<ScreenshotCard game={chiPhiGame} excitementResult={chiPhiScore} tabLabel='Tab 2: NBA League Pass' />

						<!-- Card 2: unassigned (dropdown shown open via .dropdown-menu-fake below) -->
						<div class='popup-league-label'>MLB</div>
						<ScreenshotCard game={bosNyyGame3} excitementResult={bosNyyScore3} tabLabel='— Assign a tab —' />
					</div>
				</div>

				<div class='dropdown-menu-fake'>
					<div class='dropdown-item dropdown-item-disabled'>
						<i class='bi bi-1-circle'></i>
						<span>Tab 1: ESPN+</span>
						<span class='in-use'>(in use)</span>
					</div>
					<div class='dropdown-item dropdown-item-disabled'>
						<i class='bi bi-2-circle'></i>
						<span>Tab 2: NBA League Pass</span>
						<span class='in-use'>(in use)</span>
					</div>
					<div class='dropdown-item dropdown-item-active'>
						<i class='bi bi-3-circle-fill'></i>
						<span>Tab 5: MLB.TV</span>
						<i class='bi bi-check2 check'></i>
					</div>
					<div class='dropdown-item'>
						<i class='bi bi-4-circle'></i>
						<span>Tab 6: NHL.tv</span>
					</div>
				</div>

			</div>
		</div>
	</div>

	<style>
		.bg-browser {
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
			bottom: 0;
			width: 1080px;
			height: 540px;
			background: #0d1117;
			border-radius: 14px;
			border: 1px solid rgba(255,255,255,0.1);
			overflow: hidden;
			filter: blur(2.5px) saturate(0.85);
			opacity: 0.55;
		}

		.bg-browser-chrome {
			background: #161b22;
			padding: 10px 14px 0;
			display: flex;
			align-items: flex-end;
			gap: 12px;
		}

		.traffic { display: flex; gap: 6px; padding-bottom: 12px; }
		.traffic span { width: 11px; height: 11px; border-radius: 50%; display: block; }
		.dot-r { background: #ff5f57; }
		.dot-y { background: #febc2e; }
		.dot-g { background: #28c840; }

		.bg-tabs { display: flex; gap: 4px; align-items: flex-end; flex: 1; }

		.bg-tab {
			display: flex; align-items: center; gap: 6px;
			padding: 8px 10px;
			background: transparent;
			border-radius: 8px 8px 0 0;
			min-width: 130px;
			color: #8b949e;
			font-size: 0.7rem;
			font-weight: 500;
			border-bottom: none;
		}

		.bg-tab.active {
			background: #0d1117;
			color: #e6edf3;
			border: 1px solid #30363d;
			border-bottom: none;
		}

		.favicon-mini {
			width: 14px; height: 14px; border-radius: 3px;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-size: 0.55rem; font-weight: 800;
			flex-shrink: 0;
		}

		.popup-stage {
			position: absolute;
			left: 50%;
			bottom: 0;
			transform: translateX(-50%);
			width: 1080px;
			height: 540px;
			z-index: 5;
		}

		.popup-large {
			position: absolute;
			left: 50%;
			top: 30px;
			transform: translateX(-50%) scale(0.82);
			transform-origin: top center;
			width: 360px;
			box-shadow:
				0 0 0 1px rgba(255,255,255,0.08),
				0 32px 80px rgba(0, 0, 0, 0.7),
				0 0 80px rgba(247, 92, 3, 0.25);
		}

		.dropdown-menu-fake {
			position: absolute;
			left: calc(50% + 160px);
			top: 340px;
			width: 240px;
			background: #ffffff;
			border: 1px solid #d1d5db;
			border-radius: 8px;
			box-shadow:
				0 12px 32px rgba(0,0,0,0.4),
				0 0 0 1px rgba(0,0,0,0.04);
			padding: 6px;
			font-family: 'DM Sans', sans-serif;
			z-index: 8;
		}

		.dropdown-menu-fake::before {
			content: '';
			position: absolute;
			top: 18px;
			left: -7px;
			width: 12px;
			height: 12px;
			background: #ffffff;
			border-left: 1px solid #d1d5db;
			border-bottom: 1px solid #d1d5db;
			transform: rotate(45deg);
		}

		.dropdown-item {
			display: flex;
			align-items: center;
			gap: 8px;
			padding: 8px 10px;
			border-radius: 5px;
			font-size: 0.78rem;
			color: #1f2937;
			font-weight: 500;
		}

		.dropdown-item i.bi {
			color: #6b7280;
			font-size: 0.95rem;
			flex-shrink: 0;
		}

		.dropdown-item span {
			flex: 1;
		}

		.dropdown-item-disabled {
			color: #9ca3af;
		}

		.dropdown-item-disabled .in-use {
			font-size: 0.65rem;
			color: #d1d5db;
			font-weight: 500;
		}

		.dropdown-item-active {
			background: rgba(247,92,3,0.1);
			color: #F75C03;
			font-weight: 700;
		}

		.dropdown-item-active i.bi {
			color: #F75C03;
		}

		.check {
			color: #F75C03 !important;
			font-size: 1rem !important;
		}

	</style>
</body>
</html>
