---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const base = import.meta.env.BASE_URL;

const chiPhi: Game = {
	id: 'sc2-nba',
	league: 'nba',
	sportType: 'basketball',
	status: 'in',
	period: 3,
	clockSeconds: 284,
	venueName: 'Xfinity Mobile Arena, Philadelphia, PA',
	broadcasts: ['NBA League Pass'],
	awayTeam: team('nba/500/4', '4', 'CHI', 'Chicago Bulls', 65, '#CE1141', '#000000'),
	homeTeam: team('nba/500/20', '20', 'PHI', 'Philadelphia 76ers', 68, '#006BB6', '#ED174C'),
};

const bosNyy: Game = {
	id: 'sc2-mlb',
	league: 'mlb',
	sportType: 'baseball',
	status: 'in',
	period: 5,
	clockSeconds: 0,
	topOfInning: true,
	venueName: 'Fenway Park, Boston, MA',
	broadcasts: ['MLB.TV'],
	awayTeam: team('mlb/500/bos', 'bos', 'BOS', 'Boston Red Sox', 3, '#BD3039', '#0C2340'),
	homeTeam: team('mlb/500/nyy', 'nyy', 'NYY', 'New York Yankees', 2, '#003087', '#E4002C'),
};

const tabs = [
	{ title: 'Paramount+', initial: 'P', color: '#0064FF' },
	{ title: 'NBA League Pass', initial: 'N', color: '#1D428A', active: true },
	{ title: 'NFL+', initial: 'F', color: '#013369' },
	{ title: 'NHL.tv', initial: 'H', color: '#111111' },
	{ title: 'MLB.TV', initial: 'M', color: '#041E42' },
	{ title: 'MLS Season Pass', initial: 'M', color: '#001E62' },
	{ title: 'Peacock', initial: 'P', color: '#111111' },
];
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Screenshot 2 — Open your streams</title>
</head>
<body>
	<div class='canvas'>
		<h1 class='headline'>Open your streams<span class='dot'>.</span></h1>

		<div class='stage' style='width:1140px'>
			<StoreBrowser tabs={tabs} host='nba.com' path='/watch/chi-vs-phi'>
				<img src={`${base}video/basketball.jpg`} alt='' class='stream-still' />
				<StoreBoard
					slot='popup'
					client:load
					id='sc2'
					games={[chiPhi, bosNyy]}
					scores={{ [chiPhi.id]: 84, [bosNyy.id]: 71 }}
					tabs={{ [chiPhi.id]: { number: 2 }, [bosNyy.id]: { number: 5 } }}
					watchedId={chiPhi.id}
					strings={uiStrings('en')}
				/>
			</StoreBrowser>
		</div>
	</div>
</body>
</html>
