---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import Wordmark from '@arenaswap/ui/src/components/wordmark';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const base = import.meta.env.BASE_URL;

const kcPhi: Game = {
	id: 'fl7-nfl',
	league: 'nfl',
	sportType: 'football',
	status: 'in',
	period: 4,
	clockSeconds: 210,
	downDistance: '3rd & 4',
	fieldPosition: 'PHI 31',
	venueName: 'Lincoln Financial Field, Philadelphia, PA',
	broadcasts: ['NFL+'],
	awayTeam: team('nfl/500/kc', '12', 'KC', 'Kansas City Chiefs', 21, '#E31837', '#FFB612'),
	homeTeam: team('nfl/500/phi', '21', 'PHI', 'Philadelphia Eagles', 17, '#004C54', '#A5ACAF'),
};

const mciArs: Game = {
	id: 'fl7-epl',
	league: 'epl',
	sportType: 'soccer',
	status: 'in',
	period: 2,
	clockSeconds: 4680,
	venueName: 'Emirates Stadium, London',
	broadcasts: ['Peacock'],
	awayTeam: team('soccer/500/382', '382', 'MCI', 'Manchester City', 2, '#6CABDD', '#1C2C5B'),
	homeTeam: team('soccer/500/359', '359', 'ARS', 'Arsenal', 2, '#EF0107', '#063672'),
};

const bosTbl: Game = {
	id: 'fl7-nhl',
	league: 'nhl',
	sportType: 'hockey',
	status: 'in',
	period: 3,
	clockSeconds: 120,
	venueName: 'Amalie Arena, Tampa, FL',
	broadcasts: ['TNT'],
	awayTeam: team('nhl/500/bos', 'bos', 'BOS', 'Boston Bruins', 3, '#FFB81C', '#000000'),
	homeTeam: team('nhl/500/tb', 'tb', 'TB', 'Tampa Bay Lightning', 3, '#002868', '#FFFFFF'),
};

const games = [kcPhi, mciArs, bosTbl];
const scores = { [kcPhi.id]: 86, [mciArs.id]: 79, [bosTbl.id]: 82 };
const tabNumbers = { [kcPhi.id]: { number: 1 }, [mciArs.id]: { number: 2 }, [bosTbl.id]: { number: 3 } };
const watchedId = kcPhi.id;
const tabs = [
	{ title: 'NFL+', initial: 'F', color: '#013369', active: true },
	{ title: 'Peacock', initial: 'P', color: '#111111' },
	{ title: 'TNT', initial: 'T', color: '#1F1F1F' },
	{ title: 'MLB.TV', initial: 'M', color: '#041E42' },
];
---
<!doctype html>
<html lang='en' class='is-flyer'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Flyer 2 — Every sport, every night</title>
</head>
<body>
	<div class='canvas flyer'>
		<div class='flyer-inner'>
			<Wordmark className='flyer-wordmark' />

			<h1 class='flyer-headline'>Every sport<span class='dot'>.</span><br>Every night<span class='dot'>.</span></h1>
			<p class='flyer-sub'>ArenaSwap monitors 31 leagues simultaneously and always keeps you watching the most exciting one.</p>

			<div class='flyer-demo'>
				<StoreBrowser tabs={tabs} host='nflplus.com' path='/watch/kc-vs-phi'>
					<img src={`${base}video/football.jpg`} alt='' class='stream-still' />
					<StoreBoard
						slot='popup'
						client:load
						id='fl7'
						games={games}
						scores={scores}
						tabs={tabNumbers}
						watchedId={watchedId}
						strings={uiStrings('en')}
					/>
				</StoreBrowser>
			</div>

			<div class='flyer-features'>
				<div class='features flyer-steps'>
					<div class='feature'>
						<h3>PowerScore keeps you on the right game</h3>
						<p>A live 0 to 100 excitement score rebuilt every few seconds from closeness, momentum, late-game pressure and comebacks. You always end up on the game that's exciting.</p>
					</div>
					<div class='feature'>
						<h3>Your settings, your rules</h3>
						<p>Set a favorite team bonus, dial in sensitivity, tweak how long it waits before switching. You can also boost any game to keep it front and center.</p>
					</div>
					<div class='feature'>
						<h3>Standby Stream fills the dead air</h3>
						<p>Pick a fallback tab: a pregame show, a highlights feed, anything. When every game hits halftime or turns into a blowout, ArenaSwap switches there automatically.</p>
					</div>
				</div>
			</div>

			<div class='flyer-badges'>
				<img src='https://developer.chrome.com/static/docs/webstore/branding/image/UV4C4ybeBTsZt43U4xis.png' alt='Available in the Chrome Web Store' />
				<img src='https://extensionworkshop.com/assets/img/documentation/publish/get-the-addon-178x60px.dad84b42.png' alt='Get the add-on for Firefox' />
			</div>
		</div>
	</div>
</body>
</html>
