---
import './_screenshot.scss';
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<title>Screenshot 1 — Never Miss the Moment</title>
</head>
<body>
	<div class='canvas'>
		<div class='bottom-glow'></div>

		<h1 class='headline'>Never Miss the Moment<span class='dot'>.</span></h1>

		<div class='over-glow'></div>

		<div class='stage' style='bottom:80px;'>
			<div class='game-frame'>
				<img
					src='https://upload.wikimedia.org/wikipedia/commons/thumb/3/31/Baseball_Backyard_Brawl.jpg/960px-Baseball_Backyard_Brawl.jpg'
					alt='Live baseball game'
					class='game-img'
				/>
				<div class='game-tint'></div>
				<div class='game-corners'>
					<div class='corner-live'>
						<span class='corner-live-dot'></span>
						LIVE · BOTTOM 7TH
					</div>
					<div class='corner-score'>
						<span class='team'>WVU</span>
						<span class='score'>5</span>
						<span class='dash'>—</span>
						<span class='score'>4</span>
						<span class='team'>PITT</span>
					</div>
				</div>

				<div class='popup-overlay'>
					<div class='popup'>
						<div class='popup-inner'>
							<div class='popup-header'>
								<img src='/arenaswap/images/full_logo_white_on_transparent.png' alt='ArenaSwap' class='popup-logo' />
								<div class='popup-header-right'>
									<i class='bi bi-gear-fill' style='color:#8b949e;font-size:0.9rem;'></i>
									<div class='popup-switch'>
										<div class='popup-switch-thumb'></div>
									</div>
								</div>
							</div>

							<div class='popup-section-title'>Active Tabs</div>

							<div class='popup-league-label'>NCAA BASEBALL</div>
							<div class='popup-card' style='border-left:5px solid #FFC600;border-right:5px solid #003594;background:linear-gradient(to right,#FFC60028,#00359428),#ffffff;'>
								<div class='popup-live' style='margin-bottom:4px;'>
									<span class='popup-live-dot'></span>
									LIVE
								</div>
								<div class='popup-matchup'>
									<div class='popup-team-col'>
										<img src='https://a.espncdn.com/i/teamlogos/ncaa/500/277.png' alt='WVU' class='popup-team-logo-img' />
										<span class='popup-team-abbr'>WVU</span>
										<i class='bi bi-star' style='font-size:0.7rem;color:#6c757d;'></i>
									</div>
									<div class='popup-center-col'>
										<div class='popup-scores'>
											<span class='popup-score'>5</span>
											<span class='popup-score-sep'></span>
											<span class='popup-score'>4</span>
										</div>
										<span class='popup-period'>B 7</span>
									</div>
									<div class='popup-team-col'>
										<img src='https://a.espncdn.com/i/teamlogos/ncaa/500/221.png' alt='PITT' class='popup-team-logo-img' />
										<span class='popup-team-abbr'>PITT</span>
										<i class='bi bi-star-fill' style='font-size:0.7rem;color:#f1c40f;'></i>
									</div>
								</div>
								<div class='popup-meta'>
									<span class='popup-meta-venue'>Kendrick Family Ballpark · Morgantown, WV</span>
									<span class='popup-meta-network'>Watch: ESPN+, ACCN</span>
								</div>
								<div class='popup-ps-bar-row'>
									<span class='popup-ps-label'>PowerScore</span>
									<div class='popup-ps-track'>
										<div class='popup-ps-fill' style='width:92%;background:rgb(238,96,15);'></div>
									</div>
									<span class='popup-ps-score' style='color:rgb(238,96,15);'>92 / 100</span>
								</div>
								<div class='popup-tab-row'>
									<select class='popup-select'>
										<option>Tab 2: ESPN+</option>
									</select>
								</div>
							</div>

							<div class='popup-league-label'>MLB</div>
							<div class='popup-card' style='border-left:5px solid #BD3039;border-right:5px solid #003087;background:linear-gradient(to right,#BD303928,#00308728),#ffffff;'>
								<div class='popup-live' style='margin-bottom:4px;'>
									<span class='popup-live-dot'></span>
									LIVE
								</div>
								<div class='popup-matchup'>
									<div class='popup-team-col'>
										<img src='https://a.espncdn.com/i/teamlogos/mlb/500/bos.png' alt='BOS' class='popup-team-logo-img' />
										<span class='popup-team-abbr'>BOS</span>
										<i class='bi bi-star' style='font-size:0.7rem;color:#6c757d;'></i>
									</div>
									<div class='popup-center-col'>
										<div class='popup-scores'>
											<span class='popup-score'>3</span>
											<span class='popup-score-sep'></span>
											<span class='popup-score'>2</span>
										</div>
										<span class='popup-period'>T 5</span>
									</div>
									<div class='popup-team-col'>
										<img src='https://a.espncdn.com/i/teamlogos/mlb/500/nyy.png' alt='NYY' class='popup-team-logo-img' />
										<span class='popup-team-abbr'>NYY</span>
										<i class='bi bi-star' style='font-size:0.7rem;color:#6c757d;'></i>
									</div>
								</div>
								<div class='popup-meta'>
									<span class='popup-meta-venue'>Fenway Park · Boston, MA</span>
									<span class='popup-meta-network'>Watch: FOX</span>
								</div>
								<div class='popup-ps-bar-row'>
									<span class='popup-ps-label'>PowerScore</span>
									<div class='popup-ps-track'>
										<div class='popup-ps-fill' style='width:71%;background:rgb(216,108,48);'></div>
									</div>
									<span class='popup-ps-score' style='color:rgb(216,108,48);'>71 / 100</span>
								</div>
								<div class='popup-tab-row'>
									<select class='popup-select'>
										<option>Tab 1: FOX</option>
									</select>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<style>
		.game-frame {
			position: relative;
			width: 940px;
			height: 540px;
			border-radius: 16px;
			overflow: hidden;
			box-shadow:
				0 0 0 1px rgba(255,255,255,0.1),
				0 24px 60px rgba(0,0,0,0.6);
		}

		.game-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			filter: blur(12px) saturate(1.1);
			transform: scale(1.08);
		}

		.game-tint {
			position: absolute;
			inset: 0;
			background:
				linear-gradient(to bottom, rgba(0,0,0,0.15), rgba(0,0,0,0.45)),
				radial-gradient(circle at 70% 60%, rgba(247,92,3,0.12), transparent 60%);
		}

		.game-corners {
			position: absolute;
			top: 22px;
			left: 26px;
			display: flex;
			flex-direction: column;
			gap: 8px;
			color: #fff;
		}

		.corner-live {
			display: flex;
			align-items: center;
			gap: 8px;
			background: rgba(0,0,0,0.55);
			backdrop-filter: blur(8px);
			border: 1px solid rgba(255,255,255,0.1);
			padding: 6px 12px;
			border-radius: 999px;
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.corner-live-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: #e53935;
			animation: popup-live-pulse 1.5s ease-in-out infinite;
		}

		.corner-score {
			display: flex;
			align-items: center;
			gap: 10px;
			background: rgba(0,0,0,0.55);
			backdrop-filter: blur(8px);
			border: 1px solid rgba(255,255,255,0.1);
			padding: 8px 14px;
			border-radius: 12px;
			font-weight: 700;
			letter-spacing: -0.01em;
		}

		.corner-score .team {
			font-size: 0.85rem;
			color: rgba(255,255,255,0.8);
		}

		.corner-score .score {
			font-size: 1.3rem;
			color: #fff;
			font-variant-numeric: tabular-nums;
		}

		.corner-score .dash {
			color: rgba(255,255,255,0.4);
		}

		.popup-overlay {
			position: absolute;
			right: 26px;
			top: 26px;
		}
	</style>
</body>
</html>
