---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const wvuPitt: Game = {
	id: 'sc1-cbase',
	league: 'cbase',
	sportType: 'baseball',
	status: 'in',
	period: 7,
	clockSeconds: 0,
	topOfInning: false,
	venueName: 'Kendrick Family Ballpark, Morgantown, WV',
	broadcasts: ['ACC Network'],
	awayTeam: team('ncaa/500/277', '277', 'WVU', 'West Virginia', 5, '#FFC600', '#003594'),
	homeTeam: team('ncaa/500/221', '221', 'PITT', 'Pittsburgh', 4, '#003594', '#FFB81C'),
};

const bosNyy: Game = {
	id: 'sc1-mlb',
	league: 'mlb',
	sportType: 'baseball',
	status: 'in',
	period: 5,
	clockSeconds: 0,
	topOfInning: true,
	venueName: 'Fenway Park, Boston, MA',
	broadcasts: ['FOX'],
	awayTeam: team('mlb/500/bos', 'bos', 'BOS', 'Boston Red Sox', 3, '#BD3039', '#0C2340'),
	homeTeam: team('mlb/500/nyy', 'nyy', 'NYY', 'New York Yankees', 2, '#003087', '#E4002C'),
};

const tabs = [
	{ title: 'Red Sox at Yankees', initial: 'F', color: '#003B7A' },
	{ title: 'West Virginia at Pittsburgh', initial: 'A', color: '#013CA6', active: true },
];
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Screenshot 1 — Never miss the moment</title>
</head>
<body>
	<div class='canvas'>
		<h1 class='headline'>Never miss the moment<span class='dot'>.</span></h1>

		<div class='stage' style='width:1040px'>
			<StoreBrowser tabs={tabs} host='accnx.com'>
				<img
					src='https://upload.wikimedia.org/wikipedia/commons/thumb/3/31/Baseball_Backyard_Brawl.jpg/960px-Baseball_Backyard_Brawl.jpg'
					alt=''
					class='stream-still'
				/>
				<StoreBoard
					slot='popup'
					client:load
					id='sc1'
					games={[wvuPitt, bosNyy]}
					scores={{ [wvuPitt.id]: 92, [bosNyy.id]: 71 }}
					tabs={{ [bosNyy.id]: { number: 1 }, [wvuPitt.id]: { number: 2 } }}
					watchedId={wvuPitt.id}
					strings={uiStrings('en')}
				/>
			</StoreBrowser>
		</div>
	</div>
</body>
</html>
