---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import Wordmark from '@arenaswap/ui/src/components/wordmark';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const base = import.meta.env.BASE_URL;

const bosTor: Game = {
	id: 'fl9-nhl',
	league: 'nhl',
	sportType: 'hockey',
	status: 'in',
	period: 4,
	clockSeconds: 180,
	venueName: 'Scotiabank Arena, Toronto, ON',
	broadcasts: ['Sportsnet'],
	awayTeam: team('nhl/500/bos', 'bos', 'BOS', 'Boston Bruins', 3, '#FFB81C', '#000000'),
	homeTeam: team('nhl/500/tor', 'tor', 'TOR', 'Toronto Maple Leafs', 3, '#00205B', '#FFFFFF'),
};

const sfDal: Game = {
	id: 'fl9-nfl',
	league: 'nfl',
	sportType: 'football',
	status: 'in',
	period: 4,
	clockSeconds: 180,
	downDistance: '2nd & 7',
	fieldPosition: 'DAL 38',
	venueName: 'AT&T Stadium, Arlington, TX',
	broadcasts: ['FOX'],
	awayTeam: team('nfl/500/sf', '25', 'SF', 'San Francisco 49ers', 24, '#AA0000', '#B3995D'),
	homeTeam: team('nfl/500/dal', '6', 'DAL', 'Dallas Cowboys', 21, '#003594', '#869397'),
};

const games = [bosTor, sfDal];
const scores = { [bosTor.id]: 86, [sfDal.id]: 83 };
const tabNumbers = { [bosTor.id]: { number: 1 }, [sfDal.id]: { number: 2 } };
const watchedId = bosTor.id;
const tabs = [
	{ title: 'Sportsnet', initial: 'S', color: '#CC0000', active: true },
	{ title: 'FOX Sports', initial: 'F', color: '#013369' },
];
---
<!doctype html>
<html lang='en' class='is-flyer'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Flyer 4 — Never watch a blowout again</title>
</head>
<body>
	<div class='canvas flyer'>
		<div class='flyer-inner'>
			<Wordmark className='flyer-wordmark' />

			<h1 class='flyer-headline'>Never watch<br>a blowout again<span class='dot'>.</span></h1>

			<div class='flyer-demo'>
				<StoreBrowser tabs={tabs} host='sportsnet.ca' path='/watch/bos-vs-tor'>
					<img src={`${base}video/hockey.jpg`} alt='' class='stream-still' />
					<StoreBoard
						slot='popup'
						client:load
						id='fl9'
						games={games}
						scores={scores}
						tabs={tabNumbers}
						watchedId={watchedId}
						strings={uiStrings('en')}
					/>
				</StoreBrowser>
			</div>

			<div class='flyer-badges'>
				<img src='https://developer.chrome.com/static/docs/webstore/branding/image/UV4C4ybeBTsZt43U4xis.png' alt='Available in the Chrome Web Store' />
				<img src='https://extensionworkshop.com/assets/img/documentation/publish/get-the-addon-178x60px.dad84b42.png' alt='Get the add-on for Firefox' />
			</div>
		</div>
	</div>
</body>
</html>
