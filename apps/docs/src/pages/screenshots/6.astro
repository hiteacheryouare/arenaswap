---
import './_screenshot.scss';
import { Image } from 'astro:assets';
import ScreenshotCard from '../../components/ScreenshotCard';
import logoImg from '../../assets/full_logo_white_on_transparent.svg';

const chiPhiGame = {
	id: 'fl6-nba',
	league: 'nba',
	sportType: 'basketball',
	awayTeam: { id: '4', name: 'Chicago Bulls', abbreviation: 'CHI', score: 87, logo: 'https://a.espncdn.com/i/teamlogos/nba/500/4.png', color: '#CE1141', alternateColor: '#000000' },
	homeTeam: { id: '20', name: 'Philadelphia 76ers', abbreviation: 'PHI', score: 85, logo: 'https://a.espncdn.com/i/teamlogos/nba/500/20.png', color: '#006BB6', alternateColor: '#ED174C' },
	period: 4, clockSeconds: 68, status: 'in',
	venueName: 'Xfinity Mobile Arena · Philadelphia, PA',
	broadcasts: ['NBA League Pass'],
};
const chiPhiScore = { gameId: 'fl6-nba', total: 91, closeness: 26, lateGame: 26, momentum: 20, leadChanges: 11, comeback: 8, reason: '' };

const bosNyyGame = {
	id: 'fl6-mlb',
	league: 'mlb',
	sportType: 'baseball',
	awayTeam: { id: 'bos', name: 'Boston Red Sox', abbreviation: 'BOS', score: 3, logo: 'https://a.espncdn.com/i/teamlogos/mlb/500/bos.png', color: '#BD3039', alternateColor: '#0C2340' },
	homeTeam: { id: 'nyy', name: 'New York Yankees', abbreviation: 'NYY', score: 2, logo: 'https://a.espncdn.com/i/teamlogos/mlb/500/nyy.png', color: '#003087', alternateColor: '#E4002C' },
	period: 9, clockSeconds: 0, status: 'in',
	topOfInning: true,
	venueName: 'Fenway Park · Boston, MA',
	broadcasts: ['MLB.TV'],
};
const bosNyyScore = { gameId: 'fl6-mlb', total: 74, closeness: 22, lateGame: 20, momentum: 16, leadChanges: 10, comeback: 6, reason: '' };
---
<!doctype html>
<html lang='en'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Flyer 1 — Your New Game Day Companion</title>
</head>
<body>
	<div class='canvas fl-canvas'>
		<div class='bottom-glow'></div>
		<div class='over-glow'></div>

		<div class='fl-inner'>

			<Image src={logoImg} alt='ArenaSwap' class='fl-logo' />

			<h1 class='fl-headline'>Your New Game Day<br>Companion<span class='fl-dot'>.</span></h1>
			<p class='fl-subhead'>Think NFL RedZone &mdash; but for every sport, every league,<br>on whatever streaming service you already pay for.</p>

			<div class='fl-demo'>
				<div class='fl-browser'>
					<div class='fl-browser-chrome'>
						<div class='fl-traffic'>
							<span class='dot-r'></span><span class='dot-y'></span><span class='dot-g'></span>
						</div>
						<div class='fl-tabs'>
							<div class='fl-tab'>
								<div class='fl-fav' style='background:#CC0000'>E</div>
								<span>ESPN+</span>
							</div>
							<div class='fl-tab fl-tab-active'>
								<div class='fl-fav' style='background:#1D428A'>N</div>
								<span>NBA League Pass</span>
							</div>
							<div class='fl-tab'>
								<div class='fl-fav' style='background:#041E42'>M</div>
								<span>MLB.TV</span>
							</div>
							<div class='fl-tab'>
								<div class='fl-fav' style='background:#013369'>F</div>
								<span>NFL+</span>
							</div>
						</div>
					</div>
					<div class='fl-stream'>
						<img
							src='https://upload.wikimedia.org/wikipedia/commons/thumb/3/31/Baseball_Backyard_Brawl.jpg/960px-Baseball_Backyard_Brawl.jpg'
							alt='Baseball game'
							class='fl-stream-img'
						/>
						<div class='fl-stream-tint'></div>
						<div class='fl-live-pill'>
							<span class='fl-live-dot'></span>LIVE · BOTTOM 7TH
						</div>
					</div>
				</div>

				<div class='fl-popup-anchor'>
					<div class='popup'>
						<div class='popup-inner'>
							<div class='popup-header'>
								<Image src={logoImg} alt='ArenaSwap' class='popup-logo' />
								<div class='popup-header-right'>
									<div class='popup-switch'><div class='popup-switch-thumb'></div></div>
								</div>
							</div>
							<div class='popup-section-title'>Active Tabs</div>
							<div class='popup-league-label'>NBA</div>
							<ScreenshotCard game={chiPhiGame} excitementResult={chiPhiScore} tabLabel='Tab 2: NBA League Pass' />
							<div class='popup-league-label'>MLB</div>
							<ScreenshotCard game={bosNyyGame} excitementResult={bosNyyScore} tabLabel='Tab 3: MLB.TV' />
						</div>
					</div>
				</div>
			</div>

			<div class='fl-section-label'>HOW IT WORKS</div>
			<div class='fl-steps'>
				<div class='fl-step'>
					<div class='fl-step-num'>1</div>
					<div class='fl-step-body'>
						<div class='fl-step-title'>Open your streams</div>
						<div class='fl-step-desc'>Pull up each game in its own browser tab. ESPN+, Peacock, YouTube TV, Paramount+ — any stream in a browser works.</div>
					</div>
				</div>
				<div class='fl-step'>
					<div class='fl-step-num'>2</div>
					<div class='fl-step-body'>
						<div class='fl-step-title'>Tell it which tab is which</div>
						<div class='fl-step-desc'>Click the ArenaSwap icon, find each live game in the list, and pick its tab from the dropdown.</div>
					</div>
				</div>
				<div class='fl-step'>
					<div class='fl-step-num'>3</div>
					<div class='fl-step-body'>
						<div class='fl-step-title'>Watch the best game, automatically</div>
						<div class='fl-step-desc'>ArenaSwap handles the rest. It checks every few seconds and switches you whenever something better is happening.</div>
					</div>
				</div>
			</div>

			<div class='fl-store-badges'>
				<img
					src='https://developer.chrome.com/static/docs/webstore/branding/image/UV4C4ybeBTsZt43U4xis.png'
					alt='Available in the Chrome Web Store'
					class='fl-store-img'
				/>
				<img
					src='https://extensionworkshop.com/assets/img/documentation/publish/get-the-addon-178x60px.dad84b42.png'
					alt='Get the Add-on for Firefox'
					class='fl-store-img'
				/>
			</div>

		</div>
	</div>

	<style>
		html, body { width: 816px !important; height: 1056px !important; }
		.fl-canvas { width: 816px !important; height: 1056px !important; }

		.fl-inner {
			position: relative;
			z-index: 2;
			width: 816px;
			height: 1056px;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: 48px 60px 44px;
		}

		.fl-logo {
			height: 34px;
			width: auto;
			margin-bottom: 22px;
		}

		.fl-headline {
			font-size: 58px;
			font-weight: 700;
			letter-spacing: -0.045em;
			line-height: 1.02;
			text-align: center;
			color: #fff;
			margin-bottom: 12px;
		}

		.fl-subhead {
			font-size: 0.95rem;
			color: rgba(230,237,243,0.55);
			text-align: center;
			line-height: 1.5;
			margin-bottom: 18px;
		}

		.fl-dot { color: #F75C03; }

		.fl-demo {
			width: 100%;
			height: 320px;
			flex-shrink: 0;
			position: relative;
			margin-bottom: 20px;
			overflow: hidden;
			border-radius: 10px;
		}

		.fl-browser {
			position: absolute;
			inset: 0;
			background: #0d1117;
			border-radius: 10px;
			overflow: hidden;
			border: 1px solid #30363d;
		}

		.fl-browser-chrome {
			background: #161b22;
			border-bottom: 1px solid #30363d;
			padding: 8px 12px 0;
			display: flex;
			align-items: flex-end;
			gap: 10px;
			height: 36px;
		}

		.fl-traffic { display: flex; gap: 5px; padding-bottom: 10px; align-items: center; }
		.fl-traffic span { width: 10px; height: 10px; border-radius: 50%; display: block; flex-shrink: 0; }
		.dot-r { background: #ff5f57; }
		.dot-y { background: #febc2e; }
		.dot-g { background: #28c840; }

		.fl-tabs { display: flex; gap: 2px; align-items: flex-end; flex: 1; min-width: 0; overflow: hidden; }

		.fl-tab {
			display: flex; align-items: center; gap: 6px;
			padding: 7px 10px;
			border-radius: 7px 7px 0 0;
			flex: 1; max-width: 140px; min-width: 0;
			color: #8b949e;
			font-size: 0.68rem;
			font-weight: 500;
			white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
		}

		.fl-tab-active {
			background: #0d1117;
			color: #e6edf3;
			border: 1px solid #30363d;
			border-bottom: none;
		}

		.fl-fav {
			width: 13px; height: 13px; border-radius: 3px;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-size: 0.5rem; font-weight: 800;
			flex-shrink: 0;
		}

		.fl-stream {
			position: relative;
			height: calc(100% - 36px);
			overflow: hidden;
		}

		.fl-stream-img {
			width: 100%; height: 100%;
			object-fit: cover;
			filter: blur(10px) saturate(1.1);
			transform: scale(1.06);
		}

		.fl-stream-tint {
			position: absolute;
			inset: 0;
			background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.5)),
			            radial-gradient(circle at 65% 55%, rgba(247,92,3,0.1), transparent 55%);
		}

		.fl-live-pill {
			position: absolute;
			top: 12px; left: 14px;
			display: flex; align-items: center; gap: 5px;
			background: #e53935;
			color: #fff;
			padding: 3px 8px;
			border-radius: 4px;
			font-size: 0.65rem;
			font-weight: 800;
			letter-spacing: 0.08em;
		}

		.fl-live-dot {
			width: 5px; height: 5px;
			border-radius: 50%; background: #fff;
			animation: popup-live-pulse 1.5s ease-in-out infinite;
		}

		/* Popup anchored to the right side of the demo */
		.fl-popup-anchor {
			position: absolute;
			right: 12px;
			top: 8px;
			z-index: 5;
		}

		/* Override popup scale from _screenshot.scss */
		.fl-popup-anchor .popup {
			width: 270px;
			transform: scale(0.62) !important;
			transform-origin: top right;
		}

		.fl-section-label {
			font-size: 0.65rem;
			font-weight: 700;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: #F75C03;
			margin-bottom: 12px;
			align-self: flex-start;
		}

		.fl-steps {
			display: flex;
			flex-direction: column;
			width: 100%;
			margin-bottom: 18px;
		}

		.fl-step {
			display: flex;
			align-items: flex-start;
			gap: 16px;
			padding: 10px 0;
			border-bottom: 1px solid rgba(255,255,255,0.07);
		}

		.fl-step:last-child { border-bottom: none; }

		.fl-step-num {
			width: 28px; height: 28px;
			border-radius: 50%;
			background: #F75C03;
			color: #000;
			font-size: 0.8rem; font-weight: 800;
			display: flex; align-items: center; justify-content: center;
			flex-shrink: 0; margin-top: 1px;
		}

		.fl-step-title {
			font-size: 0.9rem; font-weight: 700;
			color: #e6edf3; margin-bottom: 3px;
		}

		.fl-step-desc {
			font-size: 0.78rem;
			color: rgba(230,237,243,0.5);
			line-height: 1.5;
		}

		.fl-store-badges {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-top: auto;
		}

		.fl-store-img {
			height: 48px;
			width: auto;
			display: block;
		}
	</style>
</body>
</html>
