---
import '../../styles/global.scss';
import './_screenshot.scss';
import type { Game } from '@arenaswap/core/types';
import Wordmark from '@arenaswap/ui/src/components/wordmark';
import StoreBoard from '../../components/screenshots/StoreBoard';
import StoreBrowser from '../../components/screenshots/StoreBrowser.astro';
import { team } from '../../components/screenshots/storeTeams';
import { uiStrings } from '../../i18n/ui';

const base = import.meta.env.BASE_URL;

const chiPhi: Game = {
	id: 'fl6-nba',
	league: 'nba',
	sportType: 'basketball',
	status: 'in',
	period: 4,
	clockSeconds: 68,
	venueName: 'Xfinity Mobile Arena, Philadelphia, PA',
	broadcasts: ['NBA League Pass'],
	awayTeam: team('nba/500/4', '4', 'CHI', 'Chicago Bulls', 87, '#CE1141', '#000000'),
	homeTeam: team('nba/500/20', '20', 'PHI', 'Philadelphia 76ers', 85, '#006BB6', '#ED174C'),
};

const bosNyy: Game = {
	id: 'fl6-mlb',
	league: 'mlb',
	sportType: 'baseball',
	status: 'in',
	period: 9,
	clockSeconds: 0,
	topOfInning: true,
	venueName: 'Fenway Park, Boston, MA',
	broadcasts: ['MLB.TV'],
	awayTeam: team('mlb/500/bos', 'bos', 'BOS', 'Boston Red Sox', 3, '#BD3039', '#0C2340'),
	homeTeam: team('mlb/500/nyy', 'nyy', 'NYY', 'New York Yankees', 2, '#003087', '#E4002C'),
};

const games = [chiPhi, bosNyy];
const scores = { [chiPhi.id]: 91, [bosNyy.id]: 74 };
const tabNumbers = { [chiPhi.id]: { number: 2 }, [bosNyy.id]: { number: 3 } };
const watchedId = chiPhi.id;
const tabs = [
	{ title: 'Paramount+', initial: 'P', color: '#0064FF' },
	{ title: 'NBA League Pass', initial: 'N', color: '#1D428A', active: true },
	{ title: 'MLB.TV', initial: 'M', color: '#041E42' },
	{ title: 'NFL+', initial: 'F', color: '#013369' },
];
---
<!doctype html>
<html lang='en' class='is-flyer'>
<head>
	<meta charset='UTF-8' />
	<meta name='robots' content='noindex' />
	<title>Flyer 1 — Your new game day companion</title>
</head>
<body>
	<div class='canvas flyer'>
		<div class='flyer-inner'>
			<Wordmark className='flyer-wordmark' />

			<h1 class='flyer-headline'>Your new game day<br>companion<span class='dot'>.</span></h1>
			<p class='flyer-sub'>Think NFL RedZone, but for every sport, every league, on whatever streaming service you already pay for.</p>

			<div class='flyer-demo'>
				<StoreBrowser tabs={tabs} host='nba.com' path='/watch/chi-vs-phi'>
					<img src={`${base}video/basketball.jpg`} alt='' class='stream-still' />
					<StoreBoard
						slot='popup'
						client:load
						id='fl6'
						games={games}
						scores={scores}
						tabs={tabNumbers}
						watchedId={watchedId}
						strings={uiStrings('en')}
					/>
				</StoreBrowser>
			</div>

			<div class='flyer-features'>
				<div class='features flyer-steps'>
					<div class='feature'>
						<h3>Open your streams</h3>
						<p>Pull up each game in its own browser tab. Peacock, YouTube TV, Paramount+, any stream in a browser works.</p>
					</div>
					<div class='feature'>
						<h3>Tell it which tab is which</h3>
						<p>Click the ArenaSwap icon, find each live game in the list, and pick its tab from the dropdown.</p>
					</div>
					<div class='feature'>
						<h3>Watch the best game, automatically</h3>
						<p>ArenaSwap handles the rest. It checks every few seconds and switches you whenever something better is happening.</p>
					</div>
				</div>
			</div>

			<div class='flyer-badges'>
				<img src='https://developer.chrome.com/static/docs/webstore/branding/image/UV4C4ybeBTsZt43U4xis.png' alt='Available in the Chrome Web Store' />
				<img src='https://extensionworkshop.com/assets/img/documentation/publish/get-the-addon-178x60px.dad84b42.png' alt='Get the add-on for Firefox' />
			</div>
		</div>
	</div>
</body>
</html>
