---
import Shell from '../../layouts/Shell.astro';
import PowerScoreInstallCommands from '../../components/PowerScoreInstallCommands.tsx';
import LivePowerScores from '../../components/LivePowerScores.tsx';
import Machine from '../../components/Machine.astro';

const supportedLeagues = ['NFL', 'MLB', 'NHL', 'NBA', 'NCAAF', 'NCAAB', 'NCAAW', 'MLS', 'EPL', 'FIFAWC', 'NCAAMH', 'WNBA'];
---
<Shell
	title='PowerScore package — ArenaSwap'
	description='PowerScore turns any live game into a 0 to 100 excitement score. Install it from npm, read how the five signals work, and watch it score tonight's games live.'
	path='powerscore/'
>

		<section class='ps-hero section-pad'>
			<div class='ps-glow ps-glow-tl'></div>
			<div class='ps-glow ps-glow-tr'></div>
			<div class='ps-glow ps-glow-bl'></div>
			<div class='ps-glow ps-glow-br'></div>

			<div class='container' style='position:relative; z-index:1;'>
				<div class='row justify-content-center'>
					<div class='col-xl-9 col-lg-10 text-center'>

						<div class='ps-hero-bar'></div>

						<h1 class='ps-hero-heading'>
							<span class='ps-heading-wrap'>
								<span class='ps-gradient-text' id='ps-gradient-text'>PowerScore.</span><span
								class='ps-solid-text' id='ps-solid-text' aria-hidden='true'>PowerScore.</span>
							</span><br/>
							The score behind <span class='ps-rotating-phrase'>every <span id='ps-rotating-token' class='ps-rotating-token' aria-live='polite'>{supportedLeagues[0]}</span><span id='ps-rotating-suffix'> score.</span></span>
						</h1>

						<p class='ps-hero-sub'>
							PowerScore is the standalone package that turns any live game into a real-time excitement score from 0 to 100.
							The exact engine ArenaSwap uses to decide what game you should be watching next.
						</p>

						<div class='ps-hero-ctas d-flex flex-wrap gap-3 justify-content-center'>
							<a href='https://www.npmjs.com/package/powerscore' target='_blank' rel='noreferrer' class='btn btn-cta'>
								<i class='bi bi-box-arrow-up-right me-2'></i>View on npm
							</a>
							<a href='https://github.com/hiteacheryouare/arenaswap/tree/dev/packages/powerscore' target='_blank' rel='noreferrer' class='btn btn-outline-secondary-custom'>
								<i class='bi bi-github me-2'></i>Source on GitHub
							</a>
						</div>

					</div>
				</div>
			</div>
		</section>

		<section class='section-pad' style='background:rgba(22,27,34,0.5);'>
			<div class='container'>
				<div class='row g-4'>
					<div class='col-12 reveal'>
						<h2 class='section-title mb-3'>Install in one command</h2>
						<p class='section-sub mb-4'>
							Pick your package manager, copy the command, and drop PowerScore into your app.
						</p>
					</div>
					<div class='col-12 reveal reveal-delay-1'>
						<PowerScoreInstallCommands client:visible />
					</div>
				</div>
			</div>
		</section>

		<section class='section-pad'>
			<div class='container'>
				<div class='row g-4'>
					<div class='col-12 reveal'>
						<h2 class='section-title mb-3'>What goes into the number</h2>
						<p class='section-sub mb-4'>
							Five signals stack into a 0–100 score. Their ceilings deliberately sum past 100
							and the total is capped, so a genuinely exciting game climbs high while a blowout
							stays low. Higher score means higher drama right now.
						</p>
					</div>
					<div class='col-md-6 col-xl-4 reveal'>
						<div class='feature-card ps-signal-card-green'>
							<h3>Closeness · 30 max</h3>
							<p>How tight is the game? Tied games score highest, and closeness counts for more as the game goes on.</p>
						</div>
					</div>
					<div class='col-md-6 col-xl-4 reveal reveal-delay-1'>
						<div class='feature-card ps-signal-card-orange'>
							<h3>Late-Game Pressure · 28 max</h3>
							<p>Tension builds across the whole final period when the game is close, with a boost for tied games heading to overtime.</p>
						</div>
					</div>
					<div class='col-md-6 col-xl-4 reveal reveal-delay-2'>
						<div class='feature-card ps-signal-card-blue'>
							<h3>Momentum · 28 max</h3>
							<p>Unanswered runs spike the score, then fade over the next few minutes.</p>
						</div>
					</div>
					<div class='col-md-6 col-xl-4 reveal reveal-delay-3'>
						<div class='feature-card ps-signal-card-yellow'>
							<h3>Lead Changes · 18 max</h3>
							<p>Back-and-forth games beat one-sided games.</p>
						</div>
					</div>
					<div class='col-md-6 col-xl-4 reveal reveal-delay-4'>
						<div class='feature-card ps-signal-card-pink'>
							<h3>Comeback Factor · 14 max</h3>
							<p>If a trailing team is clawing back, the score rises.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class='ps-gradient-bar'></div>

		<section class='section-pad' style='background:rgba(22,27,34,0.5);'>
			<div class='container'>
				<div class='row g-4'>
					<div class='col-12 reveal'>
						<h2 class='section-title mb-3'>Live PowerScores right now</h2>
					</div>
					<div class='col-12 reveal reveal-delay-1'>
						<LivePowerScores client:visible />
					</div>
				</div>
			</div>
		</section>
	<Machine />

	<script>
		const revealElements = document.querySelectorAll('.reveal');
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
		);
		revealElements.forEach(el => observer.observe(el));
	</script>

	<script>
		// One full gradient cycle (0.85s delay + 6s), then a crossfade to a random brand colour.
		const psColors = ['#22c55e', '#F75C03', '#2274A5', '#F1C40F', '#D90368'];
		const chosen = psColors[Math.floor(Math.random() * psColors.length)];

		const gradientEl = document.getElementById('ps-gradient-text');
		const solidEl = document.getElementById('ps-solid-text');

		if (gradientEl && solidEl) {
			solidEl.style.color = chosen;
			setTimeout(() => {
				gradientEl.classList.add('ps-exiting');
				solidEl.style.opacity = '1';
			}, 6850);
		}
	</script>

	<script define:vars={{ supportedLeagues }}>
		const psSupportedLeagues = supportedLeagues;
		const rotatingTokenEl = document.getElementById('ps-rotating-token');
		const rotatingSuffixEl = document.getElementById('ps-rotating-suffix');
		const fadeDurationMs = 240;
		const displayDurationMs = 1200;

		if (rotatingTokenEl && rotatingSuffixEl && psSupportedLeagues.length > 0) {
			let index = 0;
			rotatingTokenEl.textContent = psSupportedLeagues[index];

			const rotate = () => {
				index += 1;

				if (index >= psSupportedLeagues.length) {
					rotatingTokenEl.classList.add('is-exiting');
					window.setTimeout(() => {
						rotatingTokenEl.textContent = 'score';
						rotatingTokenEl.classList.remove('is-exiting');
						rotatingTokenEl.classList.add('is-entering');
						rotatingSuffixEl.textContent = '.';
						window.setTimeout(() => {
							rotatingTokenEl.classList.remove('is-entering');
						}, fadeDurationMs);
					}, fadeDurationMs);
					return;
				}

				rotatingTokenEl.classList.add('is-exiting');
				window.setTimeout(() => {
					rotatingTokenEl.textContent = psSupportedLeagues[index];
					rotatingTokenEl.classList.remove('is-exiting');
					rotatingTokenEl.classList.add('is-entering');
					window.setTimeout(() => {
						rotatingTokenEl.classList.remove('is-entering');
					}, fadeDurationMs);
				}, fadeDurationMs);

				window.setTimeout(rotate, displayDurationMs + fadeDurationMs);
			};

			window.setTimeout(rotate, displayDurationMs + fadeDurationMs);
		}
	</script>
</Shell>
