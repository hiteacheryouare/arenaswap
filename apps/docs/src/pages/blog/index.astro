---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ReadingNav from '../../components/ReadingNav.astro';

// Longer pieces, kept separate from release notes now that /releases/ exists. Anything that is
// "here is what shipped" belongs there; this is for the writing that argues something.

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// UTC on purpose: a date-only frontmatter value is midnight UTC, and rendering it in the build
// machine's zone shifts it a day west of Greenwich.
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
	month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---
<Shell
	title='Writing — ArenaSwap'
	description='Longer pieces on how ArenaSwap works and why it was built the way it was.'
	path='blog/'
>
	<div class='container'>
		<div class='page-head'>
			<h1 class='page-title'>Writing.</h1>
			<p class='page-lede'>
				Longer pieces on how the thing works. If you are after what shipped in a version, that is
				in the <a href={`${base}releases/`}>release notes</a>.
			</p>
		</div>

		<div class='reading-shell'>
			<ReadingNav current='blog/' />

			<div>
				{posts.length === 0 && <p class='band-copy'>Nothing here yet.</p>}

				{posts.map(post => (
					<article class='release'>
						<div class='release-head'>
							<h2 class='release-version' style='font-size:1.35rem'>
								<a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
							</h2>
							<time class='release-date' datetime={post.data.pubDate.toISOString()}>
								{formatDate(post.data.pubDate)}
							</time>
						</div>
						<div class='prose' style='margin-top:0.9rem'>
							<p>{post.data.description}</p>
							<p><a href={`${base}blog/${post.id}/`}>Read it</a></p>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</Shell>
