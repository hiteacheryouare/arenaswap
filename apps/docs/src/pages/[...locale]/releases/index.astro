---
import Shell from '../../../layouts/Shell.astro';
import UntranslatedNotice from '../../../components/UntranslatedNotice.astro';
import { defaultLocale, localePath, localeRoutes } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';
import formatReleaseDate from '../../../lib/releaseDate';
import { getLocalizedCollection } from '../../../lib/localizedContent';

// The home of the release notes: the newest one gets the room, everything before it gets a line.
// No side nav — it used to list every version beside a page that is already a list of every
// version.

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const t = useTranslations(locale);
const releases = (await getLocalizedCollection('releases', locale))
	.toSorted((a, b) => b.original.data.date.valueOf() - a.original.data.date.valueOf());
const fullyTranslated = releases.every(release => release.translated);
const contentLang = (release: { translated: boolean }) => (release.translated ? undefined : 'en');

const [latest, ...earlier] = releases;

const formatDate = (date: Date) => formatReleaseDate(date, locale);
---
<Shell
	title={t('reading.releasesMetaTitle')}
	description={t('reading.releasesMetaDescription')}
	path='releases/'
	translated={fullyTranslated}
>
	<div class='container release-index-page'>
		<div class='page-head'>
			<h1 class='page-title'>{t('reading.releasesHeading')}</h1>
			<p class='page-lede release-feed'>
				<a href={`${localePath(defaultLocale)}releases/rss.xml`}><i class='bi bi-rss-fill me-3' aria-hidden='true'></i>{t('reading.releasesRss')}</a>
			</p>
		</div>

		{!fullyTranslated && <UntranslatedNotice />}

		<div class='release-index'>
			{!latest && <p class='page-lede'>{t('reading.releasesEmpty')}</p>}

			{latest && (
				<article class='release-latest'>
					<p class='release-meta'>
						<time datetime={latest.entry.data.date.toISOString()}>{formatDate(latest.entry.data.date)}</time>
						<span aria-hidden='true'> · </span>
						{t('reading.releaseVersion', { version: latest.entry.data.version })}
					</p>
					<h2 class='release-latest-title' lang={contentLang(latest)}>
						<a href={localePath(locale, `releases/${latest.entry.data.version}/`)}>{latest.entry.data.title}</a>
					</h2>
					<p class='release-latest-summary' lang={contentLang(latest)}>{latest.entry.data.summary}</p>
				</article>
			)}

			{earlier.length > 0 && (
				<ul class='release-list'>
					{earlier.map(release => (
						<li>
							<p class='release-meta'>
								<time datetime={release.entry.data.date.toISOString()}>{formatDate(release.entry.data.date)}</time>
								<span aria-hidden='true'> · </span>
								{t('reading.releaseVersion', { version: release.entry.data.version })}
							</p>
							<h3 lang={contentLang(release)}>
								<a href={localePath(locale, `releases/${release.entry.data.version}/`)}>{release.entry.data.title}</a>
							</h3>
							<p class='release-list-summary' lang={contentLang(release)}>{release.entry.data.summary}</p>
						</li>
					))}
				</ul>
			)}
		</div>
	</div>
</Shell>
