---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Shell from '../../../layouts/Shell.astro';
import UntranslatedNotice from '../../../components/UntranslatedNotice.astro';
import { defaultLocale, localePath, localeRoutesFor, type LocaleCode } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';
import formatReleaseDate from '../../../lib/releaseDate';
import publicImageSize from '../../../lib/publicImageSize';
import { getOriginals, localizeEntry } from '../../../lib/localizedContent';

// A release note reads like an announcement, so it is laid out like one: centred masthead, an
// optional lead image, one column of prose, and the note's own section headings pinned beside it.

export const getStaticPaths = async () => {
	const releases = (await getOriginals('releases'))
		.toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

	return localeRoutesFor(releases.map((release, index) => ({
		params: { version: release.data.version },
		props: {
			original: release,
			// Sorted newest first, so the next index is the older release.
			newer: releases[index - 1],
			older: releases[index + 1],
		},
	})));
};

interface Props {
	original: CollectionEntry<'releases'>;
	newer?: CollectionEntry<'releases'>;
	older?: CollectionEntry<'releases'>;
	locale: LocaleCode;
}

const { original, newer, older, locale } = Astro.props;
const { entry: release, translated } = await localizeEntry('releases', original, locale);
const newerTitle = newer && (await localizeEntry('releases', newer, locale));
const olderTitle = older && (await localizeEntry('releases', older, locale));
const { Content, headings } = await render(release);

// Only the note's own top-level sections. Deeper headings would turn the aside into an outline of
// an outline.
const sections = headings.filter(heading => heading.depth === 2);

const t = useTranslations(locale);
const contentLang = translated ? undefined : 'en';
const formatted = formatReleaseDate(release.data.date, locale);
const imageSize = release.data.image ? publicImageSize(release.data.image) : undefined;
---
<Shell
	title={`${release.data.title} | ArenaSwap ${release.data.version}`}
	description={release.data.summary}
	path={`releases/${release.data.version}/`}
	translated={translated}
	ogType='article'
	image={release.data.image}
	imageAlt={release.data.imageAlt}
>
	<div class='release-page'>
		<div class='container'>
			<a class='release-back' href={localePath(locale, 'releases/')}>
				<span aria-hidden='true'>←</span> {t('reading.backToReleases')}
			</a>
			{!translated && <UntranslatedNotice />}
		</div>

		<header class='release-masthead'>
			<div class='container'>
				<p class='release-meta'>
					<time datetime={release.data.date.toISOString()}>{formatted}</time>
					<span aria-hidden='true'> · </span>
					{t('reading.releaseVersion', { version: release.data.version })}
				</p>
				<h1 class='release-title' lang={contentLang}>{release.data.title}</h1>
				<p class='release-summary' lang={contentLang}>{release.data.summary}</p>

				{release.data.image && (
					<figure class='release-figure'>
						<img src={release.data.image} alt={release.data.imageAlt ?? ''} width={imageSize?.width} height={imageSize?.height} loading='eager' />
					</figure>
				)}
			</div>
		</header>

		<div class='container'>
			<div class='release-body'>
				<article class='prose' id='release-prose' lang={contentLang}>
					<Content />
				</article>

				{sections.length > 1 && (
					<aside class='release-toc' aria-label={t('reading.inThisRelease')} lang={contentLang}>
						<ul>
							{sections.map(section => (
								<li><a href={`#${section.slug}`} data-toc-link={section.slug}>{section.text}</a></li>
							))}
						</ul>
					</aside>
				)}
			</div>

			{(newerTitle || olderTitle) && (
				<nav class='release-adjacent' aria-label={t('reading.otherReleases')}>
					{olderTitle && (
						<a href={localePath(locale, `releases/${olderTitle.entry.data.version}/`)} lang={olderTitle.translated ? undefined : 'en'}>
							<span aria-hidden='true'>← </span>{olderTitle.entry.data.version}<span aria-hidden='true'> · </span>{olderTitle.entry.data.title}
						</a>
					)}
					{newerTitle && (
						<a href={localePath(locale, `releases/${newerTitle.entry.data.version}/`)} class='release-adjacent-next' lang={newerTitle.translated ? undefined : 'en'}>
							{newerTitle.entry.data.version}<span aria-hidden='true'> · </span>{newerTitle.entry.data.title}<span aria-hidden='true'> →</span>
						</a>
					)}
				</nav>
			)}
		</div>
	</div>

	<script>
		// Marks the section you are reading in the aside. Progressive: without this the list is still
		// a working set of anchors.
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
		const headings = [...links]
			.map(link => document.getElementById(link.dataset.tocLink ?? ''))
			.filter((heading): heading is HTMLElement => heading !== null);

		if (headings.length > 0) {
			const setCurrent = (slug: string) => {
				links.forEach(link => link.classList.toggle('is-current', link.dataset.tocLink === slug));
			};

			const observer = new IntersectionObserver(
				entries => {
					// The topmost heading currently in the reading band wins, so scrolling up highlights
					// the section you are moving into rather than the one you just left.
					const visible = entries
						.filter(entry => entry.isIntersecting)
						.toSorted((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

					if (visible[0]) setCurrent(visible[0].target.id);
				},
				{ rootMargin: '-25% 0px -65% 0px' }
			);

			headings.forEach(heading => observer.observe(heading));
		}
	</script>
</Shell>
