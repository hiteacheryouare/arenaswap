---
import { getCollection, render } from 'astro:content';
import Shell from '../../../../layouts/Shell.astro';
import DocsNav from '../../../../components/DocsNav.astro';
import { docPath, docSlug, docsSectionCopy, type DocsSection } from '../../../../lib/docs';
import UntranslatedNotice from '../../../../components/UntranslatedNotice.astro';
import { defaultLocale, localePath, localeRoutesFor } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/ui';

// One article, one URL per locale. Drafts are excluded from the route table, so a draft is a 404
// rather than a page nothing links to.
export const getStaticPaths = async () => {
	const pages = await getCollection('docs', ({ data }) => !data.draft);

	return localeRoutesFor(pages.map(page => ({
		params: { section: page.data.section, slug: docSlug(page) },
		props: { page },
	})));
};

const { page, locale } = Astro.props;
const { title, description, faq } = page.data;
const section = page.data.section as DocsSection;
const t = useTranslations(locale);
// The breadcrumb's structured data describes the English article, so it names the section in English.
const englishMeta = docsSectionCopy(useTranslations(defaultLocale), section);
const contentLang = locale === defaultLocale ? undefined : 'en';
const path = docPath(page);

const { Content } = await render(page);

// Previous and next inside this section only. Walking from the last extension article into the
// first PowerScore one would hand a reader documentation for a package they never asked about.
const siblings = (await getCollection('docs', ({ data }) => !data.draft && data.section === section))
	.toSorted((a, b) => a.data.order - b.data.order);
const index = siblings.findIndex(sibling => sibling.id === page.id);
const previous = siblings[index - 1];
const next = siblings[index + 1];

const site = Astro.site ?? new URL('https://hiteacheryouare.github.io');
// The structured data describes the English article, which is the copy every locale's URL carries
// and the one the canonical points at. Twelve URLs claiming to be twelve distinct articles would
// be twelve claims about the same piece of writing.
const url = new URL(localePath(defaultLocale, path), site).href;

const structuredData: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'TechArticle',
		headline: title,
		description,
		url,
		inLanguage: 'en',
		isPartOf: {
			'@type': 'WebSite',
			name: 'ArenaSwap',
			url: new URL(localePath(defaultLocale), site).href,
		},
		publisher: {
			'@type': 'Organization',
			name: 'Lattice & Company',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Documentation', item: new URL(localePath(defaultLocale, 'docs/'), site).href },
			{ '@type': 'ListItem', position: 2, name: englishMeta.title, item: new URL(localePath(defaultLocale, `docs/${section}/`), site).href },
			{ '@type': 'ListItem', position: 3, name: title, item: url },
		],
	},
];

if (faq?.length) {
	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map(item => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	});
}
---
<Shell
	title={`${title} — ArenaSwap`}
	description={description}
	path={path}
	translated={false}
	ogType='article'
>
	<div class='container'>
		<div class='page-head' lang={contentLang}>
			<h1 class='page-title docs-title'>{title}</h1>
			<p class='page-lede'>{description}</p>
		</div>

		<UntranslatedNotice />

		<div class='reading-shell'>
			<DocsNav current={path} />

			<div>
				<article class='prose' lang={contentLang}>
					<Content />
				</article>

				{faq?.length && (
					<section class='docs-faq' aria-label={t('reading.commonQuestions')} lang={contentLang}>
						<div class='faq-list'>
							{faq.map((item, position) => (
								<details class='faq-item' open={position === 0}>
									<summary>{item.q}</summary>
									<p>{item.a}</p>
								</details>
							))}
						</div>
					</section>
				)}

				{(previous || next) && (
					<nav class='docs-adjacent' aria-label={t('reading.nearbyArticles')}>
						{previous && (
							<a href={localePath(locale, docPath(previous))} lang={contentLang}>
								<span aria-hidden='true'>← </span>{previous.data.title}
							</a>
						)}
						{next && (
							<a class='docs-adjacent-next' href={localePath(locale, docPath(next))} lang={contentLang}>
								{next.data.title}<span aria-hidden='true'> →</span>
							</a>
						)}
					</nav>
				)}
			</div>
		</div>
	</div>

	{structuredData.map(data => (
		<script type='application/ld+json' set:html={JSON.stringify(data)} is:inline />
	))}
</Shell>
