---
import { render } from 'astro:content';
import Shell from '../../../../layouts/Shell.astro';
import DocsNav from '../../../../components/DocsNav.astro';
import { docPath, docSlug, docsSectionCopy, getSectionDocs, type DocsSection } from '../../../../lib/docs';
import { getOriginals, localizeEntry } from '../../../../lib/localizedContent';
import UntranslatedNotice from '../../../../components/UntranslatedNotice.astro';
import { defaultLocale, localePath, localeRoutesFor } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/ui';

// One article, one URL per locale. Drafts are excluded from the route table, so a draft is a 404
// rather than a page nothing links to. Each locale's page swaps in its translation where one exists.
export const getStaticPaths = async () => {
	const originals = await getOriginals('docs');

	return localeRoutesFor(originals.map(original => ({
		params: { section: original.data.section, slug: docSlug(original) },
		props: { original },
	})));
};

const { original, locale } = Astro.props;
const { entry: page, translated } = await localizeEntry('docs', original, locale);
const { title, description, faq } = page.data;
const section = page.data.section as DocsSection;
const t = useTranslations(locale);
// Structured data describes the copy the canonical points at: this translation, or the English.
const metaLocale = translated ? locale : defaultLocale;
const sectionMeta = docsSectionCopy(useTranslations(metaLocale), section);
const contentLang = translated ? undefined : 'en';
const path = docPath(page);

const { Content } = await render(page);

// Previous and next inside this section only. Walking from the last extension article into the
// first PowerScore one would hand a reader documentation for a package they never asked about.
const siblings = await getSectionDocs(section, locale);
const index = siblings.findIndex(sibling => sibling.original.id === original.id);
const previous = siblings[index - 1];
const next = siblings[index + 1];

const site = Astro.site ?? new URL('https://hiteacheryouare.github.io');
// An untranslated article describes the English one, which its canonical points at. Twelve URLs
// claiming to be twelve distinct articles would be twelve claims about the same piece of writing.
const url = new URL(localePath(metaLocale, path), site).href;

const structuredData: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'TechArticle',
		headline: title,
		description,
		url,
		inLanguage: metaLocale,
		isPartOf: {
			'@type': 'WebSite',
			name: 'ArenaSwap',
			url: new URL(localePath(metaLocale), site).href,
		},
		publisher: {
			'@type': 'Organization',
			name: 'Lattice & Company',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: useTranslations(metaLocale)('reading.docsNavLabel'), item: new URL(localePath(metaLocale, 'docs/'), site).href },
			{ '@type': 'ListItem', position: 2, name: sectionMeta.title, item: new URL(localePath(metaLocale, `docs/${section}/`), site).href },
			{ '@type': 'ListItem', position: 3, name: title, item: url },
		],
	},
];

if (faq?.length) {
	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map(item => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	});
}
---
<Shell
	title={`${title} | ArenaSwap`}
	description={description}
	path={path}
	translated={translated}
	ogType='article'
>
	<div class='container'>
		<div class='page-head' lang={contentLang}>
			<h1 class='page-title docs-title'>{title}</h1>
			<p class='page-lede'>{description}</p>
		</div>

		{!translated && <UntranslatedNotice />}

		<div class='reading-shell'>
			<DocsNav current={path} />

			<div>
				<article class='prose' lang={contentLang}>
					<Content />
				</article>

				{faq?.length && (
					<section class='docs-faq' aria-label={t('reading.commonQuestions')} lang={contentLang}>
						<div class='faq-list accordion'>
							{faq.map((item, position) => (
								<details class='faq-item accordion-item' open={position === 0}>
									<summary class='accordion-header'>
										{item.q}
										<svg class='accordion-icon' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m2 5 6 6 6-6' /></svg>
									</summary>
									<p class='accordion-body'>{item.a}</p>
								</details>
							))}
						</div>
					</section>
				)}

				{(previous || next) && (
					<nav class='docs-adjacent' aria-label={t('reading.nearbyArticles')}>
						{previous && (
							<a href={localePath(locale, docPath(previous.entry))} lang={previous.translated ? undefined : 'en'}>
								<span aria-hidden='true'>← </span>{previous.entry.data.title}
							</a>
						)}
						{next && (
							<a class='docs-adjacent-next' href={localePath(locale, docPath(next.entry))} lang={next.translated ? undefined : 'en'}>
								{next.entry.data.title}<span aria-hidden='true'> →</span>
							</a>
						)}
					</nav>
				)}
			</div>
		</div>
	</div>

	{structuredData.map(data => (
		<script type='application/ld+json' set:html={JSON.stringify(data)} is:inline />
	))}
</Shell>
