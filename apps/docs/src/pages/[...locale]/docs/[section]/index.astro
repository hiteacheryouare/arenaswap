---
import Shell from '../../../../layouts/Shell.astro';
import DocsNav from '../../../../components/DocsNav.astro';
import { docPath, docsSectionCopy, getSectionDocs, type DocsSection } from '../../../../lib/docs';
import UntranslatedNotice from '../../../../components/UntranslatedNotice.astro';
import { defaultLocale, localePath, localeRoutesFor } from '../../../../i18n/locales';
import { useTranslations } from '../../../../i18n/ui';

// Written out rather than derived from docsSectionOrder: Astro hoists getStaticPaths into its own
// module, so it cannot see the component scope.
export const getStaticPaths = () =>
	localeRoutesFor([
		{ params: { section: 'extension' }, props: {} },
		{ params: { section: 'powerscore' }, props: {} },
	]);

const { locale } = Astro.props;
const section = Astro.params.section as DocsSection;
const t = useTranslations(locale);
const meta = docsSectionCopy(t, section);
const contentLang = locale === defaultLocale ? undefined : 'en';

const pages = await getSectionDocs(section);
---
<Shell
	title={t('reading.docsSectionMetaTitle', { heading: meta.heading })}
	description={meta.description}
	path={`docs/${section}/`}
	translated={false}
>
	<div class='container'>
		<div class='page-head'>
			<h1 class='page-title'>{t('reading.docsSectionHeading', { heading: meta.heading })}</h1>
			<p class='page-lede'>{meta.description}</p>
		</div>

		<UntranslatedNotice />

		<div class='reading-shell'>
			<DocsNav current={`docs/${section}/`} />

			<div>
				{pages.length === 0 ? (
					<div class='prose' lang={contentLang}>
						<p>
							This section is being written. In the meantime, the
							<a href={localePath(locale, 'faq/')}>FAQ</a> answers most of what people ask and the
							<a href={localePath(locale, 'releases/')}>release notes</a> cover what changed.
						</p>
					</div>
				) : (
					<ul class='docs-index' lang={contentLang}>
						{pages.map(page => (
							<li>
								<h2><a href={localePath(locale, docPath(page))}>{page.data.title}</a></h2>
								<p>{page.data.description}</p>
							</li>
						))}
					</ul>
				)}
			</div>
		</div>
	</div>
</Shell>
