---
import Shell from '../../../layouts/Shell.astro';
import { docPath, docsSectionCopy, docsSectionOrder, getSectionDocs } from '../../../lib/docs';
import UntranslatedNotice from '../../../components/UntranslatedNotice.astro';
import { localePath, localeRoutes } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';

// The hub. Two trees with two audiences: people watching sports, and people scoring games in their
// own code. Splitting them at the top means neither has to scroll past the other.

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const t = useTranslations(locale);

const trees = await Promise.all(docsSectionOrder.map(async section => ({
	section,
	meta: docsSectionCopy(t, section),
	pages: await getSectionDocs(section, locale),
})));
const fullyTranslated = trees.every(tree => tree.pages.every(page => page.translated));
---
<Shell
	title={t('reading.docsMetaTitle')}
	description={t('reading.docsMetaDescription')}
	path='docs/'
	translated={fullyTranslated}
>
	<div class='container'>
		<div class='page-head'>
			<h1 class='page-title'>{t('reading.docsHeading')}</h1>
		</div>
		{!fullyTranslated && <UntranslatedNotice />}

		<div class='docs-hub'>
			{trees.map(tree => (
				<section class='docs-hub-tree' aria-labelledby={`hub-${tree.section}`}>
					<h2 id={`hub-${tree.section}`}>
						<a href={localePath(locale, `docs/${tree.section}/`)}>{tree.meta.heading}</a>
					</h2>
					<p class='docs-hub-lede'>{tree.meta.description}</p>

					{tree.pages.length === 0 ? (
						<p class='docs-hub-empty'>{t('reading.docsBeingWritten')}</p>
					) : (
						<ul class='docs-hub-list'>
							{tree.pages.map(({ entry: page, translated }) => (
								<li lang={translated ? undefined : 'en'}><a href={localePath(locale, docPath(page))}>{page.data.title}</a></li>
							))}
						</ul>
					)}
				</section>
			))}
		</div>
	</div>
</Shell>
