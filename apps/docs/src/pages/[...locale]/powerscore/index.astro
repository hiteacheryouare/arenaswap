---
import Shell from '../../../layouts/Shell.astro';
import LivePowerScores from '../../../components/LivePowerScores.tsx';
import PowerScoreHero from '../../../components/powerscore/PowerScoreHero.astro';
import WhatItDoesBand from '../../../components/powerscore/WhatItDoesBand.astro';
import SignalsBand from '../../../components/powerscore/SignalsBand.astro';
import ModesBand from '../../../components/powerscore/ModesBand.astro';
import BoostsBand from '../../../components/powerscore/BoostsBand.astro';
import DevelopersBand from '../../../components/powerscore/DevelopersBand.astro';
import { localeRoutes } from '../../../i18n/locales';
import { uiStrings, useTranslations } from '../../../i18n/ui';

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Shell
	title={t('meta.powerscoreTitle')}
	description={t('meta.powerscoreDescription')}
	path='powerscore/'
>
	<PowerScoreHero />
	<WhatItDoesBand />
	<SignalsBand />
	<ModesBand />
	<BoostsBand />

	<section id='live-scores' class='band'>
		<div class='container'>
			<div class='band-head'>
				<h2 class='display-md'>{t('powerscore.liveHeading')}</h2>
			</div>
			<LivePowerScores
				client:visible
				strings={{
					loading: t('powerscore.liveLoading'),
					error: t('powerscore.liveError'),
					emptyTitle: t('powerscore.liveEmptyTitle'),
					live: t('powerscore.liveNow'),
				}}
				ui={uiStrings(locale)}
			/>
		</div>
	</section>

	<DevelopersBand />
</Shell>
