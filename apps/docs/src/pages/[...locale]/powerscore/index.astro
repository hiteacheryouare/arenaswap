---
import Shell from '../../../layouts/Shell.astro';
import PowerScoreInstallCommands from '../../../components/PowerScoreInstallCommands.tsx';
import LivePowerScores from '../../../components/LivePowerScores.tsx';
import Machine from '../../../components/Machine.astro';
import { localeRoutes } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';
import {
	scoreMaxCloseness,
	scoreMaxComeback,
	scoreMaxLateGame,
	scoreMaxLeadChanges,
	scoreMaxMomentum,
	scoreMaxTotal,
} from 'powerscore';

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const t = useTranslations(locale);

// League abbreviations, so the rotation is the same twelve tokens everywhere. The word the
// rotation lands on is translated; the abbreviations are not, because a league is called what it
// is called.
const supportedLeagues = ['NFL', 'MLB', 'NHL', 'NBA', 'NCAAF', 'NCAAB', 'NCAAW', 'MLS', 'EPL', 'FIFAWC', 'NCAAMH', 'WNBA'];

interface Signal {
	name: string;
	copy: string;
}

// Ceilings imported rather than typed out. All five numbers here had been hand-written and had gone
// stale: the page advertised 30/28/28/18/14 against shipped ceilings of 42/38/38/18/20.
const maximums = [scoreMaxCloseness, scoreMaxLateGame, scoreMaxMomentum, scoreMaxLeadChanges, scoreMaxComeback];
const tones = ['green', 'orange', 'blue', 'yellow', 'pink'];

const signals = t.list<Signal>('powerscore.signals').map((signal, index) => ({
	...signal,
	max: maximums[index],
	tone: tones[index],
}));

// The token rotates through the league abbreviations and then lands on the word for a score, and
// the tail after it changes when it does — in English " score." becomes "." because the word is
// now in the slot. Four separate strings rather than one template with a hole in it, so a language
// can put its own words on either side of the token and change both when the rotation settles.
const taglinePrefix = t('powerscore.heroTaglinePrefix');
const taglineSuffix = t('powerscore.heroTaglineSuffix');
---
<Shell
	title={t('meta.powerscoreTitle')}
	description={t('meta.powerscoreDescription')}
	path='powerscore/'
>

		<section class='ps-hero section-pad'>
			<div class='ps-glow ps-glow-tl'></div>
			<div class='ps-glow ps-glow-tr'></div>
			<div class='ps-glow ps-glow-bl'></div>
			<div class='ps-glow ps-glow-br'></div>

			<div class='container' style='position:relative; z-index:1;'>
				<div class='row justify-content-center'>
					<div class='col-xl-9 col-lg-10 text-center'>

						<div class='ps-hero-bar'></div>

						<h1 class='ps-hero-heading'>
							<span class='ps-heading-wrap'>
								<span class='ps-gradient-text' id='ps-gradient-text'>{t('powerscore.heroName')}</span><span
								class='ps-solid-text' id='ps-solid-text' aria-hidden='true'>{t('powerscore.heroName')}</span>
							</span><br/>
							{taglinePrefix}<span class='ps-rotating-phrase'><span id='ps-rotating-token' class='ps-rotating-token' aria-live='polite'>{supportedLeagues[0]}</span><span id='ps-rotating-suffix'>{taglineSuffix}</span></span>
						</h1>

						<p class='ps-hero-sub'>{t('powerscore.heroSub')}</p>

						<div class='ps-hero-ctas d-flex flex-wrap gap-3 justify-content-center'>
							<a href='https://www.npmjs.com/package/powerscore' target='_blank' rel='noreferrer' class='btn btn-cta'>
								<i class='bi bi-box-arrow-up-right me-2'></i>{t('powerscore.viewOnNpm')}
							</a>
							<a href='https://github.com/hiteacheryouare/arenaswap/tree/dev/packages/powerscore' target='_blank' rel='noreferrer' class='btn btn-outline-secondary-custom'>
								<i class='bi bi-github me-2'></i>{t('powerscore.sourceOnGithub')}
							</a>
						</div>

					</div>
				</div>
			</div>
		</section>

		<section class='section-pad' style='background:rgba(22,27,34,0.5);'>
			<div class='container'>
				<div class='row g-4'>
					<div class='col-12 reveal'>
						<h2 class='section-title mb-4'>{t('powerscore.installHeading')}</h2>
					</div>
					<div class='col-12 reveal reveal-delay-1'>
						<PowerScoreInstallCommands
							client:visible
							copyLabel={t('powerscore.copy')}
							copiedLabel={t('powerscore.copied')}
						/>
					</div>
				</div>
			</div>
		</section>

		<section class='section-pad'>
			<div class='container'>
				<div class='row g-4'>
					<div class='col-12 reveal'>
						<h2 class='section-title mb-3'>{t('powerscore.signalsHeading')}</h2>
						<p class='section-sub mb-4'>{t('powerscore.signalsSub', { max: scoreMaxTotal })}</p>
					</div>
					{signals.map((signal, index) => (
						<div class={`col-md-6 col-xl-4 reveal${index > 0 ? ` reveal-delay-${index}` : ''}`}>
							<div class={`feature-card ps-signal-card-${signal.tone}`}>
								<h3>{signal.name}<span aria-hidden='true'> · </span>{t('powerscore.signalMax', { max: signal.max })}</h3>
								<p>{signal.copy}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<div class='ps-gradient-bar'></div>

		<section id='live-scores' class='section-pad' style='background:rgba(22,27,34,0.5);'>
			<div class='container'>
				<div class='row g-4'>
					<div class='col-12 reveal'>
						<h2 class='section-title mb-4'>{t('powerscore.liveHeading')}</h2>
					</div>
					<div class='col-12 reveal reveal-delay-1'>
						<LivePowerScores
							client:visible
							strings={{
								loading: t('powerscore.liveLoading'),
								loadingCopy: t('powerscore.liveLoadingCopy'),
								error: t('powerscore.liveError'),
								emptyTitle: t('powerscore.liveEmptyTitle'),
								emptyCopy: t('powerscore.liveEmptyCopy'),
								scoreBadge: t('powerscore.liveScoreBadge'),
								live: t('powerscore.liveNow'),
							}}
						/>
					</div>
				</div>
			</div>
		</section>
	<Machine />

	<script>
		const revealElements = document.querySelectorAll('.reveal');
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
		);
		revealElements.forEach(el => observer.observe(el));
	</script>

	<script>
		// One full gradient cycle (0.85s delay + 6s), then a crossfade to a random brand colour.
		const psColors = ['#22c55e', '#F75C03', '#2274A5', '#F1C40F', '#D90368'];
		const chosen = psColors[Math.floor(Math.random() * psColors.length)];

		const gradientEl = document.getElementById('ps-gradient-text');
		const solidEl = document.getElementById('ps-solid-text');

		if (gradientEl && solidEl) {
			solidEl.style.color = chosen;
			setTimeout(() => {
				gradientEl.classList.add('ps-exiting');
				solidEl.style.opacity = '1';
			}, 6850);
		}
	</script>

	<script define:vars={{ supportedLeagues, restingToken: t('powerscore.heroRestingToken'), restingSuffix: t('powerscore.heroRestingSuffix') }}>
		const psSupportedLeagues = supportedLeagues;
		const rotatingTokenEl = document.getElementById('ps-rotating-token');
		const rotatingSuffixEl = document.getElementById('ps-rotating-suffix');
		const fadeDurationMs = 240;
		const displayDurationMs = 1200;

		if (rotatingTokenEl && rotatingSuffixEl && psSupportedLeagues.length > 0) {
			let index = 0;
			rotatingTokenEl.textContent = psSupportedLeagues[index];

			const rotate = () => {
				index += 1;

				if (index >= psSupportedLeagues.length) {
					rotatingTokenEl.classList.add('is-exiting');
					window.setTimeout(() => {
						rotatingTokenEl.textContent = restingToken;
						rotatingTokenEl.classList.remove('is-exiting');
						rotatingTokenEl.classList.add('is-entering');
						rotatingSuffixEl.textContent = restingSuffix;
						window.setTimeout(() => {
							rotatingTokenEl.classList.remove('is-entering');
						}, fadeDurationMs);
					}, fadeDurationMs);
					return;
				}

				rotatingTokenEl.classList.add('is-exiting');
				window.setTimeout(() => {
					rotatingTokenEl.textContent = psSupportedLeagues[index];
					rotatingTokenEl.classList.remove('is-exiting');
					rotatingTokenEl.classList.add('is-entering');
					window.setTimeout(() => {
						rotatingTokenEl.classList.remove('is-entering');
					}, fadeDurationMs);
				}, fadeDurationMs);

				window.setTimeout(rotate, displayDurationMs + fadeDurationMs);
			};

			window.setTimeout(rotate, displayDurationMs + fadeDurationMs);
		}
	</script>
</Shell>
