---
import Shell from '../../../layouts/Shell.astro';
import LegalNav from '../../../components/LegalNav.astro';
import LegalTranslationNotice from '../../../components/LegalTranslationNotice.astro';
import { localeRoutes } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/ui';

// The footage in the hero and the Multiview demo is real game footage, which means somebody filmed
// it. The CC BY clips require attribution, and this page is where that is said out loud.
//
// Each clip is a game in a league ArenaSwap tracks: a clip whose game the popup cannot describe has
// no business in a demo about describing what you are watching. A Mexican League baseball game and a
// UEFA Nations League match were cut for exactly that reason.
//
// Kept as data rather than prose so scripts/docs/fetchHeroClips.sh and this list can be checked
// against each other by eye.
//
// The sport takes a translated label; nothing else here does. A licence is named by its identifier,
// a venue and a broadcaster by their own names, and a fixture by the two teams playing in it —
// translating any of those would break the attribution the CC BY licence is asking for.

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const t = useTranslations(locale);

const clips = [
	{
		sport: t('sport.basketball'),
		what: "Northern Arizona at Hawai'i, Stan Sheriff Center",
		author: "Warrior Insider, University of Hawai'i Athletics",
		licence: 'CC BY 3.0',
		licenceUrl: 'https://creativecommons.org/licenses/by/3.0/',
		source: 'https://commons.wikimedia.org/wiki/File:Hawaii_Basketball_-_Highlights_From_Northern_Arizona_Game.webm',
	},
	{
		sport: t('sport.football'),
		what: 'Army at Navy, from All Hands Update',
		author: 'Defense Media Activity, U.S. Navy',
		licence: t('legal.credits.publicDomain'),
		licenceUrl: 'https://commons.wikimedia.org/wiki/Template:PD-USGov',
		source: 'https://commons.wikimedia.org/wiki/File:All_Hands_Update-_Army_vs_Navy.webm',
	},
	{
		sport: t('sport.hockey'),
		what: 'Minnesota State at Bemidji State, Sanford Center',
		author: 'Lakeland PBS',
		licence: 'CC BY 3.0',
		licenceUrl: 'https://creativecommons.org/licenses/by/3.0/',
		source: 'https://commons.wikimedia.org/wiki/File:BSU_Men%27s_Hockey_To_Play_In_2019_Mariucci_Classic.webm',
	},
	{
		sport: t('sport.soccer'),
		what: 'Aston Villa at AFC Bournemouth, Vitality Stadium',
		author: 'AFC Bournemouth',
		licence: 'CC BY 4.0',
		licenceUrl: 'https://creativecommons.org/licenses/by/4.0/',
		source: 'https://commons.wikimedia.org/wiki/File:Rayan_scores_his_first_goal_for_AFC_Bournemouth_against_Aston_Villa_in_the_2025-26_Premier_League.webm',
	},
	{
		sport: t('sport.football'),
		what: 'Oregon at Washington State, Martin Stadium',
		author: 'FOX Sports',
		licence: 'CC BY 3.0',
		licenceUrl: 'https://creativecommons.org/licenses/by/3.0/',
		source: 'https://commons.wikimedia.org/wiki/File:Oregon_vs._Washington_St_-_FOX_COLLEGE_FOOTBALL_HIGHLIGHTS.webm',
	},
	{
		sport: t('sport.basketball'),
		what: 'Golden State Valkyries at Indiana Fever, Gainbridge Fieldhouse',
		author: 'Sarah Stierch',
		licence: 'CC0',
		licenceUrl: 'https://creativecommons.org/publicdomain/zero/1.0/',
		source: 'https://commons.wikimedia.org/wiki/File:Golden_State_Valkyries_at_Indiana_Fever_-_May_2026_-_Sarah_Stierch_44.webm',
	},
	{
		sport: t('sport.baseball'),
		what: 'Tampa Bay Rays at St. Louis Cardinals, Busch Stadium',
		author: 'Johnmaxmena2',
		licence: 'CC0',
		licenceUrl: 'https://creativecommons.org/publicdomain/zero/1.0/',
		source: 'https://commons.wikimedia.org/wiki/File:Wetherholt_homerun_and_first_hit.webm.360p.webm',
	},
];
---
<Shell
	title={t('meta.creditsTitle')}
	description={t('meta.creditsDescription')}
	path='legal/credits/'
>
	<div class='container'>
		<div class='page-head'>
			<h1 class='page-title'>{t('legal.credits.title')}</h1>
		</div>

		<div class='reading-shell'>
			<LegalNav current='legal/credits/' />

			<div>
				<LegalTranslationNotice path='legal/credits/' />

				<h2 class='display-md' style='font-size:1.35rem'>{t('legal.credits.footageHeading')}</h2>
				<ul class='credit-list'>
					{clips.map(clip => (
						<li class='credit-item'>
							<h3>{clip.sport}<span aria-hidden='true'> · </span>{clip.what}</h3>
							<p>
								<span>{clip.author}</span>
								<span aria-hidden='true'> · </span>
								<a href={clip.licenceUrl} class='credit-licence'>{clip.licence}</a>
								<span aria-hidden='true'> · </span>
								<a href={clip.source}>{t('legal.credits.sourceLink')}</a>
							</p>
						</li>
					))}
				</ul>

				<div class='prose' style='margin-top:2.5rem'>
					<h2>{t('legal.credits.scoresHeading')}</h2>
					<p>{t('legal.credits.scores1')}</p>

					<h2>{t('legal.credits.marksHeading')}</h2>
					<p>{t('legal.credits.marks1')}</p>
				</div>
			</div>
		</div>
	</div>
</Shell>
