---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import DocsNav from '../../components/DocsNav.astro';

// The docs tree. Both sections have a URL, a place in the side nav and a layout; what they do not
// have yet is content, which lands in src/content/docs/. Settling the shape first means writing the
// documentation is writing, not another redesign.

// `planned` describes what each section will cover. It is deliberately undated: a page that
// promises a version is a page that starts lying the moment that version ships without it.

const sections = {
	extension: {
		title: 'The extension',
		description: 'Installing ArenaSwap, assigning tabs to games, tuning when it switches, and Standby Stream.',
		covers: ['Installing and enabling', 'Assigning a tab to a game', 'Switching, sensitivity and cooldown', 'Favorite teams and boosts', 'Standby Stream', 'Demo mode'],
	},
	powerscore: {
		title: 'PowerScore',
		description: 'How a game gets scored. The five signals, the boosts, the penalties and the types.',
		covers: ['Getting started', 'Scoring a game', 'The five signals', 'Boosts and penalties', 'Sport and league configuration', 'Types'],
	},
} as const;

// Written out rather than derived from `sections` above: Astro hoists getStaticPaths into its own
// module, so it cannot see the component scope.
export async function getStaticPaths() {
	return [{ params: { section: 'extension' } }, { params: { section: 'powerscore' } }];
}

const section = Astro.params.section as keyof typeof sections;
const meta = sections[section];
const base = import.meta.env.BASE_URL;

const pages = (await getCollection('docs', ({ data }) => !data.draft && data.section === section))
	.toSorted((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(pages.map(async page => ({
	page,
	Content: (await render(page)).Content,
})));
---
<Shell
	title={`${meta.title} — ArenaSwap docs`}
	description={meta.description}
	path={`docs/${section}/`}
>
	<div class='container'>
		<div class='page-head'>
			<h1 class='page-title'>{meta.title}.</h1>
			<p class='page-lede'>{meta.description}</p>
		</div>

		<div class='reading-shell'>
			<DocsNav current={`docs/${section}/`} />

			<div>
				{rendered.length === 0 ? (
					<div class='prose'>
						<p>This section is being written. It will cover:</p>
						<ul>
							{meta.covers.map(item => <li>{item}</li>)}
						</ul>
						<p>
							In the meantime, the <a href={`${base}releases/`}>release notes</a> cover what changed
							and the <a href={`${base}faq/`}>FAQ</a> answers most of what people ask. PowerScore
							has a <a href={`${base}powerscore/`}>reference page</a> with working examples today.
						</p>
					</div>
				) : (
					rendered.map(({ page, Content }) => (
						<article class='prose' id={page.id}>
							<h2>{page.data.title}</h2>
							<Content />
						</article>
					))
				)}
			</div>
		</div>
	</div>
</Shell>
