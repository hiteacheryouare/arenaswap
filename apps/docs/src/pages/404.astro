---
import Shell from '../layouts/Shell.astro';
import NotFoundCard from '../components/NotFoundCard';
import { defaultLocale, localePath } from '../i18n/locales';
import { useTranslations, uiStrings } from '../i18n/ui';

const t = useTranslations(defaultLocale);
const base = import.meta.env.BASE_URL;
const titleWords = t('notFound.title').split(' ');
---
<Shell
	title={t('meta.notFoundTitle')}
	description={t('meta.notFoundDescription')}
	noindex
	hasLocalizedUrls={false}
>
	<section class='notfound' style={`--words:${titleWords.length + 3}`}>
		<div class='glow' aria-hidden='true'></div>
		<div class='container'>
			<div class='notfound-inner'>

				<div class='notfound-card'>
					<NotFoundCard strings={uiStrings(defaultLocale)} />
				</div>

				<h1 class='notfound-title'>
					{titleWords.map((word, index) => (
						<Fragment>
							<span class='rise-word' style={`--i:${index + 3}`}>{word}</span>{index < titleWords.length - 1 && ' '}
						</Fragment>
					))}
				</h1>

				<p class='notfound-sub rise-after'>{t('notFound.sub')}</p>

				<p class='notfound-path rise-after' data-no-dots>
					<span class='notfound-path-key'>{t('notFound.requested')}</span>
					<code id='notfound-path'>{base}</code>
				</p>

				<div class='notfound-cta rise-after' style='--step:1'>
					<a href={localePath(defaultLocale)} class='btn btn-cta'>
						<i class='bi bi-house-door me-3'></i>{t('notFound.backHome')}
					</a>
					<a href={localePath(defaultLocale, 'releases/')} class='btn btn-outline-secondary-custom'>
						{t('notFound.readReleases')}
					</a>
				</div>

				<div class='notfound-links rise-after' style='--step:2'>
					<a href={localePath(defaultLocale, 'powerscore/')}>{t('nav.powerscore')}</a>
					<a href={localePath(defaultLocale, 'docs/')}>{t('nav.docs')}</a>
					<a href={localePath(defaultLocale, 'faq/')}>{t('nav.faq')}</a>
					<a href={localePath(defaultLocale, 'legal/')}>{t('nav.legal')}</a>
				</div>

			</div>
		</div>
	</section>

	<script>
		const target = document.getElementById('notfound-path');
		if (target) target.textContent = location.pathname + location.search;
	</script>
</Shell>
