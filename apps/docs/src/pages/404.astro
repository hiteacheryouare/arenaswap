---
import Shell from '../layouts/Shell.astro';
import NotFoundCard from '../components/NotFoundCard';
import { defaultLocale, localePath } from '../i18n/locales';
import { useTranslations, uiStrings } from '../i18n/ui';

// One 404 for the whole site, in English. GitHub Pages answers every unknown URL under the base
// path with this single file, so there is no per-locale version it could reach for — a request for
// /arenaswap/de/nothing-here gets served the same document a request for /arenaswap/nothing-here
// does. The links point at the English pages for the same reason.
const t = useTranslations(defaultLocale);
const base = import.meta.env.BASE_URL;
---
<Shell
	title={t('meta.notFoundTitle')}
	description={t('meta.notFoundDescription')}
	noindex
	localized={false}
>
	<section class='notfound'>
		<div class='container'>
			<div class='notfound-inner'>

				<div class='notfound-card'>
					<NotFoundCard strings={uiStrings(defaultLocale)} />
				</div>

				<h1 class='notfound-title'>{t('notFound.title')}</h1>

				<p class='notfound-sub'>{t('notFound.sub')}</p>

				<p class='notfound-path' data-no-dots>
					<span>{t('notFound.requested')}</span>
					<code id='notfound-path'>{base}</code>
				</p>

				<div class='notfound-cta'>
					<a href={localePath(defaultLocale)} class='btn btn-primary'>
						<i class='bi bi-house-door me-2' aria-hidden='true'></i>{t('notFound.backHome')}
					</a>
					<a href={localePath(defaultLocale, 'releases/')} class='btn btn-quiet'>
						{t('notFound.readReleases')}
					</a>
				</div>

				<div class='notfound-links'>
					<a href={localePath(defaultLocale, 'powerscore/')}>{t('nav.powerscore')}</a>
					<a href={localePath(defaultLocale, 'docs/')}>{t('nav.docs')}</a>
					<a href={localePath(defaultLocale, 'faq/')}>{t('nav.faq')}</a>
					<a href={localePath(defaultLocale, 'legal/')}>{t('nav.legal')}</a>
				</div>

			</div>
		</div>
	</section>

	<script>
		// GitHub Pages serves this file for any unknown URL under the base path, so the address bar
		// is the only record of what was actually requested.
		const target = document.getElementById('notfound-path');
		if (target) target.textContent = location.pathname + location.search;
	</script>
</Shell>
