---
import Shell from '../layouts/Shell.astro';
import HeroBand from '../components/landing/HeroBand.astro';
import TabsBand from '../components/landing/TabsBand.astro';
import PopupBand from '../components/landing/PopupBand.astro';
import ChartsBand from '../components/landing/ChartsBand.astro';
import LeaguesBand from '../components/landing/LeaguesBand.astro';
import SettingsBand from '../components/landing/SettingsBand.astro';
import TailBand from '../components/landing/TailBand.astro';

const description = 'ArenaSwap watches every live game across 31 leagues and switches your browser tab to the most exciting one. Free, no account, nothing leaves your browser.';
---
<Shell
	title='ArenaSwap — Never miss the moment.'
	ogTitle='ArenaSwap — Never miss the moment.'
	description={description}
>
	<HeroBand />
	<TabsBand />
	<PopupBand />
	<ChartsBand />
	<LeaguesBand />
	<SettingsBand />
	<TailBand />
</Shell>
